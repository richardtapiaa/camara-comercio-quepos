---
import FondoSello from "../compartidos/FondoSello";
---

<section id="hero-contacto" aria-labelledby="titulo-contacto" class="relative isolate flex min-h-[75svh] items-center overflow-hidden bg-white px-6 pb-16 pt-36 sm:px-10 sm:pt-40 lg:min-h-[80svh] lg:pt-44">
  <FondoSello lado="derecha" abajo fijo={false} prioritario />
  <div class="mx-auto w-full max-w-[1320px]">
    <h1 id="titulo-contacto" class="text-[clamp(3rem,9vw,7.5rem)] font-bold leading-[0.95] tracking-tight text-slate-950">Contacto</h1>
    <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-700 sm:text-lg">
      ¿Tiene alguna consulta o un proyecto en mente? No dude en escribirnos: con gusto conversamos.
    </p>
  </div>
</section>
