---
import { Image } from "astro:assets";
import ilustracion from "../../assets/contacto/contacto.svg";
import logo from "../../assets/compartido/logo-camara-nav-400.webp";
import { contacto } from "../../lib/sitio";
import FurmulairoContacto from "../ReactComponentes/CONTACTO/furmulariocontacto.tsx";

const telefonoEnlace = contacto.telefono.replace(/[^+\d]/g, "");
const claseIcono = "size-4 shrink-0 text-slate-500";
---

<!--
  Formulario de contacto en dos columnas: a la izquierda el título, un texto corto, la ilustración y los datos de
  contacto; a la derecha el formulario. En celular, uno debajo del otro.
-->
<section id="formulario-contacto" aria-labelledby="titulo-formulario-contacto" class="bg-white px-6 pb-20 pt-6 sm:px-10 sm:pb-28">
  <div class="mx-auto grid max-w-[1320px] items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div>
      <h2 id="titulo-formulario-contacto" class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
        Escríbanos, estamos para ayudarle
      </h2>
      <p class="mt-4 max-w-md text-base leading-relaxed text-slate-600">
        ¿Tiene una consulta, una sugerencia o un proyecto en mente? Complete el formulario y le responderemos lo antes
        posible.
      </p>

      <img
        src={ilustracion.src}
        width={ilustracion.width}
        height={ilustracion.height}
        alt=""
        loading="lazy"
        decoding="async"
        class="mt-8 w-full max-w-xs sm:max-w-sm"
      />

      <ul class="mt-8 flex flex-col gap-3 text-sm text-slate-700">
        <li class="flex items-center gap-3">
          <svg class={claseIcono} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
          </svg>
          <span><span class="font-semibold text-slate-900">Horario de atención:</span> lunes a viernes, de 9:00 a. m. a 5:00 p. m.</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class={claseIcono} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 5-5.5 10.2-7.4 11.8a1 1 0 0 1-1.2 0C9.5 20.2 4 15 4 10a8 8 0 0 1 16 0" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          Quepos, Puntarenas, Costa Rica
        </li>
        <li>
          <a href={`tel:${telefonoEnlace}`} class="inline-flex items-center gap-3 transition-colors hover:text-slate-950">
            <svg class={claseIcono} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
            </svg>
            {contacto.telefono}
          </a>
        </li>
        <li>
          <a href={`mailto:${contacto.email}`} class="inline-flex items-center gap-3 transition-colors hover:text-slate-950">
            <svg class={claseIcono} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            {contacto.email}
          </a>
        </li>
      </ul>
    </div>

    <!-- Card con el logo de la Cámara (centrado) y el formulario -->
    <div class="rounded-[2rem] bg-white p-6 shadow-[0_24px_60px_-24px_rgba(15,40,70,0.3)] ring-1 ring-slate-200/80 sm:p-10">
      <Image
        src={logo}
        alt="Cámara de Comercio, Industria y Turismo de Quepos"
        widths={[200, 300, 400]}
        sizes="(min-width: 640px) 195px, 165px"
        loading="lazy"
        decoding="async"
        class="mx-auto mb-8 h-[4.5rem] w-auto sm:h-[5.25rem]"
      />
      <FurmulairoContacto client:visible />
    </div>
  </div>
</section>
