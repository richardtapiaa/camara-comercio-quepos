---
import logo from "../../assets/compartido/logo-camara-nav.webp";

// Igual que el mapa del sitio anterior (camaracomercioquepos.com): satelital, centrado en Quepos, zoom 15, fijo
// (sin moverse ni hacer zoom) y con un marcador "Quepos" con el logo de la Cámara.
const ubicacion = { lat: 9.4246, lng: -84.1698, zoom: 15 };
---

<!--
  Mapa satelital fijo a todo el ancho. En vez de cargar una librería de mapas, ubicacion-mapa.ts coloca las
  imágenes satelitales de Esri (World Imagery) que cubren la sección, solo cuando se acerca a la pantalla.
  El marcador va en el centro, que es el punto de la ubicación.
-->
<section aria-labelledby="titulo-ubicacion" class="bg-white">
  <h2 id="titulo-ubicacion" class="sr-only">Ubicación</h2>
  <div
    data-mapa-estatico
    data-lat={ubicacion.lat}
    data-lng={ubicacion.lng}
    data-zoom={ubicacion.zoom}
    role="img"
    aria-label="Mapa satelital de Quepos, Puntarenas, donde se encuentra la Cámara de Comercio, Industria y Turismo"
    class="relative h-[380px] w-full overflow-hidden bg-[#3b4a3c] sm:h-[500px]"
  >
    <div data-mapa-capas class="absolute inset-0" aria-hidden="true"></div>

    <!-- Marcador con su ventanita, apuntando al centro del mapa -->
    <div class="pointer-events-none absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-full flex-col items-center" aria-hidden="true">
      <div class="mb-2 flex flex-col items-center rounded-2xl bg-white px-5 py-3 text-center shadow-[0_12px_30px_-10px_rgba(0,0,0,0.55)]">
        <p class="text-base font-semibold text-slate-900">Quepos</p>
        <img src={logo.src} width={logo.width} height={logo.height} alt="" class="mt-2 h-12 w-auto" />
      </div>
      <svg viewBox="0 0 24 32" class="h-10 w-8 drop-shadow-[0_4px_6px_rgba(0,0,0,0.45)]">
        <path d="M12 0C5.4 0 0 5.3 0 11.9 0 20.8 12 32 12 32s12-11.2 12-20.1C24 5.3 18.6 0 12 0Z" fill="#2780c9" />
        <circle cx="12" cy="12" r="4.5" fill="#fff" />
      </svg>
    </div>

   
  </div>
</section>

<script src="../../scripts/contacto/ubicacion-mapa.ts"></script>
