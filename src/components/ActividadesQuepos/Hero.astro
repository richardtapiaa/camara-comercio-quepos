---
import { optimizarImagen } from "../../lib/imagenes";
import { getImage } from "astro:assets";
import { HeroActividades } from "../ReactComponentes/ActividadesQueposR/HeroActividades";
import actividades1 from "../../assets/imagenes visitors/actividades-1.jpg";
import actividades2 from "../../assets/imagenes visitors/actividades-2.jpg";
import actividades3 from "../../assets/imagenes visitors/actividades-3.jpg";
import actividades4 from "../../assets/imagenes visitors/actividades-4.jpg";
import actividades5 from "../../assets/imagenes visitors/actividades-5.jpg";
import actividades6 from "../../assets/imagenes visitors/actividades-6.jpeg";
import heroVisitanos from "../../assets/imagenes visitors/hero-visitanos.jpg";

const imagenes = [
  { src: await optimizarImagen(actividades1, 1000), alt: "Actividad en Quepos" },
  { src: await optimizarImagen(actividades2, 1000), alt: "Aventura en Quepos" },
  { src: await optimizarImagen(actividades3, 1000), alt: "Naturaleza de Quepos" },
  { src: await optimizarImagen(actividades4, 1000), alt: "Turismo en Quepos" },
  { src: await optimizarImagen(actividades5, 1000), alt: "Recorrido en Quepos" },
  { src: await optimizarImagen(actividades6, 1000), alt: "Experiencia en Quepos" },
];

// Fondo optimizado (el original pesa ~890 KB)
const fondoOptimizado = await getImage({ src: heroVisitanos, width: 1920, format: "webp", quality: 75 });
const fondo = { src: fondoOptimizado.src, alt: "Bahía rodeada de bosque tropical en Quepos" };
---

<HeroActividades client:load imagenes={imagenes} fondo={fondo} />
