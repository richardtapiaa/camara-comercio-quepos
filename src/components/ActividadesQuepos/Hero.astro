---
import { Picture } from "astro:assets";
import foto from "../../assets/actividades/hero-visitanos.jpg";
import BordePincelada from "../compartidos/BordePincelada.astro";
import "../../styles/compartido/etiqueta-papel.css";
import "../../styles/compartido/hero-texto.css";

// Mismo hero que el de Hospitalidad (HospitalidadComponentes/Hero.astro)
---

<!-- id="hero": el navbar se ve transparente mientras está sobre esta sección -->
<section id="hero" class="relative isolate flex h-[78svh] min-h-[520px] items-end overflow-hidden bg-[#2b4a3c]">
  <!-- AVIF (pesa ~40 % menos que WebP con la misma calidad) y WebP para los navegadores que no lo leen -->
  <Picture
    src={foto}
    formats={["avif", "webp"]}
    alt="Bahía de Manuel Antonio rodeada de bosque tropical, vista entre los árboles"
    widths={[800, 1280, 1600]}
    sizes="100vw"
    quality={50}
    class="absolute inset-0 -z-20 size-full object-cover"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/55 via-black/10 to-black/30" aria-hidden="true"></div>

  <div class="hero-texto mx-auto w-full max-w-[1320px] px-6 pb-[clamp(5rem,12vh,8rem)] text-white sm:px-10">
    <p class="hero-texto-kicker">Quepos · Costa Rica</p>
    <h1 class="hero-texto-titulo">Aventura</h1>
    <a
      href="#actividades"
      class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-xs font-bold uppercase tracking-wide text-[#1e2a5a] shadow-lg transition-colors hover:bg-white/85 md:px-8 md:py-4 md:text-sm"
    >
      Descubre las actividades
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
      </svg>
    </a>
  </div>

  <!-- Del gris de la sección de abajo (InformacionActividades) -->
  <BordePincelada color="text-[#f6f6f7]" />
</section>
