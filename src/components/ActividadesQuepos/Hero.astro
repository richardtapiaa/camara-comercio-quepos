---
import { getImage } from "astro:assets";
import { HeroActividades } from "../ReactComponentes/ActividadesQueposR/HeroActividades";
import foto from "../../assets/actividades/kayak-rio-ampliada.jpg";
import primerPlano from "../../assets/actividades/kayakista-primer-plano-ampliada.webp";

// CAPA 1: la foto ampliada a lo ancho (a la derecha se agregó agua y rocas de la misma escena),
// para que en escritorio se vea completa. CAPA 3: la misma foto, del mismo tamaño, con solo el kayakista visible (WebP con
// canal alfa), para que quede encima del título. Las dos se exportan al mismo ancho para que calcen
const fotoOptimizada = await getImage({ src: foto, width: Math.min(foto.width, 2250), format: "webp", quality: 80 });
const primerPlanoOptimizado = await getImage({ src: primerPlano, width: primerPlano.width, format: "webp", quality: 90 });
---

<HeroActividades
  client:load
  foto={{
    src: fotoOptimizada.src,
    alt: "Kayakistas recorriendo un río entre selva y rocas en Quepos",
    width: foto.width,
    height: foto.height,
  }}
  primerPlano={primerPlanoOptimizado.src}
  titulo="Aventura"
/>
