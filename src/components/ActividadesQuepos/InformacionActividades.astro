---
import { optimizarImagen, variantesCapa } from "../../lib/imagenes";
import InformacionActividades from "../ReactComponentes/ActividadesQueposR/InformacionActividades";
import perezosoLinea from "../../assets/actividades/perezoso-linea.webp";
import kayakLinea from "../../assets/actividades/kayak-linea.webp";
import canopyLinea from "../../assets/actividades/canopy-linea.webp";
import actividades1 from "../../assets/actividades/actividades-1.jpg";
import actividades2 from "../../assets/actividades/actividades-2.jpg";
import actividades3 from "../../assets/actividades/actividades-3.jpg";
import actividades4 from "../../assets/actividades/actividades-4.jpg";
import actividades5 from "../../assets/actividades/actividades-5.jpg";
import actividades6 from "../../assets/actividades/actividades-6.jpeg";
import actividad7 from "../../assets/actividades/actividad7.jpg";
import actividad8 from "../../assets/actividades/actividad8.jpg";
import pescadoLinea from "../../assets/actividades/Pescado.webp";

const anchosFotos = [400, 700, 1000];
const imagenes = [
  { ...(await variantesCapa(actividades1, anchosFotos, 75)), alt: "Perezoso en el Parque Nacional Manuel Antonio" },
  { ...(await variantesCapa(actividades5, anchosFotos, 75)), alt: "Personas practicando kayak en los manglares" },
  { ...(await variantesCapa(actividades2, anchosFotos, 75)), alt: "Grupo haciendo rafting en el río" },
  { ...(await variantesCapa(actividades4, anchosFotos, 75)), alt: "Turista haciendo rappel en el bosque" },
  { ...(await variantesCapa(actividades6, anchosFotos, 75)), alt: "Marlín saltando en el mar" },
  { ...(await variantesCapa(actividad7, anchosFotos, 75)), alt: "Personas disfrutando una experiencia de ocio junto al mar" },
  { ...(await variantesCapa(actividad8, anchosFotos, 75)), alt: "Molienda artesanal para preparar alimentos tradicionales" },
];
---

<InformacionActividades
  client:visible
  imagenes={imagenes}
  perezoso={await optimizarImagen(perezosoLinea, 256, 80)}
  kayak={await optimizarImagen(kayakLinea, 160, 80)}
  canopy={await optimizarImagen(canopyLinea, 192, 85)}
  pescado={await optimizarImagen(pescadoLinea, 192, 80)}
/>
