---
import { optimizarImagen } from "../../lib/imagenes";
import InformacionActividades from "../ReactComponentes/ActividadesQueposR/InformacionActividades";
import perezosoLinea from "../../assets/imagenes-quepos/perezoso-linea.webp";
import kayakLinea from "../../assets/imagenes/kayak-linea.webp";
import canopyLinea from "../../assets/imagenes/canopy-linea.webp";
import actividades1 from "../../assets/imagenes visitors/actividades-1.jpg";
import actividades2 from "../../assets/imagenes visitors/actividades-2.jpg";
import actividades3 from "../../assets/imagenes visitors/actividades-3.jpg";
import actividades4 from "../../assets/imagenes visitors/actividades-4.jpg";
import actividades5 from "../../assets/imagenes visitors/actividades-5.jpg";
import actividades6 from "../../assets/imagenes visitors/actividades-6.jpeg";

// Mismo orden que los textos de InformacionActividades.tsx
const imagenes = [
  { src: await optimizarImagen(actividades1, 1000), alt: "Perezoso en el Parque Nacional Manuel Antonio" },
  { src: await optimizarImagen(actividades2, 1000), alt: "Grupo haciendo rafting en el río" },
  { src: await optimizarImagen(actividades3, 1000), alt: "Catamarán navegando al atardecer" },
  { src: await optimizarImagen(actividades4, 1000), alt: "Turista haciendo rappel en el bosque" },
  { src: await optimizarImagen(actividades5, 1000), alt: "Kayaks entre los manglares" },
  { src: await optimizarImagen(actividades6, 1000), alt: "Marlín saltando en el mar" },
];
---

<!-- El perezoso, el kayak y la persona del canopy se ven de 128, 80 y 96 px de ancho como mucho: se piden al doble (alta densidad) -->
<InformacionActividades
  client:visible
  imagenes={imagenes}
  perezoso={await optimizarImagen(perezosoLinea, 256, 80)}
  kayak={await optimizarImagen(kayakLinea, 160, 80)}
  canopy={await optimizarImagen(canopyLinea, 192, 85)}
/>
