---
import kayak from "../../assets/imagenes/kayak-sin-fondo.webp";
import KayakJs from "../Quepos-Componentes/KayakJs.astro";
import { MagicText } from "../ReactComponentes/QUEPOS/ScrollReveal";
import "../../styles/compartido/cielo-sol.css";
import "../../styles/actividades/kayak-scroll.css";

const frase =
  "“Entre manglares, ríos y mar abierto, en Quepos cada remada te acerca a la naturaleza del Pacífico Central.”";
---

<!-- Mismo recuadro que LapasJS.astro, pero con agua abajo en vez de nubes arriba, y un kayak que la cruza remando al
     hacer scroll (KayakJs.astro). El agua es una capa con el borde de arriba en olas que se mece despacio; el <g>
     lo mueve el scroll. Arriba, en el cielo, va la frase que se llena con el scroll (MagicText), con
     las nubes pasando por delante -->
<section
  data-kayak-scroll
  class="kayak-recuadro relative isolate flex min-h-[48svh] flex-col overflow-hidden bg-[#E8F4FA] md:min-h-[70svh]"
  aria-label="Kayak remando en las aguas de Quepos"
>
  <!-- Cielo: un sol pequeño arriba a la derecha y nubes suaves. El div de cada nube lo mueve el scroll (KayakJs.astro)
       y el svg de adentro va a la deriva solo -->
  <!-- Sol: 12 rayos curvos, un poco en remolino, y el centro amarillo encima. Gira despacio (solo los rayos) -->
  <svg
    class="cielo-sol pointer-events-none absolute right-[12%] top-[3%] size-16 md:right-[8%] md:top-[5%] md:size-28"
    viewBox="0 0 100 100"
    aria-hidden="true"
  >
    <path class="cielo-sol-rayos" fill="#FBBF24" d="M50.0 13.0Q58.9 10.0 65.6 3.6Q67.8 14.2 68.5 18.0Q77.8 19.8 86.8 17.6Q83.3 27.9 82.0 31.5Q89.1 37.7 98.0 40.3Q89.9 47.5 87.0 50.0Q90.0 58.9 96.4 65.6Q85.8 67.8 82.0 68.5Q80.2 77.8 82.4 86.8Q72.1 83.3 68.5 82.0Q62.3 89.1 59.7 98.0Q52.5 89.9 50.0 87.0Q41.1 90.0 34.4 96.4Q32.2 85.8 31.5 82.0Q22.2 80.2 13.2 82.4Q16.7 72.1 18.0 68.5Q10.9 62.3 2.0 59.7Q10.1 52.5 13.0 50.0Q10.0 41.1 3.6 34.4Q14.2 32.2 18.0 31.5Q19.8 22.2 17.6 13.2Q27.9 16.7 31.5 18.0Q37.7 10.9 40.3 2.0Q47.5 10.1 50.0 13.0Z" />
    <circle cx="50" cy="50" r="27" fill="#FDE047" />
  </svg>

  <!-- Frase en el cielo, detrás de las nubes (ellas van con z-[2]). En celular las nubes van más arriba y la frase
       más abajo, para que no tapen las primeras palabras -->
  <div class="relative z-[1] mx-auto w-full max-w-4xl px-6 pt-36 md:pt-28">
    <MagicText
      client:visible={{ rootMargin: "300px" }}
      text={frase}
      opacidadInicial={0.25}
      className="text-3xl font-black uppercase leading-[1.08] tracking-tight text-neutral-800 sm:text-4xl md:text-5xl"
    />
  </div>
  {
    [
      { lugar: "left-[6%] top-[5%] w-28 md:top-[14%] md:w-48", opacidad: "opacity-90", deriva: "cielo-deriva-lenta" },
      { lugar: "left-[42%] top-[1%] w-20 md:top-[10%] md:w-32", opacidad: "opacity-70", deriva: "cielo-deriva-media" },
      { lugar: "right-[6%] top-[9%] w-24 md:right-[12%] md:top-[24%] md:w-40", opacidad: "opacity-80", deriva: "cielo-deriva-rapida" },
    ].map((nube) => (
      <div class={`cielo-nube pointer-events-none absolute z-[2] ${nube.lugar}`} aria-hidden="true">
        <svg class={`block w-full ${nube.opacidad} ${nube.deriva}`} viewBox="0 0 200 80">
          <g fill="#ffffff">
            <rect x="20" y="40" width="160" height="34" rx="17" />
            <circle cx="62" cy="44" r="26" />
            <circle cx="106" cy="34" r="32" />
            <circle cx="148" cy="48" r="22" />
          </g>
        </svg>
      </div>
    ))
  }

  <!-- Espacio para el agua y el kayak debajo de la frase -->
  <div class="h-[30svh] shrink-0 md:h-[42svh]" aria-hidden="true"></div>

  <!-- Encima de todas las olas, flotando sobre la de adelante. El div lo mueve el scroll de lado a lado; la imagen
       de adentro se balancea sola sobre las olas -->
  <div data-kayak class="kayak-flotando absolute z-30 w-[60%] max-w-lg md:w-[32%]">
    <img
      src={kayak.src}
      width={kayak.width}
      height={kayak.height}
      alt="Dos personas remando en kayak"
      class="kayak-balanceo block w-full"
      loading="lazy"
      decoding="async"
      draggable="false"
    />
  </div>

  <!-- Agua: el kayak flota sobre su borde -->
  <svg
    class="pointer-events-none absolute inset-x-0 bottom-0 z-20 h-[24%] w-full"
    viewBox="0 0 1440 200"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <g class="agua-capa agua-capa-frente">
      <path
        class="agua-ola agua-ola-frente"
        fill="#2F8FCB"
        fill-opacity="0.92"
        d="M-240 30q85 -16 170 0t170 0t170 0t170 0t170 0t170 0t170 0t170 0t170 0t170 0t170 0t170 0V200H-240Z"
      />
    </g>
  </svg>
</section>

<KayakJs />
