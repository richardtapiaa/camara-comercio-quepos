---
import { getCollection, getEntry } from "astro:content";
import { getImage } from "astro:assets";
import { optimizarImagen } from "@/lib/imagenes";
import mapaEscritorio from "@/assets/mapa/mapa-escritorio.webp";
import mapaMovil from "@/assets/mapa/mapa-movil.webp";

const ALTO_LOGO = 36 * 2;
const ANCHO_FOTO = 420 * 2;

const afiliados = await Promise.all(
  (await getCollection("mapaAfiliados")).map(async ({ id, data: mapa }) => {
    const afiliado = await getEntry("afiliados", id);
    if (!afiliado) throw new Error(`"${id}" está en mapa-afiliados.yaml pero no existe en afiliados.yaml`);
    const { data } = afiliado;
    return {
      id,
      nombre: data.nombre,
      categoria: data.categoria,
      descripcion: data.descripcion,
      logo: {
        src: await optimizarImagen(data.logo, Math.ceil((ALTO_LOGO * data.logo.width) / data.logo.height)),
        ancho: data.logo.width,
        alto: data.logo.height,
      },
      foto: mapa.foto && (await optimizarImagen(mapa.foto, ANCHO_FOTO)),
      info: mapa.info,
      web: data.web,
      facebook: data.facebook,
      instagram: data.instagram,
      lat: mapa.ubicacion.lat,
      lng: mapa.ubicacion.lng,
    };
  }),
);
---

<div data-lenis-prevent data-mapa-afiliados class="relative z-0 h-dvh min-h-[480px] w-full overflow-hidden bg-[#e8f1d9]">
  <picture>
    <source media="(max-width: 767px)" srcset={(await getImage({ src: mapaMovil, format: "webp" })).src} />
    <img
      src={(await getImage({ src: mapaEscritorio, format: "webp" })).src}
      alt=""
      class="absolute inset-0 size-full object-cover"
      fetchpriority="high"
      aria-hidden="true"
    />
  </picture>
  <p data-mapa-aviso class="absolute inset-x-0 bottom-8 z-30 flex justify-center">
    <button
      type="button"
      data-mapa-cargar
      class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-800 shadow-lg ring-1 ring-black/5 transition-colors hover:bg-slate-50"
    >
      Explorar el mapa de afiliados
    </button>
  </p>
  <p class="absolute bottom-1 right-2 text-[10px] text-slate-500">© OpenStreetMap contributors © CARTO</p>
  <div data-mapa-montaje class="absolute inset-0 z-20"></div>
  <script type="application/json" data-mapa-datos set:html={JSON.stringify(afiliados).replace(/</g, "\\u003c")} />
</div>

<script src="../../scripts/mapa/cargar-mapa.ts"></script>
