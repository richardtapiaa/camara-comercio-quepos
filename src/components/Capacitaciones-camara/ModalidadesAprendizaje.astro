---
import FondoSello from "../compartidos/FondoSello";
import cursos from "../../assets/capacitaciones/cursos.svg";
import charlas from "../../assets/capacitaciones/charlas.svg";
import servicioCliente from "../../assets/capacitaciones/servicio-cliente.svg";
import talleres from "../../assets/capacitaciones/talleres.svg";

const cuadrada = "size-52";
const ancha = "h-auto w-64";

const modalidades = [
  { title: "Cursos", image: cursos, color: "#09a5df", tamano: cuadrada },
  { title: "Charlas", image: charlas, color: "#f59e0b", tamano: ancha },
  { title: "Servicio al cliente", image: servicioCliente, color: "#22c55e", tamano: ancha },
  { title: "Talleres", image: talleres, color: "#8b5cf6", tamano: ancha },
];
---

<section id="modalidades" class="relative isolate overflow-x-clip bg-white px-6 pb-20 sm:px-10 sm:pb-28">
  <FondoSello lado="izquierda" />
  <div class="mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <h2 class="text-balance text-2xl font-medium text-slate-900 sm:text-3xl">Aprende de la forma que mejor se adapte a tu equipo</h2>
      <p class="mt-4 max-w-[52ch] text-lg leading-relaxed text-slate-600">
        Ofrecemos cursos, charlas, talleres y formación en servicio al cliente, con contenidos prácticos que se pueden aplicar de inmediato en tu negocio.
      </p>
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-x-12 gap-y-14 sm:grid-cols-2 xl:grid-cols-4 xl:gap-x-16">
      {
        modalidades.map((modalidad) => (
          <li class="pt-28">
            <article class="group flex h-full flex-col rounded-[2.5rem] bg-[#f3f4f6] px-6 pb-8 text-center">
              <div
                class="relative mx-auto -mt-24 size-56 rounded-full shadow-[0_12px_30px_-10px_rgba(16,42,67,0.35)]"
                style={`background-color: ${modalidad.color}`}
              >
                <img
                  src={modalidad.image.src}
                  alt=""
                  class:list={[
                    "absolute bottom-4 left-1/2 max-w-none -translate-x-1/2 object-contain object-bottom drop-shadow-[0_10px_12px_rgba(16,42,67,0.25)] transition-transform duration-300 group-hover:-translate-y-1 group-hover:scale-105",
                    modalidad.tamano,
                  ]}
                  loading="lazy"
                />
              </div>

              <h3 class="mt-6 text-lg font-semibold text-slate-900">{modalidad.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-600 sm:text-base">Formación práctica para impulsar el crecimiento de tu equipo.</p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
