---
import cursos from "../../assets/imagenes-capacitaciones-svg/Cursos.svg";
import charlas from "../../assets/imagenes-capacitaciones-svg/charlas.svg";
import servicioCliente from "../../assets/imagenes-capacitaciones-svg/servicio-cliente.svg";
import talleres from "../../assets/imagenes-capacitaciones-svg/talleres.svg";
import avancemos from "../../assets/imagenes-capacitaciones-svg/avancemos.svg";

const modalidades = [
  { title: "Cursos", image: cursos, color: "#09a5df" },
  { title: "Charlas", image: charlas, color: "#f59e0b" },
  { title: "Servicio al cliente", image: servicioCliente, color: "#22c55e" },
  { title: "Talleres", image: talleres, color: "#8b5cf6" },
];
---

<main>
  <section class="bg-[#f8fafc] px-6 py-16 sm:px-10 sm:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-700">Nuestro compromiso</span>
        <h2 class="mt-4 text-3xl font-semibold leading-tight tracking-tight text-slate-800 sm:text-4xl">
          Aprender para avanzar juntos
        </h2>
        <div class="mt-6 h-1 w-16 rounded-full bg-amber-400"></div>
      </div>

      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-14">
        <aside class="avancemos-panel relative z-10 min-h-[42rem] overflow-hidden bg-white text-white">
          <svg
            class="pointer-events-none absolute -left-px -top-px h-[calc(100%+2px)] w-[calc(100%+2px)]"
            viewBox="0 0 500 800"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              transform="translate(500 0) scale(-1 1)"
              d="M0 0H500V760C465 736 437 738 405 756C370 776 339 792 306 778C273 765 258 731 226 712C194 693 161 695 136 667C108 636 107 608 81 583C55 558 23 554 10 520C0 494 0 460 0 430V0Z"
              fill="#2780c9"></path>
          </svg>
          <div class="relative z-10 p-6 pl-8 pt-5 sm:p-10 sm:pl-12 sm:pt-8">
            <div class="flex justify-center lg:translate-x-32">
              <img
                src={avancemos.src}
                alt="Avancemos juntos mediante la capacitación"
                class="mb-4 h-auto w-[32rem] max-w-[calc(100vw-3rem)] object-contain"
              />
            </div>
            <h3 class="text-3xl font-bold uppercase leading-tight sm:text-4xl">AVANCEMOS</h3>
            <p class="mt-2 text-xl font-semibold">Crecemos a través del aprendizaje</p>
            <ul class="mt-4 space-y-2 border-t border-white/30 pt-4 text-sm leading-6 text-white/90 sm:text-base">
              <li class="flex gap-3">
                <span aria-hidden="true">•</span>
                <span>Fortalecemos el talento local.</span>
              </li>
              <li class="flex gap-3">
                <span aria-hidden="true">•</span>
                <span>Conectamos empresas y conocimiento.</span>
              </li>
              <li class="flex gap-3">
                <span aria-hidden="true">•</span>
                <span>Impulsamos el crecimiento de Quepos.</span>
              </li>
            </ul>
          </div>
        </aside>
        <div class="grid gap-10 lg:-translate-y-12 lg:grid-cols-[1.35fr_0.65fr] lg:items-center lg:gap-16">
          <div>
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-sky-100 text-sky-700">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"></path>
                <path d="M8 7h8M8 11h6"></path>
              </svg>
            </div>
            <p class="max-w-3xl text-lg leading-8 text-slate-700 sm:text-xl sm:leading-9">
              La Cámara coordina capacitaciones con instituciones públicas como el{" "}
              <strong class="font-semibold text-slate-900">ICT</strong>{" "}y el{" "}
              <strong class="font-semibold text-slate-900">INA</strong>, además de profesionales del sector privado.
            </p>
            <ul class="mt-7 grid gap-4 text-sm font-medium text-slate-700 sm:grid-cols-3">
              <li class="flex items-start gap-2">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-600 text-xs text-white">✓</span>
                <span>Alianzas estratégicas</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-600 text-xs text-white">✓</span>
                <span>Expertos especializados</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-600 text-xs text-white">✓</span>
                <span>Enfoque local</span>
              </li>
            </ul>
          </div>
          <div class="grid grid-cols-3 gap-5 border-t border-sky-200 pt-7 lg:grid-cols-1 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
            <div>
              <strong class="block text-4xl font-semibold text-[#102a43]">4</strong>
              <span class="mt-1 block max-w-[10rem] text-sm leading-6 text-slate-600">modalidades de aprendizaje</span>
            </div>
            <div>
              <strong class="block text-4xl font-semibold text-[#102a43]">2</strong>
              <span class="mt-1 block max-w-[10rem] text-sm leading-6 text-slate-600">aliados públicos</span>
            </div>
            <div>
              <strong class="block text-4xl font-semibold text-[#102a43]">1</strong>
              <span class="mt-1 block max-w-[10rem] text-sm leading-6 text-slate-600">propósito compartido</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="modalidades" class="bg-white px-6 pb-20 sm:px-10 sm:pb-28">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-700">Formación a la medida</span>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-800 sm:text-4xl">Modalidades de aprendizaje</h2>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          modalidades.map((modalidad) => (
            <article class="group flex flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white p-4 shadow-[0_12px_35px_-24px_rgba(15,42,67,0.8)] transition-all duration-300 hover:-translate-y-2 hover:border-sky-200 hover:shadow-[0_24px_45px_-22px_rgba(15,42,67,0.45)]">
              <div class="relative flex h-44 items-end justify-center overflow-hidden rounded-2xl bg-slate-50">
                <div
                  class="absolute bottom-0 left-1/2 h-44 w-52 -translate-x-1/2 rounded-t-[999px] opacity-90 transition-transform duration-300 group-hover:scale-105"
                  style={`background-color: ${modalidad.color}`}
                  aria-hidden="true"
                ></div>
                <img
                  src={modalidad.image.src}
                  alt=""
                  class="relative z-10 mb-0 h-44 w-44 object-contain transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-1 flex-col px-2 pb-3 pt-5">
                <h3 class="text-lg font-semibold text-slate-800">{modalidad.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-6 text-slate-500">Formación práctica para impulsar el crecimiento de tu equipo.</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</main>

<style>
  @media (min-width: 1024px) {
    .avancemos-panel {
      margin-left: calc((100vw - 100%) / -2 - 2.5rem);
      width: calc(100% + (100vw - 100%) / 2 + 2.5rem);
    }
  }
</style>