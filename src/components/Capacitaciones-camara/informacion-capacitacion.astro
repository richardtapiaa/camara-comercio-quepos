---
import cursos from "../../assets/imagenes-capacitaciones-svg/Cursos.svg";
import charlas from "../../assets/imagenes-capacitaciones-svg/charlas.svg";
import servicioCliente from "../../assets/imagenes-capacitaciones-svg/servicio-cliente.svg";
import talleres from "../../assets/imagenes-capacitaciones-svg/talleres.svg";
import avancemos from "../../assets/imagenes-capacitaciones-svg/avancemos.svg";

const modalidades = [
  { title: "Cursos", image: cursos, color: "#09a5df" },
  { title: "Charlas", image: charlas, color: "#f59e0b" },
  { title: "Servicio al cliente", image: servicioCliente, color: "#22c55e" },
  { title: "Talleres", image: talleres, color: "#8b5cf6" },
];
---

<main>
  <section class="bg-white px-6 py-16 sm:px-10 sm:py-24">
    <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.3em] text-sky-700">Nuestro compromiso</span>
        <h2 class="mt-6 text-4xl font-bold leading-tight tracking-tight text-[#102a43] sm:text-5xl">
          Aprender para avanzar juntos
        </h2>
        <div class="mt-7 h-1.5 w-20 rounded-full bg-amber-400"></div>
        <p class="mt-8 text-lg leading-8 text-slate-700 sm:text-xl sm:leading-9">
          La Cámara coordina capacitaciones con instituciones públicas como el{" "}
          <strong class="font-semibold text-[#102a43]">ICT</strong>{" "}y el{" "}
          <strong class="font-semibold text-[#102a43]">INA</strong>, además de profesionales del sector privado.
        </p>
        <ul class="mt-8 grid gap-4 text-sm font-medium text-slate-700 sm:grid-cols-3">
          <li class="flex items-start gap-2">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-600 text-xs text-white">✓</span>
            <span>Alianzas estratégicas</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-600 text-xs text-white">✓</span>
            <span>Expertos especializados</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-600 text-xs text-white">✓</span>
            <span>Enfoque local</span>
          </li>
        </ul>
      </div>
      <div class="overflow-hidden rounded-[2rem] bg-sky-50 p-5 shadow-[0_24px_60px_-30px_rgba(15,42,67,0.45)] sm:p-8">
        <img
          src={avancemos.src}
          alt="Ilustración de crecimiento y aprendizaje mediante capacitaciones"
          class="h-auto w-full object-contain"
        />
      </div>
    </div>
  </section>

  <section id="modalidades" class="bg-white px-6 pb-20 sm:px-10 sm:pb-28">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-700">Formación a la medida</span>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-800 sm:text-4xl">Modalidades de aprendizaje</h2>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          modalidades.map((modalidad) => (
            <article class="group flex flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white p-4 shadow-[0_12px_35px_-24px_rgba(15,42,67,0.8)] transition-all duration-300 hover:-translate-y-2 hover:border-sky-200 hover:shadow-[0_24px_45px_-22px_rgba(15,42,67,0.45)]">
              <div class="relative flex h-44 items-end justify-center overflow-hidden rounded-2xl bg-slate-50">
                <div
                  class="absolute bottom-0 left-1/2 h-44 w-52 -translate-x-1/2 rounded-t-[999px] opacity-90 transition-transform duration-300 group-hover:scale-105"
                  style={`background-color: ${modalidad.color}`}
                  aria-hidden="true"
                ></div>
                <img
                  src={modalidad.image.src}
                  alt=""
                  class="relative z-10 mb-0 h-44 w-44 object-contain transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-1 flex-col px-2 pb-3 pt-5">
                <h3 class="text-lg font-semibold text-slate-800">{modalidad.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-6 text-slate-500">Formación práctica para impulsar el crecimiento de tu equipo.</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</main>

<style>
  @media (min-width: 1024px) {
    .avancemos-panel {
      margin-left: calc((100vw - 100%) / -2 - 2.5rem);
      width: calc(100% + (100vw - 100%) / 2 + 2.5rem);
    }
  }
</style>