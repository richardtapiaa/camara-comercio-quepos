---
import avancemos from "../../assets/capacitaciones/avancemos.svg";
import "../../styles/capacitaciones/informacion-capacitacion.css";
---

<section class="bg-white px-6 py-16 sm:px-10 sm:py-24">
  <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-[0.25em] text-neutral-500">Nuestro compromiso</span>
      <p class="mt-8 text-base font-medium leading-relaxed text-neutral-800 sm:text-lg">
        La Cámara coordina capacitaciones con instituciones públicas como el{" "}
        <strong class="font-semibold text-[#102a43]">ICT</strong>{" "}y el{" "}
        <strong class="font-semibold text-[#102a43]"> INA</strong>, además de profesionales del sector privado.
      </p>
     
    </div>
    <div>
      <img
        src={avancemos.src}
        alt="Ilustración de crecimiento y aprendizaje mediante capacitaciones"
        class="h-auto w-full object-contain"
      />
    </div>
  </div>
</section>
