---
import heroImage from "../../assets/imagenes-capacitaciones-svg/hero-capacitaciones.jpg";
---

<section class="relative isolate min-h-screen overflow-hidden text-white">
  <img
    src={heroImage.src}
    alt="Personas participando en una capacitación"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
  />
  <div class="absolute inset-y-0 left-0 -z-10 w-full bg-gradient-to-r from-[#173f98]/95 via-[#173f98]/70 via-45% to-transparent"></div>

  <div class="mx-auto flex min-h-screen max-w-7xl flex-col justify-center px-6 py-20 sm:px-10 lg:px-16">
    <div class="max-w-3xl">
      <div class="mb-8 h-px w-full max-w-3xl bg-white/80"></div>
      <span class="text-sm font-semibold uppercase tracking-[0.3em] text-white/90">
        Crecimiento empresarial
      </span>
      <h1 class="mt-5 text-5xl font-semibold leading-[1.05] tracking-tight sm:text-7xl">
        Capacitaciones
        <span class="block font-normal">para crecer juntos</span>
      </h1>
      <p class="mt-7 max-w-xl text-base leading-7 text-white/90 sm:text-lg">
        Espacios de aprendizaje para fortalecer el talento y las empresas de Quepos.
      </p>
    </div>
  </div>
</section>
