---
import { getImage } from "astro:assets";
import video from "../../assets/capacitaciones/hero-capacitaciones.mp4";
import videoWebm from "../../assets/capacitaciones/hero-capacitaciones.webm";
import poster from "../../assets/capacitaciones/hero-capacitaciones.jpg";
import BordePincelada from "../compartidos/BordePincelada.astro";
// etiqueta-papel.css trae el @font-face de Anton; hero-texto.css, los estilos del título
import "../../styles/compartido/etiqueta-papel.css";
import "../../styles/compartido/hero-texto.css";

const posterOptimizado = await getImage({ src: poster, width: 1920, format: "webp", quality: 70 });
---

<section
  id="hero"
  aria-labelledby="titulo-capacitaciones"
  class="relative isolate flex h-[78svh] min-h-[520px] items-end overflow-hidden bg-[#2b4a5c]"
>
  <!-- Video decorativo. data-video-diferido: muestra el póster y empieza a descargarse cuando la página terminó de
       cargar; con "reducir movimiento" se queda en el póster (scripts/compartido/videos.ts) -->
  <video
    data-video-diferido
    poster={posterOptimizado.src}
    class="absolute inset-0 -z-20 size-full object-cover"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
  >
    <source src={videoWebm} type='video/webm; codecs="av01.0.09M.08"' />
    <source src={video} type="video/mp4" />
  </video>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/75 via-black/40 to-black/45" aria-hidden="true"></div>

  <div class="mx-auto w-full max-w-[1320px] px-6 pb-[clamp(5rem,12vh,8rem)] text-white sm:px-10">
    <p class="hero-texto-kicker">Cámara de Comercio de Quepos</p>
    <h1 id="titulo-capacitaciones" class="hero-texto-titulo">Capacitaciones</h1>
  </div>

  <BordePincelada />
</section>
