---
import { Picture } from "astro:assets";
import foto from "../../assets/Savegre/Savegre_1.JPG";


const puntos = [
  { texto: "Playa Matapalo, Portalón y comunidades costeras y rurales", color: "#326dab" },
  { texto: "La Catarata Río Savegre, sus ríos y caminatas al aire libre", color: "#4e79de" },
  { texto: "Ideal para el ecoturismo, la observación de aves y el turismo rural", color: "#49bfff" },
];
---


<section id="sobre-savegre" aria-labelledby="titulo-sobre-savegre" class="bg-white py-20 sm:py-24">
  <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14 xl:gap-20">
    <div class="px-6 sm:px-10 lg:px-0">
      <Picture
        src={foto}
        formats={["avif", "webp"]}
        alt="Cascada en el bosque de Savegre"
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1024px) 50vw, calc(100vw - 3rem)"
        quality={75}
        loading="lazy"
        decoding="async"
        class="aspect-[3/2] w-full rounded-[2rem] object-cover object-[30%_50%] lg:rounded-l-none"
      />
    </div>

    <div class="px-6 sm:px-10 lg:pl-0 lg:pr-10 xl:pr-[max(2.5rem,calc((100vw-80rem)/2))]">
      <div class="max-w-xl">  
        <h2 id="titulo-sobre-savegre" class="mt-4 text-balance text-3xl font-semibold text-slate-900 sm:text-4xl">Conoce Savegre</h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          Es el distrito más extenso y diverso del cantón de Quepos. Su territorio abarca desde impresionantes zonas
          costeras hasta frondosos corredores fluviales y montañosos, ideal para conectar con la naturaleza, los ríos
          caudalosos y la tranquilidad del sur.
        </p> 

        <ul role="list" class="mt-10 space-y-4">
          {
            puntos.map(({ texto, color }) => (
              <li class="flex items-start gap-3 text-lg text-slate-600">
                <svg viewBox="0 0 24 24" class="mt-1 size-6 shrink-0" style={`color: ${color}`} aria-hidden="true">
                  <path
                    fill="currentColor"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linejoin="round"
                    d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"
                  />
                  <path fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4" />
                </svg>
                <span>{texto}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
