---
import { Picture } from "astro:assets";
import foto from "../../assets/Savegre/Puente_riosavegre.jpg";

// Cada palabra va en su propio span para que frase-scroll.ts (la misma
// animación de FotoNaranjito y FraseCelebre) la vaya encendiendo al bajar.
const frase = "“Entre ríos caudalosos, cataratas y playas tranquilas, Savegre es naturaleza en su estado más puro.”";
const palabras = frase.split(" ");

// Filas de la palabra gigante que va detrás de la foto (solo decoración)
const filas = Array.from({ length: 7 });
---

<!--
  Dos paneles a todo el ancho: a la izquierda, en verde oscuro, la frase abajo;
  a la derecha, en verde claro, la palabra "savegre" repetida en letras
  gigantes y encima la foto, que tapa el centro de cada fila. En celular la
  frase va arriba y la foto debajo. La palabra gigante es decorativa y se oculta
  a los lectores de pantalla. La foto se sirve en AVIF o WebP, en el tamaño de
  cada pantalla (el original mide 1024px).
  Las palabras de la frase se encienden una por una al bajar; con "reducir
  movimiento" activado, o sin JavaScript, la frase se ve completa desde el inicio.
-->
<section data-frase-celebre aria-labelledby="frase-savegre" class="grid bg-[#0f4d3a] lg:min-h-[85svh] lg:grid-cols-2">
  <div class="flex items-end px-6 py-16 sm:px-10 sm:py-20 lg:py-24 lg:pl-10 lg:pr-14 xl:pl-[max(2.5rem,calc((100vw-80rem)/2))]">
    <figure class="max-w-xl">
      <blockquote>
        <p
          id="frase-savegre"
          class="text-balance text-3xl font-semibold leading-[1.2] tracking-tight text-[#d4ead9] sm:text-4xl lg:text-[2.75rem]"
        >
          {palabras.map((palabra) => (
            <>
              <span data-frase-palabra class="inline-block">{palabra}</span>{" "}
            </>
          ))}
        </p>
      </blockquote>
      <figcaption class="mt-6 text-lg text-white/80">Distrito de Savegre, Quepos</figcaption>
    </figure>
  </div>

  <div class="relative isolate flex items-center justify-center overflow-hidden bg-[#d4ead9] px-6 py-14 sm:px-10 sm:py-20">
    <div
      class="pointer-events-none absolute inset-0 -z-10 flex select-none flex-col items-center justify-center text-[clamp(4.5rem,13vw,10.5rem)] font-semibold leading-[0.92] tracking-tight text-[#2f8a5b] lg:text-[clamp(5rem,9.5vw,10.5rem)]"
      aria-hidden="true"
    >
      {filas.map(() => <span class="block whitespace-nowrap">savegre</span>)}
    </div>

    <Picture
      src={foto}
      formats={["avif", "webp"]}
      alt="Puente sobre el río Savegre, que corre entre piedras cubiertas de musgo en medio del bosque"
      widths={[400, 560, 720, 900, 1024]}
      sizes="(min-width: 1024px) min(30vw, 32rem), min(calc(100vw - 3rem), 28rem)"
      quality={78}
      loading="lazy"
      decoding="async"
      class="aspect-[4/5] w-full max-w-md rounded-[1.25rem] object-cover object-[55%_50%] shadow-xl lg:max-w-[min(30vw,32rem)]"
    />
  </div>
</section>

<script src="../../scripts/afiliados/frase-scroll.ts"></script>
