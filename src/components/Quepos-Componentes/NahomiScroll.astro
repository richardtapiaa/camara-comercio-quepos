---
// Paseo por el malecón: al bajar, la imagen se queda fija y avanzan los cuadros del video
// public/malecon/frame_001 a frame_144, en .avif y .webp (sacados de ../videos-originales/NAHOMI-mejorado.webm, fuera del
// repositorio, a 12 fps, 1440×810). En pantallas angostas se usa public/malecon-mobile (recorte vertical 9:16 del centro, 606×1080).
// Se generan con herramientas/cuadros-malecon.sh.
// Mide 360svh: el video avanza durante 260svh de scroll.
// Sube desde abajo encima de SobreBiodiversidadQuepos, jalada por la lapa de LapaArrastre.astro, que va justo antes.
import FraseDecorada from "../compartidos/FraseDecorada.astro";
import { lapa, mono, perezoso, ramito, type Decoracion } from "../compartidos/decoraciones";

// Mientras avanza el video, el título va cambiando entre estas frases (las mueve malecon-scroll.ts con el scroll).
// Desde la segunda llevan los animales de FotoQuepos. Los que van encima de una letra están en la primera palabra y los de
// los lados en la primera o la última letra: así no tapan otra línea cuando la frase se parte en el celular. La lapa de la
// Q de "Quepos" solo va desde lg, donde la frase cabe en una línea.
const frases: { texto: string; decoraciones?: Decoracion[] }[] = [
  { texto: "Un paseo por el Nahomi" },
  {
    texto: "Atardeceres sobre el Pacífico",
    decoraciones: [
      // Lapa en la punta de la A y ramito al pie de la "o" final, hacia afuera
      lapa(0, "left-1/2 bottom-[0.97em] h-[0.95em] lg:h-[1.2em]"),
      ramito(28, "left-[0.58em] bottom-[0.29em] rotate-[15deg] [transform:scaleX(-1)]"),
    ],
  },
  {
    texto: "Arena, mar y brisa tropical",
    decoraciones: [
      // Ramito al pie de la A y perezoso colgado de una rama que sale de la punta de la "l" final
      ramito(0, "left-[0.08em] bottom-[0.29em] -rotate-[15deg]"),
      perezoso(26, "left-[0.04em] bottom-[1.02em] h-[0.95em] lg:h-[1.15em]"),
    ],
  },
  {
    texto: "Bienvenido a Quepos",
    decoraciones: [
      // Mono sentado sobre la B, lapa en lo alto de la Q (solo en una línea) y ramito al pie de la "s" final
      mono(0, "left-[0.3em] bottom-[0.97em] h-[0.9em] lg:h-[1.1em]"),
      lapa(13, "hidden left-[52%] bottom-[0.985em] h-[1.1em] lg:block"),
      ramito(18, "left-[0.52em] bottom-[0.29em] rotate-[15deg] [transform:scaleX(-1)]"),
    ],
  },
];

// Para lectores de pantalla: la primera frase es el título y las demás van en un párrafo oculto
const [titulo, ...siguientes] = frases.map((frase) => frase.texto);
---

<section
  id="malecon-paseo"
  data-malecon-scroll
  data-carpeta="/malecon"
  data-primero="1"
  data-ultimo="144"
  data-panel-sticky
  class="panel sticky top-[min(0px,calc(100svh_-_var(--alto-panel,100svh)))] z-10 h-[360svh] overflow-clip rounded-t-[40px] bg-[#1d2a24] shadow-[0_-20px_50px_rgba(0,0,0,0.35)]"
  aria-label="Paseo por el malecón de Quepos"
>
  <!-- El lienzo mide 100lvh (pantalla con la barra del navegador escondida) para que no quede una franja abajo cuando
       el celular la esconde; el texto sigue dentro de los 100svh para no quedar detrás de la barra cuando se ve -->
  <div class="sticky top-0 h-svh">
    <canvas data-malecon-lienzo class="absolute inset-x-0 top-0 h-lvh w-full" aria-hidden="true"></canvas>
    <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center text-white sm:px-10">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-white/90 drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]">Quepos · Costa Rica</p>
      <h2 class="mt-2 text-[clamp(2.25rem,6vw,4.5rem)] font-black leading-tight drop-shadow-[0_4px_18px_rgba(0,0,0,0.4)]">
        <span class="sr-only">{titulo}</span>
        <!-- Lo que se ve: las frases apiladas en la misma celda del grid, una a la vez (sin animación, solo la primera).
             Escondidas para lectores de pantalla, que leen el título de arriba y el párrafo de abajo -->
        <span class="grid justify-items-center" aria-hidden="true">
          {
            frases.map(({ texto, decoraciones }, i) => (
              <span
                data-malecon-frase
                class:list={["col-start-1 row-start-1 will-change-[transform,opacity]", i > 0 && "translate-y-10 opacity-0"]}
              >
                <FraseDecorada texto={texto} decoraciones={decoraciones} />
              </span>
            ))
          }
        </span>
      </h2>
      <p class="sr-only">{siguientes.join(". ")}.</p>
    </div>
  </div>
</section>

<script src="../../scripts/quepos/malecon-scroll.ts"></script>
