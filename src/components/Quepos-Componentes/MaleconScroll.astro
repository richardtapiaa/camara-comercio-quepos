---
// Segundo paseo por el malecón: entra desde la derecha encima de NahomiScroll y luego avanzan los cuadros del video al bajar.
// Se monta 2,6 pantallas sobre NahomiScroll (-mt-[260svh]): su entrada lateral de 1,6 pantallas (data-entrada-lateral)
// ocurre mientras el video de NahomiScroll sigue avanzando, y lo va empujando hacia la izquierda (data-entrada-empuja).
// Las 260svh siguientes son su propio video.
// Durante la entrada, la lapa de LapasJS la trae agarrada del borde (scripts/quepos/lapa-scroll.ts). La sección arranca
// un 40 % del ancho de pantalla más a la derecha (data-entrada-holgura) para que la lapa entre volando desde afuera.
// public/malecon-2/frame_001 a frame_143, en .avif y .webp (tramo de 5 s a 16,875 s de ../videos-originales/video-quepos-scroll.mp4,
// fuera del repositorio, a 12 fps, 720×900). En pantallas angostas se usa public/malecon-2-mobile.
// Se generan con herramientas/cuadros-malecon.sh.
// Usa el mismo script que NahomiScroll (scripts/quepos/malecon-scroll.ts).
---

<section
  id="malecon-lateral"
  data-malecon-scroll
  data-carpeta="/malecon-2"
  data-primero="1"
  data-ultimo="143"
  data-entrada-lateral="1.6"
  data-entrada-holgura="0.4"
  data-entrada-empuja="#malecon-paseo"
  class="panel relative z-10 -mt-[260svh] h-[420svh] overflow-clip"
  aria-label="Paseo por el malecón de Quepos"
>
  <div class="sticky top-0 h-svh overflow-hidden bg-[#1d2a24] will-change-transform">
    <canvas data-malecon-lienzo class="absolute inset-0 size-full" aria-hidden="true"></canvas>
    <div class="absolute inset-x-0 bottom-0 mx-auto w-full max-w-[1320px] px-6 pb-14 text-white sm:px-10 sm:pb-20">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80">Quepos · Costa Rica</p>
      <h2 class="mt-2 text-[clamp(2rem,5vw,3.75rem)] font-bold leading-tight drop-shadow-[0_4px_18px_rgba(0,0,0,0.4)]">
        Un paseo por el malecón
      </h2>
    </div>
  </div>
</section>

<script src="../../scripts/quepos/malecon-scroll.ts"></script>
