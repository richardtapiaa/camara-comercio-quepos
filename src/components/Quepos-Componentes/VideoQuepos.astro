---
import poster from "../../assets/quepos/catedral/quepos-catedral-poster.jpg";
import videoWebm from "../../assets/quepos/catedral/quepos-catedral.webm";
import videoMp4 from "../../assets/quepos/catedral/quepos-catedral.mp4";
import "../../styles/quepos/video-quepos.css";

// Datos de Quepos que van pasando a la derecha (los mismos de las preguntas frecuentes)
const datos = [
  {
    texto: "Quepos es reconocido por la pesca deportiva y la Marina Pez Vela, con rafting, catamarán, kayak en los manglares, canopy y sus playas.",
    tema: "Qué hacer",
  },
  {
    texto: "La temporada seca va de diciembre a abril; de mayo a noviembre llega la temporada verde, con menos turistas y la naturaleza en su punto más verde.",
    tema: "Cuándo visitar",
  },
  {
    texto: "Desde San José son unas 3 horas en carro por la Ruta 27 y la Costanera Sur, y también hay buses directos y vuelos nacionales.",
    tema: "Cómo llegar",
  },
];
---

<!-- Franja con el video de Quepos de fondo (la playa y la selva de Manuel Antonio), oscurecido para que el texto se
     lea: a la izquierda el título y una frase, y a la derecha datos del destino que van pasando solos, con puntos para
     elegirlos. El video empieza a cargar recién cuando la franja se acerca a la pantalla (scripts/quepos/video-quepos.ts) -->
<section class="relative isolate overflow-hidden bg-[#16201a] text-white" aria-label="Quepos en video">
  <video
    data-video-quepos
    poster={poster.src}
    class="absolute inset-0 -z-20 size-full object-cover"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
  >
    <source src={videoWebm} type='video/webm; codecs="av01.0.05M.08"' />
    <source src={videoMp4} type="video/mp4" />
  </video>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-black/55" aria-hidden="true"></div>

  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 md:grid-cols-2 md:gap-16 md:py-28">
    <div>
      <h2 class="video-quepos-titulo text-[clamp(2.2rem,4.5vw,3.4rem)] leading-[1.08]">
        Quepos, un destino para vivirlo
      </h2>
      <p class="mt-5 max-w-lg text-base leading-relaxed text-white/85 sm:text-lg">
        Playa, selva y mar en un mismo lugar: descubra todo lo que el cantón tiene para ofrecer a quienes lo visitan.
      </p>
    </div>

    <!-- Datos que pasan solos cada pocos segundos; los puntos de abajo permiten elegir uno -->
    <div class="text-center" data-video-quepos-datos>
      <div class="grid">
        {
          datos.map(({ texto, tema }, i) => (
            <figure
              class:list={["video-quepos-dato col-start-1 row-start-1", i === 0 && "es-activo"]}
              aria-hidden={i === 0 ? "false" : "true"}
            >
              <blockquote class="mx-auto max-w-md text-base leading-relaxed text-white/90">{texto}</blockquote>
              <figcaption class="mt-5 text-sm font-semibold tracking-wide">{tema}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="mt-8 flex justify-center gap-2.5">
        {
          datos.map(({ tema }, i) => (
            <button
              type="button"
              class:list={["video-quepos-punto", i === 0 && "es-activo"]}
              aria-label={`Ver: ${tema}`}
              aria-current={i === 0 ? "true" : "false"}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script src="../../scripts/quepos/video-quepos.ts"></script>
