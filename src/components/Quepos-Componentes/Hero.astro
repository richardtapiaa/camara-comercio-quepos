---
import { getImage } from "astro:assets";
import foto from "../../assets/imagenes-quepos/isla-quepos.jpg";
import primerPlano from "../../assets/imagenes-quepos/isla-quepos-primer-plano.webp";

// CAPA 1: la foto tal cual. CAPA 3: la misma foto, del mismo tamaño, con solo la isla y el mar visibles (WebP con
// canal alfa), para que queden delante del título. Las dos se exportan al mismo ancho para que calcen
const fotoOptimizada = await getImage({ src: foto, width: foto.width, format: "webp", quality: 80 });
const primerPlanoOptimizado = await getImage({ src: primerPlano, width: primerPlano.width, format: "webp", quality: 90 });

// "QUEPOS" como el letrero de la foto quepos-foto.webp: cada letra rellena con el mural de su letra (recortes de esa
// foto en letras-quepos/, con el cielo de los huecos rellenado con el color de la letra), su borde de color y el
// canto (la cara de lado, más oscura) para el volumen 3D
const letrasArchivos = import.meta.glob<{ default: ImageMetadata }>("../../assets/imagenes-quepos/letras-quepos/*.webp", {
  eager: true,
});
const textura = (letra: string) => letrasArchivos[`../../assets/imagenes-quepos/letras-quepos/${letra}.webp`].default;
const letras = await Promise.all(
  [
    { letra: "Q", borde: "#e5322b", canto: "#9e1b17" },
    { letra: "U", borde: "#2459c9", canto: "#173b8a" },
    { letra: "E", borde: "#7a2fb0", canto: "#4b1a70" },
    { letra: "P", borde: "#6b3f17", canto: "#3a220b" },
    { letra: "O", borde: "#dba820", canto: "#8c6510" },
    { letra: "S", borde: "#f26a1f", canto: "#a8420f" },
  ].map(async (l) => ({
    ...l,
    src: (await getImage({ src: textura(l.letra.toLowerCase()), width: 500, format: "webp", quality: 85 })).src,
  })),
);
---

<!-- Hero de Quepos en tres capas del mismo tamaño apiladas (mismo enfoque que HeroActividades.tsx): la foto, el
     título "QUEPOS" y encima la isla con el mar, así las letras quedan en el cielo, detrás de la isla.
     El recuadro tiene la proporción de la foto y cubre todo el hero (como object-cover): todo va en porcentajes de
     la foto, así calza en cualquier pantalla -->
<section class="hero-isla relative isolate h-svh min-h-[560px] w-full overflow-hidden bg-[#cfe3f1]" aria-label="Quepos">
  <div
    class="hero-isla-recuadro absolute left-1/2"
    style={{
      width: `max(100cqw, calc(100cqh * ${foto.width} / ${foto.height}))`,
      aspectRatio: `${foto.width} / ${foto.height}`,
      top: `calc((100cqh - max(100cqw * ${foto.height} / ${foto.width}, 100cqh)) * 0.5)`,
    }}
  >
    <!-- CAPA 1 — La foto -->
    <img
      src={fotoOptimizada.src}
      alt="Isla frente a la playa de Manuel Antonio, en Quepos, con surfistas en el mar"
      class="hero-isla-foto absolute inset-0 size-full"
      draggable="false"
      fetchpriority="high"
    />

    <!-- CAPA 2 — Título en el cielo. Su borde de abajo queda a media altura de la isla, así la isla le tapa la parte
         de abajo de las letras. En celular va más arriba porque ahí la isla ocupa todo el ancho y es más grande en
         proporción al título. Al hacer scroll el contenedor baja y el título se esconde detrás de la isla (y lo que
         sobresale a los lados, detrás del mar); la entrada va en el h1 para que no choquen -->
    <div
      data-hero-isla-titulo
      class="hero-isla-titulo absolute bottom-[49%] left-[var(--foco-x)] -translate-x-1/2 md:bottom-[46%]"
    >
      <h1 class="hero-isla-entrada text-center text-[#102a43]">
        <span class="hero-isla-quepos block uppercase">
          {
            letras.map((l) => (
              <span
                class="hero-isla-letra"
                style={`--textura: url("${l.src}"); --borde: ${l.borde}; --canto: ${l.canto}`}
              >
                {l.letra}
              </span>
            ))
          }
        </span>
      </h1>
    </div>

    <!-- CAPA 3 — La isla y el mar, encima del título -->
    <img
      src={primerPlanoOptimizado.src}
      alt=""
      class="hero-isla-foto absolute inset-0 size-full"
      draggable="false"
      aria-hidden="true"
    />
  </div>
</section>

<style>
  .hero-isla {
    /* Para medir el recuadro y el título en % del hero (cqw / cqh) */
    container-type: size;
  }

  /* --foco-x: punto de la foto que queda al centro. En celular, que recorta los costados, se centra en la isla */
  .hero-isla-recuadro {
    --foco-x: 46.7%;
    translate: calc(-1 * var(--foco-x)) 0;
  }
  @media (min-width: 768px) {
    .hero-isla-recuadro {
      --foco-x: 50%;
    }
  }

  /* Tamaño del título: 15 % del ancho de la foto (que es max(100cqw, 150cqh)), sin pasar del 22 % del ancho de la
     pantalla (en celular "QUEPOS" ocupa así casi todo el ancho). */
  .hero-isla-titulo {
    font-size: min(22cqw, max(15cqw, 22.5cqh));
    white-space: nowrap;
  }
  .hero-isla-quepos {
    /* Letra gruesa con remates, como la del letrero */
    font-family: "Alfa Slab One", "Arial Black", Poppins, serif;
    font-weight: 400;
    line-height: 0.85;
    letter-spacing: 0.04em;
    /* Esta letra es más ancha que Arial Black: en pantallas angostas se limita a 18,5 % del ancho del hero para que
       "QUEPOS" quepa entero (en escritorio queda igual, 1em) */
    font-size: min(1em, 18.5cqw);
  }
  /* Cada letra: el mural recortado por la forma de la letra (background-clip: text), un borde de su color y el
     volumen con sombras escalonadas del color del canto hacia abajo a la derecha, más una sombra suave final.
     Las sombras van en filter (drop-shadow), no en text-shadow, porque text-shadow se pinta encima del mural */
  .hero-isla-letra {
    display: inline-block;
    background-image: var(--textura);
    background-size: cover;
    background-position: center;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-stroke: 0.022em var(--borde);
    filter: drop-shadow(0.012em 0.012em 0 var(--canto)) drop-shadow(0.012em 0.012em 0 var(--canto))
      drop-shadow(0.012em 0.012em 0 var(--canto)) drop-shadow(0 0.04em 0.06em rgb(16 42 67 / 0.35));
  }

  /* Entrada: la foto aparece y luego el título sube y aparece */
  @media (prefers-reduced-motion: no-preference) {
    .hero-isla-foto {
      animation: hero-isla-aparece 1s ease-out both;
    }
    .hero-isla-entrada {
      animation: hero-isla-sube 1s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
    }
  }
  @keyframes hero-isla-aparece {
    from {
      opacity: 0;
    }
  }
  @keyframes hero-isla-sube {
    from {
      opacity: 0;
      translate: 0 40px;
    }
  }

  /* Al hacer scroll el título baja hasta quedar entero bajo el horizonte, escondido detrás de la isla y el mar.
     --bajada es cuánto baja, en % del alto del título: en celular más, porque ahí el título está más arriba de la
     isla. Usa transform (y no translate, que ya centra el contenedor). Va con scroll-driven animations: el
     navegador lo mueve junto con el scroll; sin soporte (Firefox, Safari < 26) se usa GSAP abajo */
  .hero-isla-titulo {
    --bajada: 210%;
  }
  @media (min-width: 768px) {
    .hero-isla-titulo {
      --bajada: 145%;
    }
  }
  /* No se anima transform directamente: Chrome mandaría esa animación a la GPU, con el título en su propia capa, y
     al hacer scroll rápido el título se alcanzaba a ver un instante POR DELANTE de la isla (las capas se reacomodan
     tarde). Se anima un número (--hero-isla-progreso, de 0 a 1) y el transform se calcula con él: así el título se
     dibuja junto con la foto y la isla siempre queda encima */
  @property --hero-isla-progreso {
    syntax: "<number>";
    inherits: false;
    initial-value: 0;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-isla {
        view-timeline-name: --hero-isla;
      }
      .hero-isla-titulo {
        transform: translateY(calc(var(--hero-isla-progreso) * var(--bajada)));
        animation: hero-isla-esconde linear both;
        animation-timeline: --hero-isla;
        /* El hero arranca ocupando la pantalla: termina de esconderse cuando se ha hecho scroll del 85 % de su
           alto, así baja despacio */
        animation-range: exit 0% exit 85%;
      }
    }
  }
  @keyframes hero-isla-esconde {
    to {
      --hero-isla-progreso: 1;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const conCss = CSS.supports("animation-timeline: view()");
  const sinMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Mismo recorrido que el keyframe hero-isla-esconde, para navegadores sin scroll-driven animations
  if (!conCss && !sinMovimiento) {
    document.querySelectorAll<HTMLElement>("[data-hero-isla-titulo]").forEach((titulo) => {
      const hero = titulo.closest<HTMLElement>(".hero-isla");
      if (!hero) return;
      gsap.to(titulo, {
        y: () => (parseFloat(getComputedStyle(titulo).getPropertyValue("--bajada")) / 100) * titulo.offsetHeight,
        ease: "none",
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          // Equivale a "exit 85%" del CSS
          end: () => `+=${hero.offsetHeight * 0.85}`,
          scrub: true,
          invalidateOnRefresh: true,
        },
      });
    });
  }
</script>
