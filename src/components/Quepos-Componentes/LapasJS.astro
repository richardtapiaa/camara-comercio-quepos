---
import lapa from "../../assets/quepos/lapa-sin-fondo.webp";

import { MagicText } from "../ReactComponentes/QUEPOS/ScrollReveal";
import "../../styles/quepos/lapa-scroll.css";
import "../../styles/compartido/cielo-sol.css";
import "../../styles/quepos/lapas.css";

const frase =
  "“En Quepos las lapas rojas cruzan el cielo entre la selva y el mar: una señal de que aquí la naturaleza sigue viva.”";
---

<section
  data-lapa-scroll
  class="lapas-recuadro relative isolate flex min-h-[48svh] flex-col overflow-hidden bg-[#E8F4FA] md:min-h-[70svh]"
  aria-label="Lapa roja volando sobre Quepos"
>
  <svg
    class="cielo-sol pointer-events-none absolute right-4 top-28 z-[5] size-14 md:right-[19%] md:top-[14%] md:size-28"
    viewBox="0 0 100 100"
    aria-hidden="true"
  >
    <path class="cielo-sol-rayos" fill="#FBBF24" d="M50.0 13.0Q58.9 10.0 65.6 3.6Q67.8 14.2 68.5 18.0Q77.8 19.8 86.8 17.6Q83.3 27.9 82.0 31.5Q89.1 37.7 98.0 40.3Q89.9 47.5 87.0 50.0Q90.0 58.9 96.4 65.6Q85.8 67.8 82.0 68.5Q80.2 77.8 82.4 86.8Q72.1 83.3 68.5 82.0Q62.3 89.1 59.7 98.0Q52.5 89.9 50.0 87.0Q41.1 90.0 34.4 96.4Q32.2 85.8 31.5 82.0Q22.2 80.2 13.2 82.4Q16.7 72.1 18.0 68.5Q10.9 62.3 2.0 59.7Q10.1 52.5 13.0 50.0Q10.0 41.1 3.6 34.4Q14.2 32.2 18.0 31.5Q19.8 22.2 17.6 13.2Q27.9 16.7 31.5 18.0Q37.7 10.9 40.3 2.0Q47.5 10.1 50.0 13.0Z" />
    <circle cx="50" cy="50" r="27" fill="#FDE047" />
  </svg>

  <div class="relative z-[1] mx-auto w-full max-w-4xl px-6 pt-40 md:pt-56">
    <MagicText
      client:visible={{ rootMargin: "300px" }}
      text={frase}
      opacidadInicial={0.25}
      className="text-3xl font-black uppercase leading-[1.08] tracking-tight text-neutral-800 sm:text-4xl md:text-5xl"
    />
  </div>

  <div class="h-[34svh] shrink-0 md:h-[44svh]" aria-hidden="true"></div>

  <img
    data-lapa
    src={lapa.src}
    width={lapa.width}
    height={lapa.height}
    alt="Lapa roja en vuelo"
    class="absolute bottom-[12%] z-[3] w-[50%] max-w-md md:bottom-[14%] md:w-[30%]"
    loading="lazy"
    decoding="async"
    draggable="false"
  />

  {
    ["left-0", "right-0 -scale-x-100"].map((lado) => (
      <svg
        class={`nube-svg pointer-events-none absolute top-0 z-10 w-[88%] max-w-xl md:w-[42%] ${lado}`}
        viewBox="0 0 420 180"
        preserveAspectRatio="xMinYMin meet"
        aria-hidden="true"
      >
        <g class="nube-capa nube-capa-atras">
          <path
            class="nube-ola nube-ola-atras"
            fill="#ffffff"
            fill-opacity="0.6"
            d="M-20 0H430C430 42 392 58 360 46C348 82 298 94 270 74C256 108 206 120 178 98C164 134 114 148 88 126C74 160 24 176 -20 160Z"
          />
        </g>
        <g class="nube-capa nube-capa-medio">
          <path
            class="nube-ola nube-ola-medio"
            fill="#ffffff"
            fill-opacity="0.85"
            d="M-20 0H370C370 34 338 48 312 38C300 68 258 78 236 62C222 92 180 100 158 82C144 112 104 122 82 104C68 132 28 144 -20 132Z"
          />
        </g>
        <g class="nube-capa nube-capa-frente">
          <path
            class="nube-ola nube-ola-frente"
            fill="#ffffff"
            d="M-20 0H300C300 26 276 38 254 30C244 54 210 62 192 50C180 74 146 80 128 66C116 90 82 98 64 84C52 106 18 114 -20 104Z"
          />
        </g>
      </svg>
    ))
  }

  <div class="selva-capa selva-capa-atras pointer-events-none absolute -inset-x-32 bottom-0 z-[1] h-[4.5rem] suelo-pasto md:h-[max(6rem,7vw)]" aria-hidden="true"></div>
  <div class="selva-capa selva-capa-frente pointer-events-none absolute -inset-x-32 bottom-0 z-[1] h-14 suelo-tierra md:h-[max(5rem,6vw)]" aria-hidden="true"></div>
</section>

<script src="../../scripts/quepos/lapa-scroll.ts"></script>
