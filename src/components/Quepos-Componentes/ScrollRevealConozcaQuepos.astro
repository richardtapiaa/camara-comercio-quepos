---
import { MagicText } from "../ReactComponentes/QUEPOS/ScrollReveal";

const frase =
  "“Ya sea recorriendo los senderos de Manuel Antonio o remando entre sus manglares, Quepos es tu punto de partida para la aventura.”";
---

<section class="flex min-h-[70svh] items-center bg-[#E8F4FA] px-6 py-24 md:py-32">
  <div class="mx-auto w-full max-w-4xl">
    <MagicText
      client:visible={{ rootMargin: "300px" }}
      text={frase}
      opacidadInicial={0.25}
      className="text-3xl font-black uppercase leading-[1.08] tracking-tight text-neutral-800 sm:text-4xl md:text-5xl"
    />
  </div>
</section>
