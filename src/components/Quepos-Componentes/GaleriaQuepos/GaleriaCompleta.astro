---
import { Image } from "astro:assets";
import { optimizarImagen } from "../../../lib/imagenes";
import GaleriaQuepos from "../../ReactComponentes/QUEPOS/GaleriaQuepos";
import beneficios from "../../../assets/imagenes/beneficios-seccion.jpg";
import checkout from "../../../assets/imagenes/seccion-checkout.jpg";
import ejemplo from "../../../assets/imagenes/seccion-ejemplo.jpg";
import fondo from "../../../assets/imagenes/fondo-inicio-queposx.webp";
import hero from "../../../assets/imagenes/quepos-foto.webp";
import mision from "../../../assets/imagenes/mision-seccion.jpg";
import vision from "../../../assets/imagenes/vision-seccion.jpg";
import palmera from "../../../assets/imagenes-quepos/palmera-sin-fondo.webp";
import perezoso from "../../../assets/imagenes visitors/actividades-1.jpg";
import rafting from "../../../assets/imagenes visitors/actividades-2.jpg";
import catamaran from "../../../assets/imagenes visitors/actividades-3.jpg";
import rappel from "../../../assets/imagenes visitors/actividades-4.jpg";
import manglares from "../../../assets/imagenes visitors/actividades-5.jpg";
import pesca from "../../../assets/imagenes visitors/actividades-6.jpeg";
import bahia from "../../../assets/imagenes visitors/hero-visitanos.jpg";
import isla from "../../../assets/imagenes-quepos/isla-quepos.jpg";
import malecon from "../../../assets/imagenes-hospitalidad/malecon-letras.jpg";
import mercado from "../../../assets/imagenes-hospitalidad/mercado-municipal.jpg";
import hotelPiscina from "../../../assets/imagenes-hospitalidad/hotel-piscina.jpg";
import hotelVillaTeca from "../../../assets/imagenes-hospitalidad/hotel-villa-teca.jpg";
import centro from "../../../assets/imagenes-hospitalidad/centro-comercio.jpg";
import habitacion from "../../../assets/imagenes-hospitalidad/hospitalidad-1.webp";

// Tamaño de las palmeras: crecen con el ancho de la pantalla; el texto empieza debajo de sus hojas (ver el
// espacio de arriba del contenido). Arriba se difuminan para ocultar el corte de la foto
const clasesPalmera =
  "h-auto w-44 select-none sm:w-64 md:w-72 lg:w-80 xl:w-96 2xl:w-[28rem] [mask-image:linear-gradient(to_bottom,transparent,black_30%)]";

const items = [
  { id: 1, src: await optimizarImagen(hero, 1600), alt: "Paisaje de Quepos" },
  { id: 2, src: await optimizarImagen(fondo, 1600), alt: "Naturaleza de Quepos" },
  { id: 3, src: await optimizarImagen(mision, 1600), alt: "Misión de la Cámara" },
  { id: 4, src: await optimizarImagen(vision, 1600), alt: "Visión de la Cámara" },
  { id: 5, src: await optimizarImagen(beneficios, 1600), alt: "Beneficios para afiliados" },
  { id: 6, src: await optimizarImagen(checkout, 1600), alt: "Costa de Quepos" },
  { id: 7, src: await optimizarImagen(ejemplo, 1600), alt: "Ejemplo de emprendimiento local" },
  { id: 8, src: await optimizarImagen(isla, 1600), alt: "Isla frente a la playa de Manuel Antonio, con surfistas en el mar" },
  { id: 9, src: await optimizarImagen(perezoso, 1600), alt: "Perezoso colgado de una rama en el bosque" },
  { id: 10, src: await optimizarImagen(bahia, 1600), alt: "Bahía rodeada de bosque tropical vista desde lo alto" },
  { id: 11, src: await optimizarImagen(rafting, 1600), alt: "Grupo haciendo rafting en el río" },
  { id: 12, src: await optimizarImagen(malecon, 1600), alt: "Letras de colores de Quepos en el malecón" },
  { id: 13, src: await optimizarImagen(catamaran, 1600), alt: "Catamarán navegando al atardecer" },
  { id: 14, src: await optimizarImagen(manglares, 1600), alt: "Kayaks entre los manglares" },
  { id: 15, src: await optimizarImagen(mercado, 1600), alt: "Jardines frente al mercado municipal de Quepos" },
  { id: 16, src: await optimizarImagen(rappel, 1600), alt: "Turista haciendo rappel en el bosque" },
  { id: 17, src: await optimizarImagen(hotelPiscina, 1600), alt: "Piscina de un hotel con hamacas y vista al bosque" },
  { id: 18, src: await optimizarImagen(pesca, 1600), alt: "Marlín saltando en el mar" },
  { id: 19, src: await optimizarImagen(hotelVillaTeca, 1600), alt: "Cabañas de un hotel entre jardines tropicales" },
  { id: 20, src: await optimizarImagen(centro, 1600), alt: "Calle del centro de Quepos" },
  { id: 21, src: await optimizarImagen(habitacion, 1600), alt: "Habitación de hotel en Quepos" },
];
---

<section id="galeria-completa" class="relative w-full self-start overflow-x-clip bg-white">
  <!-- Palmeras colgando de las esquinas de arriba (mismas que GaleriaQuepos.astro): la de la derecha tal cual y la
       de la izquierda en espejo, saliendo del borde de la pantalla. No bloquean los clics. La foto trae las hojas
       cortadas en línea recta arriba: ese borde se difumina para que no se vea el corte -->
  <Image
    src={palmera}
    alt=""
    width={600}
    class={`pointer-events-none absolute right-0 top-0 ${clasesPalmera}`}
    loading="lazy"
    draggable="false"
    aria-hidden="true"
  />
  <Image
    src={palmera}
    alt=""
    width={600}
    class={`pointer-events-none absolute left-0 top-0 -scale-x-100 ${clasesPalmera}`}
    loading="lazy"
    draggable="false"
    aria-hidden="true"
  />

  <!-- "relative" (sin z-index) deja el contenido delante de las palmeras sin crear un contexto de apilamiento: así
       el visor de fotos ampliadas (fixed z-[70]) sigue quedando por encima de la barra de navegación -->
  <!-- El espacio de arriba crece con las palmeras (que miden 2/3 de su ancho de alto), así el texto empieza debajo
       de las hojas y nunca queda cruzado por ellas -->
  <div class="relative mx-auto max-w-7xl px-4 pb-24 pt-32 sm:px-6 sm:pt-44 md:pt-48 lg:pt-52 xl:pt-60 2xl:pt-72">
    <header class="mb-16 space-y-4">
     
    </header>

    <GaleriaQuepos client:load items={items} />
  </div>
</section>
