---
import { Image } from "astro:assets";
import { variantesGaleria } from "../../../lib/imagenes";
import GaleriaQuepos from "../../ReactComponentes/QUEPOS/GaleriaQuepos";
import palmera from "../../../assets/quepos/palmera-sin-fondo.webp";
import { VelocityScroll } from "../../ReactComponentes/QUEPOS/ScrollVelocity.tsx";
import CurvasTopograficas from "../../compartidos/decoracion/CurvasTopograficas.astro";
import HojaLineas from "../../compartidos/decoracion/HojaLineas.astro";
import BandadaLineas from "../../compartidos/decoracion/BandadaLineas.astro";
import HojasTropicales from "../../compartidos/decoracion/HojasTropicales.astro";
import OndasArena from "../../compartidos/decoracion/OndasArena.astro";

const clasesPalmera =
  "pointer-events-none absolute top-20 z-10 h-auto w-32 select-none sm:top-24 sm:w-56 md:w-72 lg:w-80 xl:w-96 [mask-image:linear-gradient(to_bottom,transparent,black_25%)]";
const sizesPalmera = "(min-width: 1280px) 384px, (min-width: 1024px) 320px, (min-width: 768px) 288px, (min-width: 640px) 224px, 128px";

const archivos = import.meta.glob<{ default: ImageMetadata }>("../../../assets/galeria/*.webp", { eager: true });
const foto = (nombre: string) => archivos[`../../../assets/galeria/${nombre}.webp`].default;

const fotos: [nombre: string, alt: string][] = [
  ["letras-quepos", "Letras de colores de Quepos frente al mar"],
  ["playa-manuel-antonio-aerea", "Vista aérea de una playa de Manuel Antonio con una isla cubierta de bosque"],
  ["mono-carablanca", "Mono carablanca sobre una rama"],
  ["marina-pez-vela", "Marina Pez Vela vista desde el aire, con sus muelles y la playa"],
  ["lapa-roja", "Lapa roja posada en una rama"],
  ["catarata-bosque", "Catarata entre el bosque tropical"],
  ["baile-folclorico", "Bailarina con traje típico costarricense en un desfile"],
  ["delfin", "Delfín nadando en el mar azul"],
  ["atardecer-playa", "Atardecer en la playa con islas en el horizonte"],
  ["kayak-rio", "Grupo en kayak por un río entre la selva"],
  ["mariposa-morpho", "Mariposa morpho azul sobre la mano de una persona"],
  ["artesano-carreta", "Artesano pintando una carreta típica"],
  ["catarata-nauyaca", "Catarata de dos caídas con una poza al pie"],
  ["festival-marina", "Festival nocturno en Marina Pez Vela con luces y público"],
  ["tortuga-bebe", "Tortuga bebé caminando en la arena hacia el mar"],
  ["puente-colgante", "Puente colgante en medio del bosque"],
  ["cocina-tipica", "Cocineros sonrientes junto a un fogón de leña con chorizos"],
  ["rocas-playa-aerea", "Vista aérea de rocas con bosque y olas en la playa"],
  ["pez-vela", "Pez vela junto a la lancha durante la pesca deportiva"],
  ["caballo", "Caballo con montura en el campo"],
  ["iglesia", "Iglesia blanca de madera en medio de la neblina"],
  ["sandias-mercado", "Vendedor de sandías en un camión, con una sandía partida al frente"],
  ["fogata-playa", "Amigos tocando guitarra junto a una fogata en la playa al atardecer"],
  ["isla-olas", "Isla rocosa iluminada por el sol frente a las olas"],
  ["yoga-playa", "Mujer haciendo yoga en la orilla de la playa"],
  ["nina-cara-pintada", "Niña con la bandera de Costa Rica pintada en la cara"],
  ["rio-aereo", "Río que serpentea entre el valle y las montañas, visto desde el aire"],
  ["palmeras-atardecer", "Pareja entre siluetas de palmeras al atardecer"],
];

const items = await Promise.all(
  fotos.map(async ([nombre, alt], i) => ({ id: i + 1, ...(await variantesGaleria(foto(nombre))), alt })),
);

const hojas = [
  { clase: "left-[1.5%] top-[25rem] w-36", giro: -22 },
  { clase: "right-[2%] top-[45%] w-32", giro: 28 },
  { clase: "left-[2.5%] top-[66%] w-28", giro: 14 },
];
const bandadas: { clase: string; aves: [number, number, number][] }[] = [
  { clase: "right-[2%] top-[21rem] w-48", aves: [[0, 0, 1], [34, -18, 0.75], [62, 4, 0.6]] },
  { clase: "left-[2%] top-[43%] w-44", aves: [[0, 0, 0.9], [-30, -16, 0.7], [26, -26, 0.55]] },
  { clase: "right-[3%] top-[75%] w-36", aves: [[0, 0, 0.8], [30, -12, 0.6]] },
];
---


<section id="galeria-completa" aria-labelledby="titulo-galeria" class="relative isolate w-full overflow-hidden bg-[#faf7f2]">
 
  <CurvasTopograficas class="-right-48 top-[30rem] hidden w-[52rem] text-[#b9a78a] opacity-30 md:block" />
  <CurvasTopograficas class="-left-60 top-[58%] hidden w-[40rem] -scale-x-100 text-[#b9a78a] opacity-25 md:block" anillos={8} giroInicial={40} pasoGiro={9} />

  
  {hojas.map(({ clase, giro }) => <HojaLineas class={`hidden text-[#a8967a] opacity-55 min-[1680px]:block ${clase}`} giro={giro} />)}
  {bandadas.map(({ clase, aves }) => <BandadaLineas class={`hidden text-[#a8967a] opacity-60 min-[1680px]:block ${clase}`} aves={aves} />)}

  <Image src={palmera} alt="" width={600} widths={[300, 450, 600]} sizes={sizesPalmera} class={`right-0 ${clasesPalmera}`} loading="lazy" draggable="false" aria-hidden="true" />
  <Image src={palmera} alt="" width={600} widths={[300, 450, 600]} sizes={sizesPalmera} class={`left-0 -scale-x-100 ${clasesPalmera}`} loading="lazy" draggable="false" aria-hidden="true" />

  <HojasTropicales class="bottom-10 left-0 hidden w-56 md:block lg:w-72" />
  <HojasTropicales class="bottom-10 right-0 hidden w-56 md:block lg:w-72" espejo />

  <OndasArena class="bottom-0 h-40 sm:h-56" />

  <h1 id="titulo-galeria" class="sr-only">Galería de Quepos</h1>

  <div class="overflow-hidden pb-8 pt-28 sm:pb-12 sm:pt-32" aria-hidden="true">
    <div class="[mask-image:linear-gradient(to_bottom,black_50%,transparent_96%)]">
      <VelocityScroll
        client:visible
        text="GALERIA"
        default_velocity={5}
        scrollReactive={false}
        filas={2}
        className="font-serif text-5xl font-bold uppercase tracking-[0.12em] text-black sm:text-7xl lg:text-8xl"
      />
    </div>
  </div>

  <div class="relative mx-auto max-w-[1600px] px-4 pb-40 sm:px-8 sm:pb-52 lg:px-12">
    <GaleriaQuepos client:visible items={items} rejilla />

    <p class="mt-10 text-center text-xs font-medium uppercase tracking-[0.25em] text-tinta sm:text-sm sm:tracking-[0.35em]">
      <span class="whitespace-nowrap">Costa Rica</span>
      <span class="mx-2 hidden text-[#b9a78a] sm:inline" aria-hidden="true">|</span>
      <span class="block whitespace-nowrap sm:inline">Naturaleza y cultura</span>
    </p>
  </div>
</section>
