---
import { Image } from "astro:assets";
import { variantesGaleria } from "../../../lib/imagenes";
import GaleriaQuepos from "../../ReactComponentes/QUEPOS/GaleriaQuepos";
import beneficios from "../../../assets/quepos/beneficios-seccion.jpg";
import checkout from "../../../assets/quepos/seccion-checkout.jpg";
import ejemplo from "../../../assets/quepos/seccion-ejemplo.jpg";
import fondo from "../../../assets/quepos/fondo-inicio-queposx.webp";
import hero from "../../../assets/quepos/quepos-foto.webp";
import mision from "../../../assets/quepos/mision-seccion.jpg";
import vision from "../../../assets/quepos/vision-seccion.jpg";
import palmera from "../../../assets/quepos/palmera-sin-fondo.webp";
import perezoso from "../../../assets/actividades/actividades-1.jpg";
import rafting from "../../../assets/actividades/actividades-2.jpg";
import catamaran from "../../../assets/actividades/actividades-3.jpg";
import rappel from "../../../assets/actividades/actividades-4.jpg";
import manglares from "../../../assets/actividades/actividades-5.jpg";
import pesca from "../../../assets/actividades/actividades-6.jpeg";
import bahia from "../../../assets/actividades/hero-visitanos.jpg";
import isla from "../../../assets/quepos/isla-quepos.jpg";
import malecon from "../../../assets/hospitalidad/malecon-letras.jpg";
import mercado from "../../../assets/gastronomia/mercado-municipal.jpg";
import hotelPiscina from "../../../assets/hospitalidad/hotel-piscina.jpg";
import hotelVillaTeca from "../../../assets/hospitalidad/hotel-villa-teca.jpg";
import centro from "../../../assets/hospitalidad/centro-comercio.jpg";
import habitacion from "../../../assets/hospitalidad/hospitalidad-1.webp";

const clasesPalmera =
  "h-auto w-44 select-none sm:w-64 md:w-72 lg:w-80 xl:w-96 2xl:w-[28rem] [mask-image:linear-gradient(to_bottom,transparent,black_30%)]";
// Los mismos anchos de clasesPalmera, para que el navegador elija la versión del tamaño justo
const sizesPalmera =
  "(min-width: 1536px) 448px, (min-width: 1280px) 384px, (min-width: 1024px) 320px, (min-width: 768px) 288px, (min-width: 640px) 256px, 176px";

const items = [
  { id: 1, ...(await variantesGaleria(hero)), alt: "Paisaje de Quepos" },
  { id: 2, ...(await variantesGaleria(fondo)), alt: "Naturaleza de Quepos" },
  { id: 3, ...(await variantesGaleria(mision)), alt: "Misión de la Cámara" },
  { id: 4, ...(await variantesGaleria(vision)), alt: "Visión de la Cámara" },
  { id: 5, ...(await variantesGaleria(beneficios)), alt: "Beneficios para afiliados" },
  { id: 6, ...(await variantesGaleria(checkout)), alt: "Costa de Quepos" },
  { id: 7, ...(await variantesGaleria(ejemplo)), alt: "Ejemplo de emprendimiento local" },
  { id: 8, ...(await variantesGaleria(isla)), alt: "Isla frente a la playa de Manuel Antonio, con surfistas en el mar" },
  { id: 9, ...(await variantesGaleria(perezoso)), alt: "Perezoso colgado de una rama en el bosque" },
  { id: 10, ...(await variantesGaleria(bahia)), alt: "Bahía rodeada de bosque tropical vista desde lo alto" },
  { id: 11, ...(await variantesGaleria(rafting)), alt: "Grupo haciendo rafting en el río" },
  { id: 12, ...(await variantesGaleria(malecon)), alt: "Letras de colores de Quepos en el malecón" },
  { id: 13, ...(await variantesGaleria(catamaran)), alt: "Catamarán navegando al atardecer" },
  { id: 14, ...(await variantesGaleria(manglares)), alt: "Kayaks entre los manglares" },
  { id: 15, ...(await variantesGaleria(mercado)), alt: "Jardines frente al mercado municipal de Quepos" },
  { id: 16, ...(await variantesGaleria(rappel)), alt: "Turista haciendo rappel en el bosque" },
  { id: 17, ...(await variantesGaleria(hotelPiscina)), alt: "Piscina de un hotel con hamacas y vista al bosque" },
  { id: 18, ...(await variantesGaleria(pesca)), alt: "Marlín saltando en el mar" },
  { id: 19, ...(await variantesGaleria(hotelVillaTeca)), alt: "Cabañas de un hotel entre jardines tropicales" },
  { id: 20, ...(await variantesGaleria(centro)), alt: "Calle del centro de Quepos" },
  { id: 21, ...(await variantesGaleria(habitacion)), alt: "Habitación de hotel en Quepos" },
];
---

<section id="galeria-completa" class="relative w-full self-start overflow-x-clip bg-white">
  <Image
    src={palmera}
    alt=""
    width={600}
    widths={[300, 450, 600]}
    sizes={sizesPalmera}
    class={`pointer-events-none absolute right-0 top-0 ${clasesPalmera}`}
    loading="lazy"
    fetchpriority="low"
    draggable="false"
    aria-hidden="true"
  />
  <Image
    src={palmera}
    alt=""
    width={600}
    widths={[300, 450, 600]}
    sizes={sizesPalmera}
    class={`pointer-events-none absolute left-0 top-0 -scale-x-100 ${clasesPalmera}`}
    loading="lazy"
    fetchpriority="low"
    draggable="false"
    aria-hidden="true"
  />

  <div class="relative mx-auto max-w-7xl px-4 pb-24 pt-32 sm:px-6 sm:pt-44 md:pt-48 lg:pt-52 xl:pt-60 2xl:pt-72">
    <GaleriaQuepos client:visible items={items} />
  </div>
</section>
