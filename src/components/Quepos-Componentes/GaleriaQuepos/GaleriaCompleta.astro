---
import { Image } from "astro:assets";
import { variantesGaleria } from "../../../lib/imagenes";
import GaleriaQuepos from "../../ReactComponentes/QUEPOS/GaleriaQuepos";
import palmera from "../../../assets/quepos/palmera-sin-fondo.webp";

const clasesPalmera =
  "h-auto w-44 select-none sm:w-64 md:w-72 lg:w-80 xl:w-96 2xl:w-[28rem] [mask-image:linear-gradient(to_bottom,transparent,black_30%)]";
// Los mismos anchos de clasesPalmera, para que el navegador elija la versión del tamaño justo
const sizesPalmera =
  "(min-width: 1536px) 448px, (min-width: 1280px) 384px, (min-width: 1024px) 320px, (min-width: 768px) 288px, (min-width: 640px) 256px, 176px";

// Fotos de "Fotografias de la Zona de Quepos" (sesión profesional), guardadas en WebP en src/assets/galeria/.
// Astro genera de cada una varias versiones (360, 600 y 900 px para la cuadrícula y 1600 px para verla en grande) y el
// navegador baja solo la que necesita. El orden es el de la cuadrícula: se mezclan paisajes, fauna, cultura y
// aventura para que ninguna columna quede con fotos parecidas
const archivos = import.meta.glob<{ default: ImageMetadata }>("../../../assets/galeria/*.webp", { eager: true });
const foto = (nombre: string) => archivos[`../../../assets/galeria/${nombre}.webp`].default;
const fotos: [nombre: string, alt: string][] = [
  ["letras-quepos", "Letras de colores de Quepos frente al mar"],
  ["playa-manuel-antonio-aerea", "Vista aérea de una playa de Manuel Antonio con una isla cubierta de bosque"],
  ["mono-carablanca", "Mono carablanca sobre una rama"],
  ["marina-pez-vela", "Marina Pez Vela vista desde el aire, con sus muelles y la playa"],
  ["lapa-roja", "Lapa roja posada en una rama"],
  ["catarata-bosque", "Catarata entre el bosque tropical"],
  ["baile-folclorico", "Bailarina con traje típico costarricense en un desfile"],
  ["delfin", "Delfín nadando en el mar azul"],
  ["atardecer-playa", "Atardecer en la playa con islas en el horizonte"],
  ["kayak-rio", "Grupo en kayak por un río entre la selva"],
  ["mariposa-morpho", "Mariposa morpho azul sobre la mano de una persona"],
  ["artesano-carreta", "Artesano pintando una carreta típica"],
  ["catarata-nauyaca", "Catarata de dos caídas con una poza al pie"],
  ["festival-marina", "Festival nocturno en Marina Pez Vela con luces y público"],
  ["tortuga-bebe", "Tortuga bebé caminando en la arena hacia el mar"],
  ["puente-colgante", "Puente colgante en medio del bosque"],
  ["cocina-tipica", "Cocineros sonrientes junto a un fogón de leña con chorizos"],
  ["rocas-playa-aerea", "Vista aérea de rocas con bosque y olas en la playa"],
  ["pez-vela", "Pez vela junto a la lancha durante la pesca deportiva"],
  ["caballo", "Caballo con montura en el campo"],
  ["iglesia", "Iglesia blanca de madera en medio de la neblina"],
  ["sandias-mercado", "Vendedor de sandías en un camión, con una sandía partida al frente"],
  ["fogata-playa", "Amigos tocando guitarra junto a una fogata en la playa al atardecer"],
  ["isla-olas", "Isla rocosa iluminada por el sol frente a las olas"],
  ["yoga-playa", "Mujer haciendo yoga en la orilla de la playa"],
  ["nina-cara-pintada", "Niña con la bandera de Costa Rica pintada en la cara"],
  ["rio-aereo", "Río que serpentea entre el valle y las montañas, visto desde el aire"],
  ["palmeras-atardecer", "Pareja entre siluetas de palmeras al atardecer"],
];

const items = await Promise.all(
  fotos.map(async ([nombre, alt], i) => ({ id: i + 1, ...(await variantesGaleria(foto(nombre))), alt })),
);
---

<section id="galeria-completa" class="relative w-full self-start overflow-x-clip bg-white">
  <Image
    src={palmera}
    alt=""
    width={600}
    widths={[300, 450, 600]}
    sizes={sizesPalmera}
    class={`pointer-events-none absolute right-0 top-0 ${clasesPalmera}`}
    loading="lazy"
    fetchpriority="low"
    draggable="false"
    aria-hidden="true"
  />
  <Image
    src={palmera}
    alt=""
    width={600}
    widths={[300, 450, 600]}
    sizes={sizesPalmera}
    class={`pointer-events-none absolute left-0 top-0 -scale-x-100 ${clasesPalmera}`}
    loading="lazy"
    fetchpriority="low"
    draggable="false"
    aria-hidden="true"
  />

  <div class="relative mx-auto max-w-7xl px-4 pb-24 pt-32 sm:px-6 sm:pt-44 md:pt-48 lg:pt-52 xl:pt-60 2xl:pt-72">
    <GaleriaQuepos client:visible items={items} />
  </div>
</section>
