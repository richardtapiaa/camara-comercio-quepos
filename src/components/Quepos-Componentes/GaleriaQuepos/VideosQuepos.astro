---
import { Image, getImage } from "astro:assets";
import { VideoQueposIdiomas } from "../../ReactComponentes/QUEPOS/VideosQuepos";
import CurvasTopograficas from "../../compartidos/decoracion/CurvasTopograficas.astro";
import HojaLineas from "../../compartidos/decoracion/HojaLineas.astro";
import HojasTropicales from "../../compartidos/decoracion/HojasTropicales.astro";
import OndasArena from "../../compartidos/decoracion/OndasArena.astro";
import palmera from "../../../assets/quepos/palmera-sin-fondo.webp";

import videoEs from "../../../assets/quepos/videos/video-es.mp4";
import videoEsWebm from "../../../assets/quepos/videos/video-es.webm";
import videoEn from "../../../assets/quepos/videos/video-en.mp4";
import videoEnWebm from "../../../assets/quepos/videos/video-en.webm";

import portada from "../../../assets/quepos/videos/portada-videos.webp";

const webmAv1 = 'video/webm; codecs="av01.0.08M.08, opus"';
const poster = (await getImage({ src: portada, width: 1280, format: "webp", quality: 72 })).src;

const clasesPalmera =
  "pointer-events-none absolute top-0 h-auto w-40 select-none sm:w-60 md:w-72 lg:w-80 xl:w-96 [mask-image:linear-gradient(to_bottom,transparent,black_25%)]";
const sizesPalmera = "(min-width: 1280px) 384px, (min-width: 1024px) 320px, (min-width: 768px) 288px, (min-width: 640px) 240px, 160px";
---

<section id="videos-quepos" aria-labelledby="titulo-videos" class="relative isolate overflow-hidden bg-[#faf7f2] px-4 pb-36 pt-32 sm:px-6 sm:pb-44 lg:pt-36">
  <CurvasTopograficas class="-left-56 top-10 hidden w-[46rem] text-[#b9a78a] opacity-25 md:block" anillos={9} giroInicial={20} />
  <CurvasTopograficas class="-right-64 top-1/3 hidden w-[54rem] -scale-x-100 text-[#b9a78a] opacity-25 md:block" giroInicial={60} pasoGiro={9} />

  <HojaLineas class="left-[4%] top-[42%] hidden w-32 text-[#a8967a] opacity-50 min-[1680px]:block" giro={-18} />
  <HojaLineas class="right-[5%] top-[30%] hidden w-28 text-[#a8967a] opacity-50 min-[1680px]:block" giro={24} />

  <Image src={palmera} alt="" width={600} widths={[300, 450, 600]} sizes={sizesPalmera} class={`right-0 ${clasesPalmera}`} loading="lazy" draggable="false" aria-hidden="true" />
  <Image src={palmera} alt="" width={600} widths={[300, 450, 600]} sizes={sizesPalmera} class={`left-0 -scale-x-100 ${clasesPalmera}`} loading="lazy" draggable="false" aria-hidden="true" />

  <HojasTropicales class="bottom-24 left-0 hidden w-64 lg:block xl:w-80" />
  <HojasTropicales class="bottom-24 right-0 hidden w-64 lg:block xl:w-80" espejo />

  <OndasArena class="bottom-0 h-40 sm:h-56" />

  <div class="relative mx-auto max-w-5xl">
    <h2 id="titulo-videos" class="text-balance text-center font-['Playfair_Display',Georgia,serif] text-4xl font-medium uppercase tracking-[0.04em] text-[#1e2a3b] sm:text-5xl lg:text-6xl">
      Videos de Quepos
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-center text-base text-stone-600 sm:text-lg">
      Conozca Quepos en movimiento: sus paisajes, su gente y su comercio.
    </p>

    <div class="mt-10 sm:mt-12">
      <VideoQueposIdiomas
        client:visible={{ rootMargin: "600px" }}
        fuentesEs={[{ src: videoEsWebm, type: webmAv1 }, { src: videoEs, type: "video/mp4" }]}
        fuentesEn={[{ src: videoEnWebm, type: webmAv1 }, { src: videoEn, type: "video/mp4" }]}
        poster={poster}
        size="full"
        claseMarco="w-full max-w-4xl rounded-[1.75rem] bg-white p-2 shadow-[0_30px_60px_-28px_rgba(15,40,70,0.45)] ring-1 ring-black/5 sm:p-3"
        className="aspect-video rounded-[1.25rem]"
        preload="metadata"
        playsInline
      />
    </div>
  </div>
</section>
