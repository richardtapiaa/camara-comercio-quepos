---
import { Image } from "astro:assets";
import mariposa from "../../../assets/quepos/mariposa-sin-fondo.webp";
import { MagicText } from "../../ReactComponentes/QUEPOS/ScrollReveal";
import "../../../styles/quepos/mariposa.css";
import "../../../styles/quepos/mariposa-scroll.css";

const frase =
  "“Entre flores y selva, las mariposas morfo pintan de azul el bosque tropical de Quepos.”";

const flores = [
  { x: 4, tam: "size-5 md:size-7", color: "#f472b6" },
  { x: 11, tam: "size-4 md:size-5", color: "#facc15" },
  { x: 19, tam: "size-6 md:size-8", color: "#c084fc" },
  { x: 33, tam: "size-4 md:size-6", color: "#f472b6" },
  { x: 48, tam: "size-5 md:size-7", color: "#facc15" },
  { x: 62, tam: "size-4 md:size-5", color: "#c084fc" },
  { x: 76, tam: "size-6 md:size-8", color: "#f472b6" },
  { x: 90, tam: "size-4 md:size-6", color: "#facc15" },
];
---

<section
  data-mariposa-scroll
  class="mariposa-recuadro relative isolate flex min-h-[48svh] flex-col overflow-hidden bg-[#E8F4FA] md:min-h-[70svh]"
  aria-label="Mariposa morfo volando sobre Quepos"
>
  <svg
    class="mariposa-sol pointer-events-none absolute left-6 top-24 z-0 size-14 md:left-[12%] md:top-[12%] md:size-24"
    viewBox="0 0 100 100"
    aria-hidden="true"
  >
    <path class="mariposa-sol-rayos" fill="#FBBF24" d="M50.0 13.0Q58.9 10.0 65.6 3.6Q67.8 14.2 68.5 18.0Q77.8 19.8 86.8 17.6Q83.3 27.9 82.0 31.5Q89.1 37.7 98.0 40.3Q89.9 47.5 87.0 50.0Q90.0 58.9 96.4 65.6Q85.8 67.8 82.0 68.5Q80.2 77.8 82.4 86.8Q72.1 83.3 68.5 82.0Q62.3 89.1 59.7 98.0Q52.5 89.9 50.0 87.0Q41.1 90.0 34.4 96.4Q32.2 85.8 31.5 82.0Q22.2 80.2 13.2 82.4Q16.7 72.1 18.0 68.5Q10.9 62.3 2.0 59.7Q10.1 52.5 13.0 50.0Q10.0 41.1 3.6 34.4Q14.2 32.2 18.0 31.5Q19.8 22.2 17.6 13.2Q27.9 16.7 31.5 18.0Q37.7 10.9 40.3 2.0Q47.5 10.1 50.0 13.0Z" />
    <circle cx="50" cy="50" r="27" fill="#FDE047" />
  </svg>

  {
    [
      { lugar: "right-[6%] top-[6%] w-28 md:right-[10%] md:top-[10%] md:w-48", clase: "mariposa-nube-lenta opacity-90" },
      { lugar: "left-[38%] top-[3%] w-20 md:top-[6%] md:w-32", clase: "mariposa-nube-rapida opacity-70" },
    ].map((nube) => (
      <svg class={`pointer-events-none absolute z-0 ${nube.lugar} ${nube.clase}`} viewBox="0 0 200 80" aria-hidden="true">
        <g fill="#ffffff">
          <rect x="20" y="40" width="160" height="34" rx="17" />
          <circle cx="62" cy="44" r="26" />
          <circle cx="106" cy="34" r="32" />
          <circle cx="148" cy="48" r="22" />
        </g>
      </svg>
    ))
  }

  <div class="relative z-[1] mx-auto w-full max-w-4xl px-6 pt-36 md:pt-40">
    <MagicText
      client:visible={{ rootMargin: "300px" }}
      text={frase}
      opacidadInicial={0.25}
      className="text-3xl font-black uppercase leading-[1.08] tracking-tight text-neutral-800 sm:text-4xl md:text-5xl"
    />
  </div>

  <div class="h-[34svh] shrink-0 md:h-[44svh]" aria-hidden="true"></div>

  <div class="mariposa-pasto pointer-events-none absolute inset-x-0 bottom-0 z-[1] h-14 md:h-20" aria-hidden="true">
    {
      flores.map(({ x, tam, color }) => (
        <svg class={`absolute -top-3 ${tam}`} style={{ left: `${x}%` }} viewBox="0 0 20 20">
          <g fill={color}>
            <circle cx="10" cy="4.5" r="4" />
            <circle cx="15.5" cy="10" r="4" />
            <circle cx="10" cy="15.5" r="4" />
            <circle cx="4.5" cy="10" r="4" />
          </g>
          <circle cx="10" cy="10" r="3" fill="#fde68a" />
        </svg>
      ))
    }
  </div>

  <svg data-mariposa-rastro class="pointer-events-none absolute inset-0 z-[2] size-full" aria-hidden="true">
    <defs>
      <mask id="mariposa-rastro-mascara" maskUnits="userSpaceOnUse">
        <path data-mariposa-mascara fill="none" stroke="white" stroke-width="24" stroke-linecap="round" />
      </mask>
    </defs>
    <path
      data-mariposa-camino
      fill="none"
      stroke="#2780c9"
      stroke-opacity="0.55"
      stroke-width="4"
      stroke-linecap="round"
      stroke-dasharray="0.1 14"
      mask="url(#mariposa-rastro-mascara)"
    />
  </svg>

  <div data-mariposa class="pointer-events-none absolute z-[3] w-20 md:w-32">
    <Image
      src={mariposa}
      alt="Mariposa morfo azul volando"
      width={300}
      class="mariposa-aletea block h-auto w-full select-none [clip-path:inset(0_0_14%_0)]"
      loading="lazy"
      draggable="false"
    />
  </div>
</section>

<script src="../../../scripts/quepos/mariposa.ts"></script>
