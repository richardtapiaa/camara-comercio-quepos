---
import { getImage, Image } from "astro:assets";
import CircularGallery from "../ReactComponentes/QUEPOS/CircularGallery.jsx";
import beneficios from "../../assets/imagenes/beneficios-seccion.jpg";
import mision from "../../assets/imagenes/mision-seccion.jpg";
import vision from "../../assets/imagenes/vision-seccion.jpg";
import checkout from "../../assets/imagenes/seccion-checkout.jpg";
import ejemplo from "../../assets/imagenes/seccion-ejemplo.jpg";
import hero from "../../assets/imagenes/quepos-foto.webp";
import fondo from "../../assets/imagenes/fondo-inicio-queposx.webp";
import palmera from "../../assets/imagenes-quepos/palmera-sin-fondo.webp";

// Se reutilizan imágenes existentes; reemplazar por fotos de Quepos cuando estén disponibles
const fuentes = [hero, beneficios, mision, ejemplo, vision, checkout, fondo, hero, beneficios, mision, ejemplo, vision];

const items = await Promise.all(
  fuentes.map(async (src) => ({
    image: (await getImage({ src, width: 1000, format: "webp" })).src,
  })),
);
---

<section id="galeria-quepos" class="relative overflow-x-clip bg-white py-16 sm:py-24">
  <!-- Palmeras colgando de las esquinas de arriba: la foto trae el tronco cortado arriba a la derecha, así que la de
       la derecha va tal cual y la de la izquierda en espejo; las dos salen del borde de la pantalla. Van detrás del
       título y la galería, y no bloquean el arrastre de la galería -->
  <Image
    src={palmera}
    alt=""
    width={600}
    class="pointer-events-none absolute right-0 top-0 h-auto w-40 select-none sm:w-72 md:w-[32rem]"
    loading="lazy"
    draggable="false"
    aria-hidden="true"
  />
  <Image
    src={palmera}
    alt=""
    width={600}
    class="pointer-events-none absolute left-0 top-0 h-auto w-40 -scale-x-100 select-none sm:w-72 md:w-[32rem]"
    loading="lazy"
    draggable="false"
    aria-hidden="true"
  />

  <!-- Encabezado con las mismas letras que SobreQuepos.astro -->
  <!-- Título, galería y botón van delante de las palmeras (relative z-[5]) -->
  <div class="relative z-[5] mx-auto max-w-3xl px-6 text-center">
    <h2 class="mt-3 text-4xl font-bold uppercase leading-tight tracking-tight text-neutral-700 sm:text-5xl">
      Un recorrido por Quepos
    </h2>

  </div>

  <!-- Las tarjetas se dibujan en curva y dejan aire arriba: con margen negativo quedan más cerca del título -->
  <div class="relative z-[5] -mt-6 h-[360px] w-full sm:-mt-10 sm:h-[480px] lg:h-[560px]">
    <CircularGallery client:visible items={items} showTitles={false} wheelOnClick bend={3} borderRadius={0.05} scrollSpeed={2} scrollEase={0.05} />
  </div>

  <div class="relative z-[5] mt-2 flex flex-col items-center gap-5 px-6 text-center">
    <!-- La galería se mueve arrastrando o con la rueda, y no es evidente a simple vista -->
    <p class="flex items-center gap-3 text-sm font-medium text-neutral-500">
      <span aria-hidden="true">←</span>
      Arrastra para explorar
      <span aria-hidden="true">→</span>
    </p>
    <a
      href="/queposgaleria"
      class="rounded-full bg-[#2780c9] px-8 py-3 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#1f6aa8]"
    >
      Ver galería completa
    </a>
  </div>
</section>
    