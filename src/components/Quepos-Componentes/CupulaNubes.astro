---
import { ArrowRight } from "lucide-react";
import Nubes from "./Nubes.astro";
import { lapaImagen } from "./lapa-imagen";
import "../../styles/quepos/lapa-scroll.css";
import "../../styles/quepos/lapas.css";
import "../../styles/compartido/etiqueta-papel.css";
---

<div
  data-lapa-scroll
  class="lapas-recuadro relative isolate min-h-[max(60svh,28rem)] overflow-hidden rounded-b-[11rem] bg-gradient-to-b from-[#4aa8e3] to-[#b4e1f8] md:min-h-[max(70svh,32rem)] md:rounded-b-[38rem]"
>
  <Nubes />

  <a
    href="/queposgaleria"
    class="lapa-galeria group absolute left-1/2 top-[56%] z-[5] -translate-x-1/2 -translate-y-1/2 outline-hidden"
  >
    <span class="vuelo flex flex-col items-center">
      <span class="flotar flex flex-col items-center">
        <img
          src={lapaImagen.src}
          srcset={lapaImagen.srcset}
          sizes={lapaImagen.sizes}
          width={lapaImagen.width}
          height={lapaImagen.height}
          alt=""
          loading="lazy"
          decoding="async"
          draggable="false"
          class="lapa relative z-[1] max-w-none translate-x-[3%] -scale-x-100 select-none"
        />
        <span class="colgante flex flex-col items-center">
          <span class="tira relative block">
            <span class="tira-papel etiqueta-papel absolute left-1/2 top-1/2 block -translate-x-1/2 -translate-y-1/2 rotate-90"></span>
          </span>
          <span
            class="letrero relative -mt-1.5 flex items-center gap-2 rounded-md px-5 py-2.5 group-focus-visible:outline-3 group-focus-visible:outline-offset-4 group-focus-visible:outline-[#0b2f4f] motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:-translate-y-0.5 motion-safe:group-hover:-rotate-2 md:gap-3 md:px-7 md:py-3.5"
          >
            <span class="etiqueta-papel absolute inset-0"></span>
            <span class="etiqueta-cinta cinta-letrero"></span>
            <span class="relative whitespace-nowrap text-lg font-black uppercase tracking-[0.12em] text-[#2f1d0e] md:text-2xl">
              Ver galería
            </span>
            <ArrowRight
              className="relative size-5 shrink-0 text-[#2f1d0e] motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:translate-x-1 md:size-6"
              strokeWidth={2.75}
              aria-hidden="true"
            />
          </span>
        </span>
      </span>
    </span>
  </a>
</div>

<script src="../../scripts/quepos/lapa-scroll.ts"></script>

<style>
  .lapa-galeria {
    --ancho-lapa: min(40vw, 358px);
    --grosor-tira: 1.75rem;
    --largo-tira: calc(var(--ancho-lapa) * 0.36 + 0.75rem);
  }
  @media (min-width: 768px) {
    .lapa-galeria {
      --ancho-lapa: min(21vw, 314px);
      --grosor-tira: 2.25rem;
    }
  }

  .lapa {
    width: var(--ancho-lapa);
  }

  .tira {
    width: var(--grosor-tira);
    height: var(--largo-tira);
    margin-top: calc(var(--ancho-lapa) * -0.141);
  }
  .tira-papel {
    width: var(--largo-tira);
    height: var(--grosor-tira);
  }

  .cinta-letrero {
    top: 0;
    left: 50%;
    width: calc(var(--grosor-tira) + 1.25rem);
    height: 1.4rem;
    translate: -50% -55%;
    rotate: -5deg;
  }

  .lapa-galeria .letrero :global(svg) {
    filter: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .flotar {
      animation: lapa-galeria-flotar 2.8s ease-in-out infinite alternate;
    }
    .colgante {
      transform-origin: 50% 0;
      animation: lapa-galeria-mecer 3.6s ease-in-out infinite alternate;
    }
    [data-lapa-scroll]:not([data-a-la-vista]) .flotar,
    [data-lapa-scroll]:not([data-a-la-vista]) .colgante,
    .lapa-galeria:hover .flotar,
    .lapa-galeria:hover .colgante,
    .lapa-galeria:focus-visible .flotar,
    .lapa-galeria:focus-visible .colgante {
      animation-play-state: paused;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .vuelo {
        animation-name: lapa-galeria-llegar;
        animation-timing-function: ease-out;
        animation-fill-mode: both;
        animation-timeline: --lapa-vuelo;
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes lapa-galeria-llegar {
    from {
      translate: 62cqw -9rem;
      rotate: -14deg;
    }
    to {
      translate: 0 0;
      rotate: 0deg;
    }
  }
  @keyframes lapa-galeria-flotar {
    to {
      translate: 0 -8px;
    }
  }
  @keyframes lapa-galeria-mecer {
    from {
      rotate: -2deg;
    }
    to {
      rotate: 2deg;
    }
  }
</style>
