---
import furgoneta from "../../assets/hospitalidad/furgoneta.webp";
import { MagicText } from "../ReactComponentes/QUEPOS/ScrollReveal";
import "../../styles/hospitalidad/buseta-scroll-animacion.css";
import "../../styles/compartido/cielo-sol.css";
import "../../styles/hospitalidad/buseta-scroll.css";

const frase =
  "“Cada viaje a Quepos termina con una sonrisa: aquí cada visitante llega como turista y se va como amigo.”";

const edificios = [
  { x: 0, ancho: 110, alto: 170, color: "#9CC3DC" },
  { x: 96, ancho: 128, alto: 290, color: "#6FA6CB" },
  { x: 212, ancho: 118, alto: 220, color: "#A9CBE0" },
  { x: 318, ancho: 150, alto: 340, color: "#2780C9" },
  { x: 456, ancho: 144, alto: 200, color: "#7FB0CF" },
].map((edificio) => {
  const ventanas = [];
  const columnas = Math.floor((edificio.ancho - 24) / 28);
  const filas = Math.floor((edificio.alto - 40) / 34);
  const margen = (edificio.ancho - columnas * 28 + 10) / 2;
  for (let fila = 0; fila < filas; fila++) {
    for (let col = 0; col < columnas; col++) {
      ventanas.push({ x: edificio.x + margen + col * 28, y: 360 - edificio.alto + 22 + fila * 34 });
    }
  }
  return { ...edificio, ventanas };
});
---

<section
  data-buseta-scroll
  class="buseta-recuadro relative isolate flex min-h-[60svh] flex-col overflow-hidden bg-[#E8F4FA] md:min-h-[75svh]"
  aria-label="Furgoneta llegando a la ciudad"
>
  <svg
    class="cielo-sol pointer-events-none absolute left-[10%] top-[10%] size-14 md:left-[14%] md:size-24"
    viewBox="0 0 100 100"
    aria-hidden="true"
  >
    <path class="cielo-sol-rayos" fill="#FBBF24" d="M50.0 13.0Q58.9 10.0 65.6 3.6Q67.8 14.2 68.5 18.0Q77.8 19.8 86.8 17.6Q83.3 27.9 82.0 31.5Q89.1 37.7 98.0 40.3Q89.9 47.5 87.0 50.0Q90.0 58.9 96.4 65.6Q85.8 67.8 82.0 68.5Q80.2 77.8 82.4 86.8Q72.1 83.3 68.5 82.0Q62.3 89.1 59.7 98.0Q52.5 89.9 50.0 87.0Q41.1 90.0 34.4 96.4Q32.2 85.8 31.5 82.0Q22.2 80.2 13.2 82.4Q16.7 72.1 18.0 68.5Q10.9 62.3 2.0 59.7Q10.1 52.5 13.0 50.0Q10.0 41.1 3.6 34.4Q14.2 32.2 18.0 31.5Q19.8 22.2 17.6 13.2Q27.9 16.7 31.5 18.0Q37.7 10.9 40.3 2.0Q47.5 10.1 50.0 13.0Z" />
    <circle cx="50" cy="50" r="27" fill="#FDE047" />
  </svg>

  <div class="relative z-[1] mx-auto w-full max-w-4xl px-6 pt-24 md:pt-28">
    <MagicText
      client:visible={{ rootMargin: "300px" }}
      text={frase}
      opacidadInicial={0.25}
      className="text-3xl font-black uppercase leading-[1.08] tracking-tight text-neutral-800 sm:text-4xl md:text-5xl"
    />
  </div>

  <div class="h-[38svh] shrink-0 md:h-[48svh]" aria-hidden="true"></div>

  <svg
    class="buseta-edificios pointer-events-none absolute right-0 w-[55%] max-w-3xl md:w-[42%]"
    viewBox="0 0 600 360"
    preserveAspectRatio="xMaxYMax meet"
    aria-hidden="true"
  >
    {
      edificios.map(({ x, ancho, alto, color, ventanas }) => (
        <g>
          <rect x={x} y={360 - alto} width={ancho} height={alto} rx="6" fill={color} />
          {ventanas.map((v) => (
            <rect x={v.x} y={v.y} width="14" height="18" rx="2" fill="#F5FAFD" fill-opacity="0.75" />
          ))}
        </g>
      ))
    }
  </svg>

  <div class="buseta-pasto buseta-pasto-arriba pointer-events-none absolute inset-x-0" aria-hidden="true"></div>
  <div class="buseta-calle pointer-events-none absolute inset-x-0" aria-hidden="true"></div>
  <div class="buseta-pasto buseta-pasto-abajo pointer-events-none absolute inset-x-0 bottom-0" aria-hidden="true"></div>

  <div data-buseta class="buseta-auto absolute z-10 w-[38%] max-w-xs md:w-[18%]">
    <img
      src={furgoneta.src}
      width={furgoneta.width}
      height={furgoneta.height}
      alt="Furgoneta de transporte llegando a la ciudad"
      class="buseta-rebote block w-full"
      loading="lazy"
      decoding="async"
      draggable="false"
    />
  </div>
</section>

<script src="../../scripts/hospitalidad/buseta-scroll-animacion.ts"></script>
