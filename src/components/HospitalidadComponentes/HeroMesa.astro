---
import { variantesCapa } from "../../lib/imagenes";
import foto from "../../assets/hospitalidad/temporal-piscina-santa-teresa.jpg";
import "../../styles/compartido/etiqueta-papel.css";
import "../../styles/hospitalidad/hero-mesa.css";

const anchos = [800, 1280, 1600, 2048];
const fotoWebp = await variantesCapa(foto, anchos, 75);
const fotoAvif = await variantesCapa(foto, anchos, 55, "avif");
const proporcion = (foto.width / foto.height).toFixed(4);
const sizes = `(min-width: 768px) max(50vw, calc(100vh * ${proporcion})), max(100vw, calc(45vh * ${proporcion}))`;
---

<section class="grid w-full md:h-svh md:min-h-[560px] md:grid-cols-2" aria-label="Hospitalidad y Gastronomía">
  <div class="hero-mesa relative isolate h-[75svh] min-h-[520px] overflow-hidden bg-[#14233a] md:h-full md:min-h-0">
    <div class="hero-mesa-pared pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="hero-mesa-rotulo absolute left-[7%] top-[43%] z-10 w-fit max-w-[86%]">
      <div class="etiqueta-papel px-[0.9em] pb-[0.3em] pt-[0.35em]">
        <p class="hero-mesa-kicker">Quepos · Costa Rica</p>
        <h1 class="hero-mesa-titulo">
          Hospitalidad <span class="hero-mesa-amp">&amp;</span><br />Gastronomía
        </h1>
      </div>
      <span class="etiqueta-cinta -left-[0.3em] -rotate-[4deg]" aria-hidden="true"></span>
      <span class="etiqueta-cinta -right-[0.3em] rotate-[5deg]" aria-hidden="true"></span>
    </div>

  </div>

  <div class="relative isolate order-first h-[45svh] min-h-[300px] overflow-hidden md:order-none md:h-full md:min-h-0">
    <picture>
      <source type="image/avif" srcset={fotoAvif.srcSet} sizes={sizes} />
      <img
        src={fotoWebp.src}
        srcset={fotoWebp.srcSet}
        sizes={sizes}
        alt="Piscina infinita frente al mar del Pacífico al atardecer, en Costa Rica"
        class="hero-mesa-foto absolute inset-0 -z-20 size-full object-cover"
        fetchpriority="high"
        draggable="false"
      />
    </picture>
    <div class="hero-mesa-luz pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <a
      href="https://commons.wikimedia.org/wiki/File:Infinity_View_Playa_Santa_Teresa_-_panoramio.jpg"
      class="absolute bottom-1.5 right-2 z-10 text-[10px] text-white/70 underline-offset-2 hover:text-white hover:underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      Foto: Vixitaly, CC BY 3.0
    </a>
  </div>
</section>
