---
import ImagenesHoteles from "../ReactComponentes/HospitalidadComponentes/ImagenesHoteles";
import piscinaCafe from "../../assets/hospitalidad/piscina-cafe-manuel-antonio.webp";
import hotelRancho from "../../assets/hospitalidad/hotel-rancho-piscina.webp";
import sillaColgante from "../../assets/hospitalidad/silla-colgante-vista-mar.webp";
import piscinaAtardecer from "../../assets/hospitalidad/piscina-infinita-atardecer.webp";
import columpioPlaya from "../../assets/hospitalidad/columpio-playa.webp";
import marinaPezVela from "../../assets/hospitalidad/marina-pez-vela-aerea.webp";
import { variantesGaleria } from "../../lib/imagenes";

const fotos = [
  {
    id: "piscina-cafe",
    imagen: piscinaCafe,
    alt: "Café junto a una piscina infinita con vista al bosque y al mar",
  },
  {
    id: "rancho-piscina",
    imagen: hotelRancho,
    alt: "Hotel con rancho de paja y piscina entre la selva, frente al mar",
  },
  {
    id: "silla-colgante",
    imagen: sillaColgante,
    alt: "Silla colgante en una terraza con vista al Pacífico",
  },
  {
    id: "piscina-atardecer",
    imagen: piscinaAtardecer,
    alt: "Piscina infinita al atardecer, con una isla al fondo",
  },
  { id: "columpio", imagen: columpioPlaya, alt: "Columpio de madera en la playa, frente a las olas" },
  { id: "marina", imagen: marinaPezVela, alt: "Vista aérea de Marina Pez Vela con sus muelles y yates" },
];

const imagenes = await Promise.all(
  fotos.map(async ({ id, imagen, alt }) => {
    const { src, miniatura, srcSet } = await variantesGaleria(imagen);
    return { id, alt, src, miniatura, srcSet };
  }),
);
---

<section id="galeria-hospitalidad" class="bg-white pb-16 sm:pb-20">
  <ImagenesHoteles client:visible titulo="Galería de Hospitalidad" imagenes={imagenes} />
</section>
