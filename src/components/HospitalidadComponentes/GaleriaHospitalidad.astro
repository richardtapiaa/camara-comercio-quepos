---
import ImagenesHoteles from "../ReactComponentes/HospitalidadComponentes/ImagenesHoteles";
import hotelHabitacion from "../../assets/hospitalidad/hospitalidad-1.webp";
import hotelPiscina from "../../assets/hospitalidad/hotel-piscina.jpg";
import hotelVillaTeca from "../../assets/hospitalidad/hotel-villa-teca.jpg";
import mercadoMunicipal from "../../assets/gastronomia/mercado-municipal.jpg";
import centroComercio from "../../assets/hospitalidad/centro-comercio.jpg";
import maleconLetras from "../../assets/hospitalidad/malecon-letras.jpg";
import { variantesGaleria } from "../../lib/imagenes";
import "../../styles/hospitalidad/galeria-hospitalidad.css";

const fotos = [
  { id: "habitacion", imagen: hotelHabitacion, alt: "Habitación de hotel en Quepos" },
  { id: "piscina", imagen: hotelPiscina, alt: "Piscina infinita del hotel Makanda by the Sea, Manuel Antonio" },
  { id: "villa-teca", imagen: hotelVillaTeca, alt: "Hotel Villa Teca rodeado de jardines en Manuel Antonio" },
  { id: "mercado", imagen: mercadoMunicipal, alt: "Mercado municipal de Quepos" },
  { id: "centro", imagen: centroComercio, alt: "Comercios en el centro de Quepos" },
  { id: "malecon", imagen: maleconLetras, alt: "Letras de Quepos en el malecón" },
];

const imagenes = await Promise.all(
  fotos.map(async ({ id, imagen, alt }) => {
    const { src, miniatura, srcSet } = await variantesGaleria(imagen);
    return { id, alt, src, miniatura, srcSet };
  }),
);

---

<section id="galeria-hospitalidad" class="hospitalidad-galeria">
  <div class="hospitalidad-galeria-contenido">
    <h2 class="hospitalidad-galeria-titulo">Experiencias populares</h2>
    <div class="hospitalidad-galeria-carrusel">
      <ImagenesHoteles client:visible imagenes={imagenes} enMostrador />
    </div>
  </div>
</section>
