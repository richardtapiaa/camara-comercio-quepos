---
import { Image } from "astro:assets";
import { Bus, HeartPulse, Landmark, Store } from "lucide-react";
import imagen from "../../assets/imagenes/seccion-checkout.jpg";
import MisionScripts from "../Scripts/home/MisionScripts.astro";

// Servicios que menciona el texto, en tarjetas dentro del panel. Los íconos de Lucide se dibujan en el servidor
// como SVG (sin client:), así que no suman JavaScript
const servicios = [
  { titulo: "Salud", detalle: "Hospitales y centros médicos.", Icono: HeartPulse },
  { titulo: "Banca", detalle: "Instituciones bancarias.", Icono: Landmark },
  { titulo: "Transporte", detalle: "Servicio público y privado.", Icono: Bus },
  { titulo: "Comercio", detalle: "Establecimientos que brindan comodidad durante la visita.", Icono: Store },
];
---

<!-- Mismo diseño que SobreQuepos.astro: imagen con parallax a la izquierda montada sobre el panel celeste -->
<section id="info-hospitalidad" class="overflow-x-clip bg-white py-16 sm:py-24">
  <div class="mx-auto grid max-w-6xl px-6 md:grid-cols-12">
    <!-- Sale del contenedor hasta el borde izquierdo de la pantalla y se monta sobre el panel -->
    <div class="relative z-10 -ml-[calc(max(0px,(100vw_-_72rem)/2)+1.5rem)] mb-8 aspect-[4/3] overflow-hidden md:col-span-4 md:col-start-1 md:row-start-1 md:mt-24 md:self-start md:aspect-[8/7]">
      <Image
        src={imagen}
        alt="Costa de Quepos"
        widths={[640, 960, 1280]}
        sizes="(min-width: 768px) 45vw, 100vw"
        quality={75}
        class="absolute inset-x-0 -top-full h-[200%] w-full max-w-none object-cover will-change-transform"
        data-parallax-img
      />
    </div>

    <!-- Panel que sale del contenedor hasta el borde derecho de la pantalla -->
    <div
      class="-mr-[calc(max(0px,(100vw_-_72rem)/2)+1.5rem)] bg-[#E8F4FA] py-12 pl-6 pr-[calc(max(0px,(100vw_-_72rem)/2)+3rem)] md:col-span-9 md:col-start-4 md:row-start-1 md:py-16 md:pl-[calc(100%/9+2rem)]"
    >
      <h2 class="text-4xl font-bold uppercase leading-tight tracking-tight text-neutral-700 sm:text-5xl">
        Hospitalidad
      </h2>

      <p class="mt-6 max-w-xl text-lg font-medium leading-relaxed text-neutral-800 sm:text-xl">
        Quepos cuenta con una variedad de servicios públicos y privados que facilitan la estadía de sus visitantes.
      </p>

      <p class="mt-8 max-w-2xl text-sm leading-relaxed text-neutral-700">
        Entre ellos se encuentran los servicios de salud, como hospitales y centros médicos, instituciones bancarias,
        transporte público y privado, así como otros establecimientos comerciales que contribuyen a brindar comodidad
        durante la visita al destino.
      </p>

      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          servicios.map(({ titulo, detalle, Icono }) => (
            <li class="flex items-start gap-4 rounded-2xl bg-white/70 px-4 py-3">
              <span class="mt-0.5 flex size-10 shrink-0 items-center justify-center rounded-full bg-[#E8F4FA] text-neutral-700">
                <Icono className="size-5" strokeWidth={2} aria-hidden="true" />
              </span>
              <div>
                <p class="text-sm font-bold uppercase tracking-wide text-neutral-800">{titulo}</p>
                <p class="mt-1 text-sm leading-relaxed text-neutral-700">{detalle}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<MisionScripts />
