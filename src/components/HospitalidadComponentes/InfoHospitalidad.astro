---
import { Image } from "astro:assets";
import { Bus, CarTaxiFront, Hospital, Landmark, Plane, Stethoscope, Store } from "lucide-react";
import imagen from "../../assets/quepos/mision-seccion.jpg";

// Tarjetas con íconos, como pasos numerados
const servicios = [
  {
    etiqueta: "Salud",
    fondo: "bg-[#f1f2f6]",
    iconos: [Hospital, Stethoscope],
    texto: ["Hospitales y ", "centros médicos", " para cualquier emergencia."],
  },
  {
    etiqueta: "Comercio",
    fondo: "bg-[#f6dd9a]",
    iconos: [Landmark, Store],
    texto: ["", "Bancos", " y tiendas"],
  },
  {
    etiqueta: "Transporte",
    fondo: "bg-[#a3dde5]",
    iconos: [Bus, CarTaxiFront, Plane],
    texto: ["Transporte ", "público y privado", " para moverse por el cantón."],
  },
];
---

<!-- Mismas medidas que un container + row g-4 + col-lg-6 de Bootstrap: 540/720/960/1140/1320 px, 12 px de
     margen y 24 px entre columnas -->
<section id="info-hospitalidad" class="bg-white py-16 sm:py-20">
  <div
    class="mx-auto w-full px-3 sm:max-md:max-w-[540px] md:max-lg:max-w-[720px] lg:max-xl:max-w-[960px] xl:max-[1399px]:max-w-[1140px] min-[1400px]:max-w-[1320px]"
  >
    <h2 class="text-[1.75rem] font-bold leading-tight text-neutral-900">La hospitalidad de Quepos</h2>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <ol class="flex min-w-0 flex-col gap-5">
        {
          servicios.map(({ etiqueta, fondo, iconos, texto: [antes, resaltado, despues] }, i) => {
            const paso = (
              <span class="flex shrink-0 items-center gap-3 text-lg text-neutral-800 sm:text-xl">
                {etiqueta}
                <span class="flex size-11 items-center justify-center rounded-full bg-black/[0.07]">{i + 1}</span>
              </span>
            );
            return (
              <li class:list={["rounded-[40px] p-7 sm:p-9", fondo]}>
                <div class="flex justify-end">{paso}</div>
                <div class="mt-2 flex gap-5 text-neutral-900">
                  {iconos.map((Icono) => (
                    <Icono className="size-11 sm:size-12" strokeWidth={1.5} aria-hidden="true" />
                  ))}
                </div>
                <p class="mt-4 text-[clamp(1.45rem,2.2vw,2.25rem)] leading-tight text-neutral-800">
                  {antes}
                  <strong class="font-semibold text-neutral-900">{resaltado}</strong>
                  {despues}
                </p>
              </li>
            );
          })
        }
      </ol>

      <div class="relative min-h-[420px] overflow-hidden rounded-[40px] sm:min-h-[520px] lg:min-h-0">
        <Image
          src={imagen}
          alt="Vista aérea de Quepos con Marina Pez Vela y la costa"
          widths={[480, 720, 960, 1280, 1600]}
          sizes="(min-width: 1400px) 648px, (min-width: 1024px) 50vw, 100vw"
          quality={78}
          class="absolute inset-0 size-full object-cover"
          loading="lazy"
        />
        <span
          class="absolute bottom-5 right-5 rounded-full border-2 border-white/60 bg-[#0d3b3a]/45 px-5 py-2.5 text-base font-semibold text-white backdrop-blur-md sm:text-lg"
        >
          Quepos - Costa Rica
        </span>
      </div>
    </div>
  </div>
</section>
