---
import { Image } from "astro:assets";
import { Bus, HeartPulse, Landmark, Store } from "lucide-react";
import imagen from "../../assets/hospitalidad/hospitalidad-1.webp";
import "../../styles/hospitalidad/info-hospitalidad.css";

const servicios = [
  { titulo: "Salud", detalle: "Hospitales y centros médicos.", Icono: HeartPulse },
  { titulo: "Banca", detalle: "Instituciones bancarias.", Icono: Landmark },
  { titulo: "Transporte", detalle: "Servicio público y privado.", Icono: Bus },
  { titulo: "Comercio", detalle: "Establecimientos que brindan comodidad durante la visita.", Icono: Store },
];
---

<section id="info-hospitalidad" class="bg-[#f9f7f3] lg:grid lg:min-h-[640px] lg:grid-cols-2">
  <div class="flex items-center justify-center px-6 pt-14 sm:px-10 lg:px-12 lg:py-16 xl:px-20">
    <div class="puerta relative w-full max-w-[34rem]">
      <div class="puerta-marco rounded-t-[999px] p-[4%] pb-0">
        <div class="puerta-vano relative aspect-[4/5] overflow-hidden rounded-t-[999px]">
          <Image
            src={imagen}
            alt="Habitación de hotel en Quepos"
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 1024px) 34rem, 90vw"
            quality={78}
            class="absolute inset-0 size-full object-cover object-[62%_center]"
            loading="lazy"
          />
        </div>
      </div>
      <div class="puerta-umbral -mx-[3%] h-3 rounded-sm sm:h-4"></div>
    </div>
  </div>

  <div class="flex items-center px-6 py-14 sm:px-10 lg:px-16 lg:py-20 xl:px-24">
    <div class="max-w-xl">
      <h2 class="info-hosp-titulo text-[clamp(2.1rem,4.2vw,3.25rem)] leading-[1.1] text-[#a6844f]">
        La hospitalidad de Quepos
      </h2>
      <p class="mt-5 text-lg font-bold text-neutral-900 sm:text-xl">
        Quepos cuenta con una variedad de servicios públicos y privados que facilitan la estadía de sus visitantes.
      </p>
      <p class="mt-5 text-[15px] leading-relaxed text-neutral-700">
        Entre ellos se encuentran los servicios de salud, como hospitales y centros médicos, instituciones bancarias,
        transporte público y privado, así como otros establecimientos comerciales que contribuyen a brindar comodidad
        durante la visita al destino.
      </p>

      <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {
          servicios.map(({ titulo, detalle, Icono }) => (
            <li class="flex items-start gap-3">
              <Icono className="mt-0.5 size-5 shrink-0 text-[#a6844f]" strokeWidth={1.75} aria-hidden="true" />
              <div>
                <p class="text-sm font-bold text-neutral-900">{titulo}</p>
                <p class="text-sm leading-snug text-neutral-600">{detalle}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
