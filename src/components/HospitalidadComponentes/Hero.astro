---
import { Picture } from "astro:assets";
import foto from "../../assets/hospitalidad/vista-hotel-manuel-antonio.jpg";
import BordePincelada from "../compartidos/BordePincelada.astro";
import "../../styles/compartido/etiqueta-papel.css";
import "../../styles/compartido/hero-texto.css";
---

<!-- id="hero": el navbar se ve transparente mientras está sobre esta sección -->
<section id="hero" class="relative isolate flex h-[78svh] min-h-[520px] items-end overflow-hidden bg-[#2b4a5c]">
  <!-- AVIF (pesa ~40 % menos que WebP con la misma calidad) y WebP para los navegadores que no lo leen -->
  <Picture
    src={foto}
    formats={["avif", "webp"]}
    alt="Vista al mar y a las islas de Manuel Antonio desde la terraza de un hotel, entre árboles"
    widths={[800, 1280, 1920, 2560]}
    sizes="100vw"
    quality={50}
    class="absolute inset-0 -z-20 size-full object-cover"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/55 via-black/10 to-black/30" aria-hidden="true"></div>

  <div class="hero-texto mx-auto w-full max-w-[1320px] px-6 pb-[clamp(5rem,12vh,8rem)] text-white sm:px-10">
    <p class="hero-texto-kicker">Quepos · Costa Rica</p>
    <h1 class="hero-texto-titulo">
      Hospitalidad <span class="hero-texto-amp">&amp;</span><br />Gastronomía
    </h1> 
  </div>

  <BordePincelada />
</section>
