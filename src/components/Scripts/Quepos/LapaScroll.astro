<style is:global>
  /* Quieta (sin animación o con "reducir movimiento"): centrada en el recuadro */
  [data-lapa] {
    left: 50%;
    translate: -50% 0;
  }

  /* Vuelo con scroll-driven animations: lo mueve el navegador junto con el scroll, sin esperar a JS (mismo
     enfoque que MisionScripts.astro). Sin soporte (Firefox, Safari < 26) se usa GSAP abajo */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-lapa-scroll] {
        view-timeline-name: --lapa-vuelo;
        /* 100cqw = ancho del recuadro, para que la lapa lo cruce entero */
        container-type: inline-size;
      }
      [data-lapa] {
        left: 0;
        animation-name: lapa-vuelo;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --lapa-vuelo;
        /* Todo el tiempo que el recuadro está en pantalla, para que el vuelo sea pausado */
        animation-range: cover 0% cover 100%;
      }
      /* Las nubes se cierran hacia el centro y bajan mientras dura el recuadro en pantalla. Va en el <g> de cada
         capa (el <path> de adentro se mece solo) y no en el svg, porque la nube de la derecha está en espejo: así
         "hacia el centro" es +x en las dos */
      .nube-capa,
      .selva-capa {
        animation-name: nube-scroll;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --lapa-vuelo;
        animation-range: cover 0% cover 100%;
      }
    }
  }

  /* Cada capa recorre distinto: la de adelante más y la de atrás menos, así se nota la profundidad */
  .nube-capa-frente {
    --nube-x: 90px;
    --nube-y: 26px;
  }
  .nube-capa-medio {
    --nube-x: 55px;
    --nube-y: 16px;
  }
  .nube-capa-atras {
    --nube-x: 25px;
    --nube-y: 8px;
  }
  /* La selva solo se corre de lado: la de adelante más que la de atrás */
  .selva-capa-frente {
    --nube-x: 120px;
    --nube-y: 0px;
  }
  .selva-capa-atras {
    --nube-x: 50px;
    --nube-y: 0px;
  }
  .selva-capa-arboles {
    --nube-x: 80px;
    --nube-y: 0px;
  }

  @keyframes nube-scroll {
    from {
      translate: calc(var(--nube-x) * -0.5) calc(var(--nube-y) * -1);
    }
    to {
      translate: calc(var(--nube-x) * 0.5) var(--nube-y);
    }
  }

  /* Sale de entre los árboles por la izquierda y se va por la derecha subiendo y bajando en dos ondas, mientras
     igual va ganando altura (de 40 % a -90 % de su alto). Se inclina según el tramo: el pico hacia arriba cuando
     sube y hacia abajo cuando baja. Los puntos salen de y = 40 - 130·t - 35·sen(4π·t) (en % del alto de la lapa),
     con 17 puntos para que la curva se vea suave; GSAP (abajo) usa los mismos */
  @keyframes lapa-vuelo {
    0% {
      translate: -100% 40%;
      rotate: -14.2deg;
    }
    6.25% {
      translate: calc(-100% + (100cqw + 100%) * 0.0625) 7.1%;
      rotate: -11deg;
    }
    12.5% {
      translate: calc(-100% + (100cqw + 100%) * 0.125) -11.2%;
      rotate: -3.3deg;
    }
    18.75% {
      translate: calc(-100% + (100cqw + 100%) * 0.1875) -9.1%;
      rotate: 4.5deg;
    }
    25% {
      translate: calc(-100% + (100cqw + 100%) * 0.25) 7.5%;
      rotate: 7.7deg;
    }
    31.25% {
      translate: calc(-100% + (100cqw + 100%) * 0.3125) 24.1%;
      rotate: 4.5deg;
    }
    37.5% {
      translate: calc(-100% + (100cqw + 100%) * 0.375) 26.2%;
      rotate: -3.2deg;
    }
    43.75% {
      translate: calc(-100% + (100cqw + 100%) * 0.4375) 7.9%;
      rotate: -11deg;
    }
    50% {
      translate: calc(-100% + (100cqw + 100%) * 0.5) -25%;
      rotate: -14.2deg;
    }
    56.25% {
      translate: calc(-100% + (100cqw + 100%) * 0.5625) -57.9%;
      rotate: -11deg;
    }
    62.5% {
      translate: calc(-100% + (100cqw + 100%) * 0.625) -76.2%;
      rotate: -3.3deg;
    }
    68.75% {
      translate: calc(-100% + (100cqw + 100%) * 0.6875) -74.1%;
      rotate: 4.5deg;
    }
    75% {
      translate: calc(-100% + (100cqw + 100%) * 0.75) -57.5%;
      rotate: 7.7deg;
    }
    81.25% {
      translate: calc(-100% + (100cqw + 100%) * 0.8125) -40.9%;
      rotate: 4.5deg;
    }
    87.5% {
      translate: calc(-100% + (100cqw + 100%) * 0.875) -38.8%;
      rotate: -3.2deg;
    }
    93.75% {
      translate: calc(-100% + (100cqw + 100%) * 0.9375) -57.1%;
      rotate: -11deg;
    }
    100% {
      translate: 100cqw -90%;
      rotate: -14.2deg;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const conCss = CSS.supports("animation-timeline: view()");
  const sinMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!conCss && !sinMovimiento) {
    document.querySelectorAll<HTMLElement>("[data-lapa-scroll]").forEach((recuadro) => {
      const lapa = recuadro.querySelector<HTMLElement>("[data-lapa]");
      if (!lapa) return;

      // GSAP mueve con transform; se quita el centrado (translate) para que no se sumen
      lapa.style.left = "0";
      lapa.style.translate = "none";

      // Mismo recorrido que el keyframe de CSS (misma fórmula y mismos 17 puntos), con el ancho del recuadro en px
      const PUNTOS = 16;
      const punto = (i: number) => {
        const t = i / PUNTOS;
        const pendiente = -130 - 35 * 4 * Math.PI * Math.cos(4 * Math.PI * t);
        return {
          x: () => recuadro.offsetWidth * t,
          xPercent: -100 + 100 * t,
          yPercent: 40 - 130 * t - 35 * Math.sin(4 * Math.PI * t),
          rotate: Math.max(-16, Math.min(16, pendiente / 40)),
        };
      };
      const vuelo = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: {
          trigger: recuadro,
          start: "top bottom",
          end: "bottom top",
          scrub: true,
          invalidateOnRefresh: true,
        },
      });
      gsap.set(lapa, punto(0));
      for (let i = 1; i <= PUNTOS; i++) vuelo.to(lapa, { ...punto(i), duration: 1 });

      // Nubes y selva: mismo recorrido que el keyframe nube-scroll, con las distancias de cada capa
      recuadro.querySelectorAll<Element>(".nube-capa, .selva-capa").forEach((capa) => {
        const estilo = getComputedStyle(capa);
        const dx = parseFloat(estilo.getPropertyValue("--nube-x"));
        const dy = parseFloat(estilo.getPropertyValue("--nube-y"));
        gsap.fromTo(
          capa,
          { x: dx * -0.5, y: -dy },
          {
            x: dx * 0.5,
            y: dy,
            ease: "none",
            scrollTrigger: { trigger: recuadro, start: "top bottom", end: "bottom top", scrub: true },
          }
        );
      });
    });
  }
</script>
