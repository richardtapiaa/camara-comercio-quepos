<style is:global>
  /* Quieta (sin animación o con "reducir movimiento"): centrada en el recuadro */
  [data-lapa] {
    left: 50%;
    translate: -50% 0;
  }

  /* Vuelo con scroll-driven animations: lo mueve el navegador junto con el scroll, sin esperar a JS (mismo
     enfoque que MisionScripts.astro). Sin soporte (Firefox, Safari < 26) se usa GSAP abajo */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-lapa-scroll] {
        view-timeline-name: --lapa-vuelo;
        /* 100cqw = ancho del recuadro, para que la lapa lo cruce entero */
        container-type: inline-size;
      }
      [data-lapa] {
        left: 0;
        animation-name: lapa-vuelo;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --lapa-vuelo;
        /* Todo el tiempo que el recuadro está en pantalla, para que el vuelo sea pausado */
        animation-range: cover 0% cover 100%;
      }
      /* Las nubes se cierran hacia el centro y bajan mientras dura el recuadro en pantalla. Va en el <g> de cada
         capa (el <path> de adentro se mece solo) y no en el svg, porque la nube de la derecha está en espejo: así
         "hacia el centro" es +x en las dos */
      .nube-capa,
      .selva-capa {
        animation-name: nube-scroll;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --lapa-vuelo;
        animation-range: cover 0% cover 100%;
      }
    }
  }

  /* Cada capa recorre distinto: la de adelante más y la de atrás menos, así se nota la profundidad */
  .nube-capa-frente {
    --nube-x: 90px;
    --nube-y: 26px;
  }
  .nube-capa-medio {
    --nube-x: 55px;
    --nube-y: 16px;
  }
  .nube-capa-atras {
    --nube-x: 25px;
    --nube-y: 8px;
  }
  /* La selva solo se corre de lado: la de adelante más que la de atrás */
  .selva-capa-frente {
    --nube-x: 120px;
    --nube-y: 0px;
  }
  .selva-capa-atras {
    --nube-x: 50px;
    --nube-y: 0px;
  }

  @keyframes nube-scroll {
    from {
      translate: calc(var(--nube-x) * -0.5) calc(var(--nube-y) * -1);
    }
    to {
      translate: calc(var(--nube-x) * 0.5) var(--nube-y);
    }
  }

  /* Cruza de izquierda a derecha subiendo hasta las nubes y bajando hasta el pasto: arranca a ras del pasto, sube
     a las nubes, baja al pasto y vuelve a subir para salir por las nubes. La altura sigue h = ½ − ½·cos(3π·t)
     (0 = pasto, 1 = nubes) y --subida es cuánto sube en px: lo mide el script de abajo en cada pantalla (de la lapa
     quieta hasta meterse en el borde de abajo de las nubes). Se inclina con la pendiente: -16°·sen(3π·t), el pico
     hacia arriba cuando sube y hacia abajo cuando baja. 17 puntos para que la curva se vea suave; GSAP (abajo) usa
     la misma fórmula */
  @keyframes lapa-vuelo {
    0% {
      translate: -100% calc(5% - var(--subida, 200%) * 0.000);
      rotate: -0.0deg;
    }
    6.25% {
      translate: calc(-100% + (100cqw + 100%) * 0.0625) calc(5% - var(--subida, 200%) * 0.084);
      rotate: -8.9deg;
    }
    12.5% {
      translate: calc(-100% + (100cqw + 100%) * 0.125) calc(5% - var(--subida, 200%) * 0.309);
      rotate: -14.8deg;
    }
    18.75% {
      translate: calc(-100% + (100cqw + 100%) * 0.1875) calc(5% - var(--subida, 200%) * 0.598);
      rotate: -15.7deg;
    }
    25% {
      translate: calc(-100% + (100cqw + 100%) * 0.25) calc(5% - var(--subida, 200%) * 0.854);
      rotate: -11.3deg;
    }
    31.25% {
      translate: calc(-100% + (100cqw + 100%) * 0.3125) calc(5% - var(--subida, 200%) * 0.990);
      rotate: -3.1deg;
    }
    37.5% {
      translate: calc(-100% + (100cqw + 100%) * 0.375) calc(5% - var(--subida, 200%) * 0.962);
      rotate: 6.1deg;
    }
    43.75% {
      translate: calc(-100% + (100cqw + 100%) * 0.4375) calc(5% - var(--subida, 200%) * 0.778);
      rotate: 13.3deg;
    }
    50% {
      translate: calc(-100% + (100cqw + 100%) * 0.5) calc(5% - var(--subida, 200%) * 0.500);
      rotate: 16.0deg;
    }
    56.25% {
      translate: calc(-100% + (100cqw + 100%) * 0.5625) calc(5% - var(--subida, 200%) * 0.222);
      rotate: 13.3deg;
    }
    62.5% {
      translate: calc(-100% + (100cqw + 100%) * 0.625) calc(5% - var(--subida, 200%) * 0.038);
      rotate: 6.1deg;
    }
    68.75% {
      translate: calc(-100% + (100cqw + 100%) * 0.6875) calc(5% - var(--subida, 200%) * 0.010);
      rotate: -3.1deg;
    }
    75% {
      translate: calc(-100% + (100cqw + 100%) * 0.75) calc(5% - var(--subida, 200%) * 0.146);
      rotate: -11.3deg;
    }
    81.25% {
      translate: calc(-100% + (100cqw + 100%) * 0.8125) calc(5% - var(--subida, 200%) * 0.402);
      rotate: -15.7deg;
    }
    87.5% {
      translate: calc(-100% + (100cqw + 100%) * 0.875) calc(5% - var(--subida, 200%) * 0.691);
      rotate: -14.8deg;
    }
    93.75% {
      translate: calc(-100% + (100cqw + 100%) * 0.9375) calc(5% - var(--subida, 200%) * 0.916);
      rotate: -8.9deg;
    }
    100% {
      translate: 100cqw calc(5% - var(--subida, 200%) * 1.000);
      rotate: -0.0deg;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const conCss = CSS.supports("animation-timeline: view()");
  const sinMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Cuánto tiene que subir la lapa (en px) para llegar a las nubes desde donde está quieta: hasta que su centro
  // quede un poco metido en el borde de abajo de las nubes. offsetTop no cambia con la animación (va en translate)
  const medirSubida = (recuadro: HTMLElement, lapa: HTMLElement) => {
    const nube = recuadro.querySelector<SVGElement>("svg.nube-svg");
    const bordeNubes = nube ? nube.getBoundingClientRect().height : 0;
    return Math.max(0, lapa.offsetTop - bordeNubes + lapa.offsetHeight * 0.7);
  };

  // Para el vuelo con CSS: la subida se pasa como --subida y se recalcula si cambia el tamaño del recuadro
  if (conCss && !sinMovimiento) {
    document.querySelectorAll<HTMLElement>("[data-lapa-scroll]").forEach((recuadro) => {
      const lapa = recuadro.querySelector<HTMLElement>("[data-lapa]");
      if (!lapa) return;
      const actualizar = () => lapa.style.setProperty("--subida", `${medirSubida(recuadro, lapa)}px`);
      actualizar();
      new ResizeObserver(actualizar).observe(recuadro);
      lapa.addEventListener("load", actualizar);
    });
  }

  if (!conCss && !sinMovimiento) {
    document.querySelectorAll<HTMLElement>("[data-lapa-scroll]").forEach((recuadro) => {
      const lapa = recuadro.querySelector<HTMLElement>("[data-lapa]");
      if (!lapa) return;

      // GSAP mueve con transform; se quita el centrado (translate) para que no se sumen
      lapa.style.left = "0";
      lapa.style.translate = "none";

      // Mismo recorrido que el keyframe de CSS (misma fórmula y mismos 17 puntos), en px
      const PUNTOS = 16;
      const punto = (i: number) => {
        const t = i / PUNTOS;
        const altura = 0.5 - 0.5 * Math.cos(3 * Math.PI * t);
        return {
          x: () => recuadro.offsetWidth * t,
          xPercent: -100 + 100 * t,
          y: () => lapa.offsetHeight * 0.05 - medirSubida(recuadro, lapa) * altura,
          rotate: -16 * Math.sin(3 * Math.PI * t),
        };
      };
      const vuelo = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: {
          trigger: recuadro,
          start: "top bottom",
          end: "bottom top",
          scrub: true,
          invalidateOnRefresh: true,
        },
      });
      gsap.set(lapa, punto(0));
      for (let i = 1; i <= PUNTOS; i++) vuelo.to(lapa, { ...punto(i), duration: 1 });

      // Nubes y selva: mismo recorrido que el keyframe nube-scroll, con las distancias de cada capa
      recuadro.querySelectorAll<Element>(".nube-capa, .selva-capa").forEach((capa) => {
        const estilo = getComputedStyle(capa);
        const dx = parseFloat(estilo.getPropertyValue("--nube-x"));
        const dy = parseFloat(estilo.getPropertyValue("--nube-y"));
        gsap.fromTo(
          capa,
          { x: dx * -0.5, y: -dy },
          {
            x: dx * 0.5,
            y: dy,
            ease: "none",
            scrollTrigger: { trigger: recuadro, start: "top bottom", end: "bottom top", scrub: true },
          }
        );
      });
    });
  }
</script>
