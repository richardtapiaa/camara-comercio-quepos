<style is:global>
  /* Quieta (sin JS o con "reducir movimiento"): posada en el cielo, a la derecha, y sin rastro */
  [data-mariposa] {
    left: 62%;
    top: 30%;
  }
  [data-mariposa-rastro] {
    display: none;
  }

  /* Aleteo: las alas se cierran y abren encogiendo la imagen a lo ancho, muy rápido */
  @media (prefers-reduced-motion: no-preference) {
    .mariposa-aletea {
      animation: mariposa-aletear 0.16s ease-in-out infinite alternate;
    }
  }
  @keyframes mariposa-aletear {
    to {
      scale: 0.55 1;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { MotionPathPlugin } from "gsap/MotionPathPlugin";

  gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);

  const sinMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Camino en píxeles del recuadro: entra por abajo a la izquierda (desde las flores) y sale por arriba a la
  // derecha, subiendo y bajando en ondas. Se calcula con el tamaño real para que el rastro no se deforme
  const trazar = (ancho: number, alto: number) => {
    const ondas = ancho < 700 ? 3 : 5;
    const amplitud = alto * (ancho < 700 ? 0.08 : 0.1);
    const puntos = 160;
    let d = "";
    for (let i = 0; i <= puntos; i++) {
      const t = i / puntos;
      const x = -0.1 * ancho + t * 1.2 * ancho;
      // Base que sube de las flores (78 % del alto) al cielo (22 %), más la onda
      const y = alto * (0.78 - 0.56 * t) - amplitud * Math.sin(t * ondas * 2 * Math.PI);
      d += `${i === 0 ? "M" : "L"}${x.toFixed(1)} ${y.toFixed(1)}`;
    }
    return d;
  };

  if (!sinMovimiento) {
    document.querySelectorAll<HTMLElement>("[data-mariposa-scroll]").forEach((recuadro) => {
      const mariposa = recuadro.querySelector<HTMLElement>("[data-mariposa]");
      const rastro = recuadro.querySelector<SVGSVGElement>("[data-mariposa-rastro]");
      const camino = recuadro.querySelector<SVGPathElement>("[data-mariposa-camino]");
      const mascara = recuadro.querySelector<SVGPathElement>("[data-mariposa-mascara]");
      if (!mariposa || !rastro || !camino || !mascara) return;

      // GSAP la mueve con transform desde la esquina del recuadro; se muestra el rastro
      mariposa.style.left = "0";
      mariposa.style.top = "0";
      rastro.style.display = "block";

      let tl: gsap.core.Timeline | undefined;
      let anchoAnterior = 0;

      const construir = () => {
        const ancho = recuadro.offsetWidth;
        const alto = recuadro.offsetHeight;
        anchoAnterior = ancho;

        const d = trazar(ancho, alto);
        rastro.setAttribute("viewBox", `0 0 ${ancho} ${alto}`);
        camino.setAttribute("d", d);
        mascara.setAttribute("d", d);

        // El rastro de puntitos se va descubriendo con una máscara: un trazo lleno que se "dibuja" (dashoffset)
        const largo = mascara.getTotalLength();
        mascara.style.strokeDasharray = `${largo}`;

        const progreso = tl?.scrollTrigger?.progress ?? 0;
        tl?.scrollTrigger?.kill();
        tl?.kill();

        // Todo el tiempo que el recuadro está en pantalla, como el vuelo de la lapa (LapaScroll.astro).
        // scrub con un poco de suavizado para que el movimiento no salte con el scroll táctil
        tl = gsap
          .timeline({
            defaults: { ease: "none" },
            scrollTrigger: { trigger: recuadro, start: "top bottom", end: "bottom top", scrub: 0.6 },
          })
          .to(mariposa, { motionPath: { path: camino, align: camino, alignOrigin: [0.5, 0.5] } }, 0)
          .fromTo(mascara, { strokeDashoffset: largo }, { strokeDashoffset: 0 }, 0);
        tl.progress(progreso);
      };

      construir();

      // Si cambia el ancho (giro del celular, ventana), se recalcula el camino
      let espera: number | undefined;
      window.addEventListener("resize", () => {
        window.clearTimeout(espera);
        espera = window.setTimeout(() => {
          if (recuadro.offsetWidth !== anchoAnterior) {
            construir();
            ScrollTrigger.refresh();
          }
        }, 200);
      });
    });
  }
</script>
