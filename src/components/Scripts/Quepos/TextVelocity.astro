---
import { VelocityScroll } from '../../ReactComponentes/QUEPOS/ScrollVelocity.tsx';

interface Props {
  texto?: string;
}

const { texto = "GALERIA" } = Astro.props;
---

<section class="overflow-hidden bg-white pb-8 pt-28 sm:pb-12 sm:pt-32">
  <VelocityScroll
    client:visible
    text={texto}
    default_velocity={5}
    className="font-serif text-5xl font-bold uppercase tracking-[0.12em] text-black sm:text-7xl lg:text-8xl"
  />
</section>
