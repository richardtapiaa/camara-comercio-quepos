
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  
  const mm = gsap.matchMedia();

  mm.add("(min-width: 768px) and (prefers-reduced-motion: no-preference)", () => {
    document.querySelectorAll<HTMLElement>("[data-galeria-capacitaciones]").forEach((galeria) => {
      galeria.querySelectorAll<HTMLElement>("[data-galeria-foto]").forEach((foto) => {
        const velocidad = Number(foto.dataset.velocidad ?? 0);
        const recorrido = () => galeria.offsetHeight * velocidad;

        gsap.fromTo(
          foto,
          { y: () => recorrido() },
          {
            y: () => -recorrido(),
            ease: "none",
            scrollTrigger: { trigger: galeria, start: "top bottom", end: "bottom top", scrub: true, invalidateOnRefresh: true },
          },
        );
      });
    });
  });
</script>
