
<script>
  const header = document.getElementById("site-header");
  const hero = document.getElementById("hero");
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");

  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });

  // Sobre el hero: transparente. Al salir del hero: barra blanca visible (con margen de gracia).
  // Más abajo: se oculta al bajar y reaparece al subir.
  const HIDE_BUFFER = 300;
  const DELTA = 6;
  let lastY = window.scrollY;
  let hidden = false;

  const update = () => {
    if (!header) return;
    const y = window.scrollY;
    const heroEnd = hero ? hero.offsetTop + hero.offsetHeight : 0;
    const pastHero = y >= heroEnd - header.offsetHeight;

    if (!pastHero) {
      header.dataset.solid = "false";
      hidden = false;
    } else {
      header.dataset.solid = "true";
      const menuOpen = toggle?.getAttribute("aria-expanded") === "true";
      if (menuOpen || y < heroEnd + HIDE_BUFFER) {
        hidden = false;
      } else if (y - lastY > DELTA) {
        hidden = true;
      } else if (lastY - y > DELTA) {
        hidden = false;
      }
    }
    header.dataset.hidden = String(hidden);
    if (Math.abs(y - lastY) > DELTA || !pastHero) lastY = y;
  };

  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  update();
</script>