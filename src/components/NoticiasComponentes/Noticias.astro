---
import Noticias from "../ReactComponentes/NoticiasComponentes/Noticias";
import { obtenerPostsFacebook } from "../../lib/facebook";
import { contacto } from "../../lib/sitio";

const posts = await obtenerPostsFacebook(10);
---

<Noticias posts={posts} urlFacebook={contacto.facebook} />

<script>
  const filtros = document.querySelector<HTMLElement>("[data-filtros-noticias]");
  if (filtros) {
    const buscar = filtros.querySelector<HTMLInputElement>("[data-buscar-noticia]")!;
    const mes = filtros.querySelector<HTMLSelectElement>("[data-filtrar-mes]");
    const chips = [...filtros.querySelectorAll<HTMLButtonElement>("[data-tema]")];
    let tema = "";
    const conteo = filtros.querySelector<HTMLElement>("[data-conteo-noticias]")!;
    const noticias = [...document.querySelectorAll<HTMLElement>("[data-noticia]")];
    const sinResultados = document.querySelector<HTMLElement>("[data-sin-resultados]");
    const normalizar = (texto: string) =>
      texto
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");

    const aplicar = () => {
      const palabras = normalizar(buscar.value).split(/\s+/).filter(Boolean);
      let visibles = 0;
      for (const noticia of noticias) {
        const coincide =
          (!mes?.value || noticia.dataset.mes === mes.value) &&
          (!tema || (noticia.dataset.temas ?? "").split(" ").includes(tema)) &&
          palabras.every((palabra) => (noticia.dataset.busqueda ?? "").includes(palabra));
        noticia.hidden = !coincide;
        if (coincide) visibles++;
      }
      if (sinResultados) sinResultados.hidden = visibles > 0;
      conteo.textContent = palabras.length || mes?.value || tema ? `${visibles} de ${noticias.length} noticias` : "";
    };

    filtros.hidden = false;
    filtros.querySelector("form")?.addEventListener("submit", (e) => e.preventDefault());
    buscar.addEventListener("input", aplicar);
    mes?.addEventListener("change", aplicar);
    const elegirTema = (valor: string) => {
      tema = valor;
      chips.forEach((chip) => chip.setAttribute("aria-pressed", String(chip.dataset.tema === valor)));
      aplicar();
    };
    chips.forEach((chip) => chip.addEventListener("click", () => elegirTema(chip.dataset.tema ?? "")));
    document.querySelector("[data-limpiar-filtros]")?.addEventListener("click", () => {
      buscar.value = "";
      if (mes) mes.value = "";
      elegirTema("");
      buscar.focus();
    });
    aplicar();
  }
</script>
