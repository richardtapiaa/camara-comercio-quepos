---
import headerImage from "../assets/imagenes/seccion-checkout.jpg";
---

<main id="contacto" class="min-h-screen bg-[#f4efe9] pb-16 pt-24 text-[#403c39]">
  <section
    class="relative overflow-hidden bg-[#2780c9] px-6 py-12 text-white sm:px-10 lg:px-16"
    style={`background-image: linear-gradient(rgb(39 128 201 / 92%), rgb(39 128 201 / 92%)), url(${headerImage.src}); background-position: center; background-size: cover;`}
  >
    <div class="mx-auto flex max-w-7xl flex-col gap-8 sm:flex-row sm:items-center sm:justify-between">
      <h1 class="font-sans text-2xl font-bold uppercase tracking-tight sm:text-3xl">
        Horario de atención
      </h1>
      <p class="text-sm font-medium sm:text-base">L-V 9:00am - 5:00pm</p>
      <a href="tel:+50627749130" class="flex items-center gap-2 text-sm font-semibold transition hover:text-white/75 sm:text-base">
        <span aria-hidden="true">☎</span>
        +506 2774-9130
      </a>
    </div>
  </section>

  <section class="px-6 py-16 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12 text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[#8c8078]">Estamos para ayudarte</p>
        <h2 class="mt-3 font-sans text-4xl font-bold text-[#2780c9] sm:text-5xl">Contáctanos</h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-[#766e68]">
          Envíanos tu consulta y nos pondremos en contacto contigo lo antes posible.
        </p>
      </div>

      <form class="grid gap-6 rounded-3xl bg-white p-7 shadow-lg sm:grid-cols-2 sm:p-10" method="post">
        <label class="grid gap-2 text-sm font-semibold">
          Nombre <span class="text-[#2780c9]">(*)</span>
          <input name="nombre" type="text" required autocomplete="name" class="contact-input" />
        </label>
        <label class="grid gap-2 text-sm font-semibold">
          Email <span class="text-[#2780c9]">(*)</span>
          <input name="email" type="email" required autocomplete="email" class="contact-input" />
        </label>
        <label class="grid gap-2 text-sm font-semibold">
          Asunto <span class="text-[#2780c9]">(*)</span>
          <input name="asunto" type="text" required class="contact-input" />
        </label>
        <label class="grid gap-2 text-sm font-semibold">
          Teléfono
        <input name="telefono" type="tel" inputmode="numeric" pattern="[0-9]*" autocomplete="tel" data-numeric class="contact-input" />
        </label>
        <label class="grid gap-2 text-sm font-semibold sm:col-span-2">
          Mensaje <span class="text-[#2780c9]">(*)</span>
          <textarea name="mensaje" rows="7" required class="contact-input resize-y"></textarea>
        </label>
        <div class="sm:col-span-2">
          <button
            type="submit"
            class="rounded-full bg-[#f43f62] px-9 py-3 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#d93455]"
          >
            Enviar mensaje
          </button>
        </div>
      </form>
    </div>
  </section>
</main>

<style>
  .contact-input {
    width: 100%;
    border: 1px solid rgb(118 110 104 / 25%);
    border-radius: 0.75rem;
    background: #faf9f7;
    padding: 0.8rem 0.9rem;
    color: #403c39;
    font-size: 0.95rem;
    font-weight: 400;
    outline: none;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .contact-input:focus {
    border-color: #2780c9;
    box-shadow: 0 0 0 3px rgb(39 128 201 / 15%);
  }
</style>

<script>
  document.querySelectorAll<HTMLInputElement>("[data-numeric]").forEach((input) => {
    input.addEventListener("input", () => {
      input.value = input.value.replace(/\D/g, "");
    });
  });
</script>