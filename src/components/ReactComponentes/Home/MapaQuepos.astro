---
import MapaQuepos from "./MapaQuepos";
import mapa from "../../../data/mapa-quepos.json";
import FondoSello from "../../compartidos/FondoSello";
import FondoTopografico from "../../compartidos/FondoTopografico.astro";

const [, , anchoMapa, altoMapa] = mapa.viewBox.split(" ").map(Number);
const proporcion = (anchoMapa / altoMapa).toFixed(4);
---

<section
  aria-labelledby="titulo-mapa-quepos"
  class="relative isolate overflow-x-clip bg-white px-6 py-16 sm:px-10 sm:py-20"
>
  <FondoTopografico />
  <FondoSello lado="izquierda" corrido opacidad={0.05} />
  <div class="mx-auto grid max-w-[96rem] items-center gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-12">
    <div class="max-w-xl">
      <h2
        id="titulo-mapa-quepos"
        class="text-4xl font-extrabold uppercase leading-none tracking-tight text-slate-900 sm:text-5xl"
      >
        Descubra el cantón
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-slate-500">
        Desde las playas y la selva de Manuel Antonio hasta los ríos y montañas de Savegre y los paisajes rurales de
        Naranjito, el cantón de Quepos está lleno de experiencias que no decepcionan. Toque el mapa para conocer cada
        distrito.
      </p>
      <a
        href="/quepos"
        class="group mt-6 inline-flex items-center gap-2 py-2 text-sm font-bold uppercase tracking-[0.15em] text-[#3f8a82] transition-colors hover:text-[#2b4a5c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#2b4a5c] motion-reduce:transition-none"
      >
        Explore Quepos
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4 transition-transform group-hover:translate-x-1 motion-reduce:transition-none"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>

    <div
      class="relative mx-auto lg:mr-0 lg:pt-16"
      style={`width: min(100%, calc((100svh - 11rem) * ${proporcion}))`}
    >
      <p
        class="mb-4 px-4 text-center font-['Caveat','Comic_Sans_MS',cursive] text-2xl font-bold leading-tight text-slate-800 lg:absolute lg:left-0 lg:top-0 lg:mb-0 lg:w-56 lg:-rotate-3 lg:px-0 lg:text-left"
      >
        ¡Toque el mapa para explorar cada distrito!
      </p>
      <svg
        viewBox="0 0 70 50"
        class="absolute left-44 top-5 hidden w-16 rotate-12 text-slate-800 lg:block"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 6c14 2 30 10 44 30"></path>
        <path d="M34 34l14 3 2-14"></path>
      </svg>

      <MapaQuepos />
    </div>
  </div>
</section>

<script src="../../../scripts/home/mapa-quepos.ts"></script>
