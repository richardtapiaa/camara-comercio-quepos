---
// Mapa del cantón de Quepos (sus 3 distritos), solo y centrado, con una nota escrita a mano que invita a tocarlo.
// El distrito Quepos lleva a /quepos.
// MapaQuepos.tsx va sin client:* a propósito: es un SVG con un enlace, no necesita JavaScript.
import MapaQuepos from "./MapaQuepos";
import mapa from "../../../data/mapa-quepos.json";

// Proporción del mapa (ancho / alto): con ella se calcula el ancho máximo para que entre completo a lo alto
const [, , anchoMapa, altoMapa] = mapa.viewBox.split(" ").map(Number);
const proporcion = (anchoMapa / altoMapa).toFixed(4);
---

<section aria-labelledby="titulo-mapa-quepos" class="overflow-x-clip bg-[#f5f3ee] px-3 py-16 sm:px-10 sm:py-20">
  <!-- Título solo para lectores de pantalla: la sección no muestra texto, pero necesita un nombre -->
  <h2 id="titulo-mapa-quepos" class="sr-only">Mapa del cantón de Quepos</h2>

  <!-- Ancho del mapa: lo más grande posible hasta 1100 px, sin pasarse del alto de la pantalla (11rem: el navbar, la
       nota y algo de aire), para que se vea completo sin tener que bajar -->
  <div
    class="relative mx-auto lg:pt-16"
    style={`width: min(100%, 1100px, calc((100svh - 11rem) * ${proporcion}))`}
  >
    <!-- Nota escrita a mano con flecha. En pantallas grandes va arriba a la izquierda y la flecha apunta a Quepos;
         en celular y tablet, centrada encima del mapa y sin flecha -->
    <p
      class="mb-4 px-4 text-center font-['Caveat','Comic_Sans_MS',cursive] text-2xl font-bold leading-tight text-slate-800 lg:absolute lg:left-0 lg:top-0 lg:mb-0 lg:w-56 lg:-rotate-3 lg:px-0 lg:text-left"
    >
      ¡Toque el mapa para explorar Quepos!
    </p>
    <svg
      viewBox="0 0 70 50"
      class="absolute left-44 top-5 hidden w-16 rotate-12 text-slate-800 lg:block"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M4 6c14 2 30 10 44 30"></path>
      <path d="M34 34l14 3 2-14"></path>
    </svg>

    <MapaQuepos />
  </div>
</section>
