---
import { Image } from "astro:assets";
import fotoArtesano from "../../assets/bolsa-empleo/artesano-trabajando.webp";
import fotoVendedor from "../../assets/bolsa-empleo/vendedor-sandias.webp";
import artesanoVertical from "../../assets/bolsa-empleo/artesano-trabajando-celular.webp";
import vendedorVertical from "../../assets/bolsa-empleo/vendedor-sandias-celular.webp";
import logoBlanco from "../../assets/compartido/logo-camara-blanco.webp";
import sello from "../../assets/compartido/logo-camara-sello-480.webp";
import { recorteCelular, sizesHasta2x, variantesCapa } from "../../lib/imagenes";

const ANIO_FUNDACION = 1995;
const cifras = [
  { valor: "43", texto: "Empresas afiliadas" },
  { valor: String(new Date().getFullYear() - ANIO_FUNDACION), texto: "Años de trayectoria" },
];

const anchoCelular = sizesHasta2x("max(100vw - 3rem, 33rem)");
const anchosArtesano = [480, 800, 1056, 1200];
const artesanoWebp = await variantesCapa(fotoArtesano, anchosArtesano, 80);
const artesanoAvif = await variantesCapa(fotoArtesano, anchosArtesano, 65, "avif");
const sizesArtesano = `(min-width: 1024px) 34vw, (min-width: 768px) 55vw, ${anchoCelular}`;
const anchosVendedor = [480, 800, 1056, 1200, 1600];
const vendedorWebp = await variantesCapa(fotoVendedor, anchosVendedor, 80);
const vendedorAvif = await variantesCapa(fotoVendedor, anchosVendedor, 65, "avif");
const sizesVendedor = `(min-width: 1024px) 40vw, ${anchoCelular}`;
const artesanoCelular = await recorteCelular(artesanoVertical, fotoArtesano, [480, 800, 1200], "100vw", 65);
const vendedorCelular = await recorteCelular(vendedorVertical, fotoVendedor, [480, 800, 1200, 1600], "100vw", 65);
---

<section aria-labelledby="titulo-info-bolsa" class="bg-white px-6 py-20 sm:px-10 sm:py-24">
  <h2 id="titulo-info-bolsa" class="sr-only">Sobre la Bolsa de Empleo</h2>

  <div class="mx-auto grid max-w-7xl gap-4 sm:gap-5 md:grid-cols-[1.1fr_0.9fr] lg:grid-cols-[1.05fr_0.8fr_1.25fr]">
    <figure class="relative isolate min-h-[22rem] overflow-hidden rounded-[1.75rem] bg-slate-200 sm:min-h-[24rem]">
      <picture>
        <source media={artesanoCelular.media} type="image/avif" srcset={artesanoCelular.avif} sizes={artesanoCelular.sizes} />
        <source media={artesanoCelular.media} type="image/webp" srcset={artesanoCelular.webp} sizes={artesanoCelular.sizes} />
        <source type="image/avif" srcset={artesanoAvif.srcSet} sizes={sizesArtesano} />
        <img
          src={artesanoWebp.src}
          srcset={artesanoWebp.srcSet}
          sizes={sizesArtesano}
          width={fotoArtesano.width}
          height={fotoArtesano.height}
          alt="Artesano de Quepos tallando una pieza de madera en su taller"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 -z-10 size-full object-cover object-[62%_center]"
        />
      </picture>
      <dl class="absolute inset-x-4 bottom-4 flex flex-col gap-2.5 sm:inset-x-5 sm:bottom-5">
        {
          cifras.map(({ valor, texto }) => (
            <div class="flex max-w-[16rem] flex-row-reverse items-center justify-end gap-4 rounded-xl bg-white/80 px-5 py-3 shadow-sm ring-1 ring-white/60 backdrop-blur-md">
              <dt class="max-w-[7rem] text-[0.6875rem] font-semibold uppercase leading-tight tracking-[0.12em] text-slate-700">{texto}</dt>
              <dd class="m-0 min-w-[2.75rem] text-3xl font-light leading-none text-slate-950 sm:text-4xl">{valor}</dd>
            </div>
          ))
        }
      </dl>
    </figure>

    <figure class="relative isolate flex min-h-[22rem] flex-col overflow-hidden rounded-[1.75rem] bg-[#2780c9] p-7 text-white sm:min-h-[24rem] sm:p-8">
      <img
        src={sello.src}
        width={sello.width}
        height={sello.height}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        class="pointer-events-none absolute -bottom-10 -right-24 -z-10 w-[22rem] max-w-none rotate-12 opacity-[0.12] brightness-0 invert"
      />
      <Image
        src={logoBlanco}
        widths={[176, 352]}
        sizes="(min-width: 640px) 176px, 160px"
        alt="Cámara de Comercio, Industria y Turismo de Quepos"
        loading="lazy"
        decoding="async"
        class="h-auto w-40 sm:w-44"
      />
      <blockquote class="mt-auto pt-10">
        <p class="text-balance text-xl font-medium leading-snug sm:text-[1.375rem]">
          Promovemos y facilitamos la vinculación laboral entre nuestros asociados y las personas que buscan empleo.
        </p>
      </blockquote>
      <figcaption class="mt-5 text-sm text-white/80">— Bolsa de Empleo de la Cámara</figcaption>
    </figure>

    <figure class="relative isolate flex min-h-[22rem] flex-col justify-end overflow-hidden rounded-[1.75rem] bg-slate-200 p-3 sm:min-h-[24rem] md:col-span-2 lg:col-span-1">
      <picture>
        <source media={vendedorCelular.media} type="image/avif" srcset={vendedorCelular.avif} sizes={vendedorCelular.sizes} />
        <source media={vendedorCelular.media} type="image/webp" srcset={vendedorCelular.webp} sizes={vendedorCelular.sizes} />
        <source type="image/avif" srcset={vendedorAvif.srcSet} sizes={sizesVendedor} />
        <img
          src={vendedorWebp.src}
          srcset={vendedorWebp.srcSet}
          sizes={sizesVendedor}
          width={fotoVendedor.width}
          height={fotoVendedor.height}
          alt="Vendedor sonriente en un mercado de Quepos, detrás de un puesto de sandías"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 -z-10 size-full object-cover object-[40%_center]"
        />
      </picture>
      <figcaption class="flex items-center gap-2.5 rounded-xl bg-white px-4 py-3 text-sm font-medium text-slate-800 shadow-sm">
        <svg class="size-5 shrink-0 text-[#2780c9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="7" width="18" height="13" rx="2" />
          <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18" />
        </svg>
        Intermediación laboral con nuestros asociados
      </figcaption>
    </figure>
  </div>

  <p class="mx-auto mt-14 max-w-3xl text-balance text-center text-xl leading-relaxed text-slate-800 sm:mt-16 sm:text-2xl">
    La Bolsa de Empleo acerca a quienes buscan trabajo a las empresas asociadas del cantón. La Cámara no contrata
    personal: facilita las solicitudes de empleo a los asociados que lo requieren.
  </p>
</section>
