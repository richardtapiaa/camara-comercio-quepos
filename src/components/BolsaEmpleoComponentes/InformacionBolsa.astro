---
import ilustracionBolsa from "../../assets/bolsa-empleo/bolsa-empleo.svg";

const puntos = [
  "Registra tu información profesional.",
  "Comparte tu experiencia y estudios.",
  "Permite que nuestros asociados conozcan tu perfil.",
];
---

<aside class="relative z-10 min-h-[48rem] self-stretch overflow-hidden bg-transparent px-7 py-10 text-white sm:px-12 lg:min-h-0 lg:px-12 lg:py-14 xl:px-16">
  <div class="mt-10 max-w-[43rem] lg:mt-12">
    <p class="text-[11px] font-bold uppercase tracking-[0.26em] text-[#f4ad42]">
      Oportunidades laborales
    </p>
    <h1 class="mt-4 max-w-[44rem] text-[2.15rem] font-bold leading-[1.12] sm:text-5xl lg:text-[2.55rem] xl:text-[2.85rem]">
      ¡Bienvenido a la <span class="text-[#f4ad42]">Bolsa de Empleo</span><br class="hidden xl:block" />
      de la Cámara de Comercio,<br class="hidden xl:block" />
      Industria y Turismo de Quepos!
    </h1>

    <img
      src={ilustracionBolsa.src}
      width={ilustracionBolsa.width}
      height={ilustracionBolsa.height}
      alt="Persona buscando una oportunidad laboral"
      class="mx-auto mt-6 h-auto w-64 sm:w-72 lg:w-72 xl:w-80"
    />

    <div class="mt-7 max-w-[42rem] text-sm leading-6 text-white/80">
      <p class="mb-3 font-semibold text-white">Conectamos a las personas que buscan trabajo con las oportunidades laborales de nuestros asociados.</p>
      <p class="mb-2"><strong class="text-white">¿En qué consiste nuestro servicio?</strong></p>
      <p>Nuestra Bolsa de Empleo busca promover y facilitar la vinculación laboral entre nuestros asociados y las personas en situación de desempleo.</p>
      <p class="mt-2">Brindamos un servicio de intermediación buscando promover entre nuestros asociados las necesidades de las personas que buscan trabajo.</p>
      <p class="mt-2">Es importante aclarar que la Cámara de Comercio, Industria y Turismo de Quepos no busca colaboradores, sino solamente facilita las solicitudes de empleo a los asociados que lo requieren.</p>
      <p class="mt-2">Agradecemos la acogida a este nuevo programa de oferta y demanda laboral en nuestro cantón.</p>
    </div>

    <ol class="mt-9 max-w-[38rem] space-y-4">
      {
        puntos.map((punto, indice) => (
          <li class="grid grid-cols-[2.1rem_1fr] items-center text-sm text-white/95 sm:text-[15px]">
            <span class="text-lg font-semibold text-[#f4ad42]">{String(indice + 1).padStart(2, "0")}</span>
            <span>{punto}</span>
          </li>
        ))
      }
    </ol>
  </div>
</aside>
