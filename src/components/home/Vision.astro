---
import { Image } from "astro:assets";
import imagen from "../../assets/imagenes/vision-seccion.jpg";
import secundaria from "../../assets/imagenes/seccion-ejemplo.jpg";
import MisionScripts from "../Scripts/home/MisionScripts.astro";

const marco = "relative overflow-hidden";
const parallax = "absolute inset-x-0 -top-full h-[200%] w-full max-w-none object-cover will-change-transform";
---

<!-- Queda fijo (sticky nativo, sin saltos) mientras Objetivos se desliza por encima; si es más alto que la
     pantalla se fija al verse completo hasta su final. --alto-panel lo actualiza PanelesScripts -->
<section
  id="vision"
  data-panel-sticky
  class="panel sticky overflow-x-clip bg-[#E8F4FA] py-16 sm:py-24"
  style="top: min(0px, calc(100svh - var(--alto-panel, 100svh)))"
>
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 md:grid-cols-12 md:gap-y-16">
    <!-- Sale del contenedor hasta el borde izquierdo de la pantalla -->
    <div class={`${marco} -ml-[calc(max(0px,(100vw_-_72rem)/2)+1.5rem)] aspect-[16/9] rounded-r-2xl md:col-span-7 md:aspect-[3/1]`}>
      <Image src={imagen} alt="Visión de la Cámara de Comercio de Quepos" class={parallax} data-parallax-img />
    </div>

    <div class="md:col-span-5 md:pl-6">
      <span class="text-xs font-semibold uppercase tracking-[0.25em] text-neutral-500">Hacia dónde vamos</span>
      <h2 class="mt-3 font-serif text-5xl font-normal uppercase tracking-[0.2em] text-neutral-700 sm:text-6xl">Visión</h2>
      <p class="mt-8 text-base font-medium leading-relaxed text-neutral-800 sm:text-lg">
        Convertir a Quepos en el cantón costero más desarrollado de Costa Rica y en armonía con el ambiente.
      </p>
    </div>

    <div class="md:col-span-6 md:col-start-2">
      <p class="text-sm italic leading-relaxed text-neutral-700 sm:text-base">
        Desarrollado en términos sociales y económicos, que brinde al visitante todos los servicios necesarios para sus necesidades y al ciudadano que vive en Quepos lo permee de ese desarrollo a través de su crecimiento personal y oportunidades reales, así como el crecimiento de las empresas privadas ubicadas en el cantón.
      </p>
    </div>

    <div class="md:col-span-3 md:col-start-9">
      <div class={`${marco} aspect-[10/9] rounded-2xl`}>
        <Image src={secundaria} alt="Quepos" class={parallax} data-parallax-img />
      </div>
    </div>
  </div>
</section>

<MisionScripts />
