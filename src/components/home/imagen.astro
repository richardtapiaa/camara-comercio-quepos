---
import fotoInicio from "../../assets/inicio/quepos-montanas.webp";
import logoBlanco from "../../assets/compartido/logo-camara-blanco.webp";
import "../../styles/compartido/etiqueta-papel.css";

const ANIO_FUNDACION = 1995;
const cifras = [
  { valor: "43", texto: "empresas afiliadas" },
  { valor: String(new Date().getFullYear() - ANIO_FUNDACION), texto: `años, desde ${ANIO_FUNDACION}` },
  { valor: "3", texto: "sectores productivos" },
];
---

<section
  data-foto-parallax
  class="relative isolate h-[clamp(20rem,38vw,36rem)] w-full overflow-hidden bg-linear-to-b from-white from-50% to-[#5b6b55] max-sm:h-svh max-sm:min-h-screen"
  aria-label="La Cámara en cifras"
>
  <div class="absolute inset-0 mask-t-from-50% max-sm:mask-t-from-68%" aria-hidden="true">
    <img
      data-foto-parallax-capa
      class="absolute inset-x-0 top-[-25%] block h-[150%] w-full object-cover object-[center_60%] will-change-transform max-sm:top-[-12.5%] max-sm:h-[125%] max-sm:object-[55%_center] md:top-0 md:h-full md:will-change-auto"
      src={fotoInicio.src}
      width={fotoInicio.width}
      height={fotoInicio.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <div
      class="absolute inset-0 bg-linear-to-t from-[#140c0a]/40 to-transparent to-50% max-sm:from-[#140c0a]/50 max-sm:via-[#140c0a]/22 max-sm:via-55% max-sm:to-75%"
    >
    </div>
    <div
      class="absolute inset-0 bg-radial-[ellipse_60%_70%_at_82%_72%] from-[#140c0a]/40 to-transparent to-70% max-sm:hidden"
    >
    </div>
  </div>
  <div
    class="absolute top-[64%] right-[6%] z-3 flex -translate-y-1/2 flex-col items-center gap-[clamp(0.75rem,2vw,1.75rem)] text-white text-shadow-[0_2px_12px_rgb(0_0_0/0.45)] max-sm:top-0 max-sm:right-4 max-sm:bottom-12 max-sm:left-4 max-sm:translate-y-0 max-sm:justify-end"
  >
    <dl class="m-0 flex max-sm:absolute max-sm:inset-x-0 max-sm:top-1/2 max-sm:-translate-y-1/2">
      {
        cifras.map(({ valor, texto }) => (
          <div class="flex max-w-40 flex-col-reverse items-center justify-end px-[clamp(0.75rem,2vw,1.75rem)] text-center not-first:border-l not-first:border-white/45 max-sm:flex-1 max-sm:px-2">
            <dt class="mt-[0.35rem] text-[clamp(0.7rem,0.95vw,0.875rem)] leading-[1.3] font-semibold tracking-[0.04em] uppercase max-sm:text-[0.7rem]">
              {texto}
            </dt>
            <dd class="m-0 font-['Anton',Impact,'Arial_Narrow',sans-serif] text-[clamp(2.25rem,4.5vw,4.25rem)] leading-none max-sm:text-[2.75rem]">
              {valor}
            </dd>
          </div>
        ))
      }
    </dl>
    <img
      class="h-auto w-[clamp(6rem,9vw,9rem)] object-contain brightness-0 invert max-sm:w-80 max-sm:max-w-full"
      src={logoBlanco.src}
      alt="Cámara de Comercio, Industria y Turismo de Quepos"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<script src="../../scripts/quepos/foto-quepos.ts"></script>
