---
import { Picture } from "astro:assets";
import { Mail, MapPin, Phone } from "lucide-react";
import logo from "../../assets/compartido/logo-camara.webp";
import FondoSello from "../compartidos/FondoSello";
import { contacto, nombreSitio } from "../../lib/sitio";

const grupos = [
  {
    titulo: "La Cámara",
    enlaces: [
      { label: "Inicio", href: "/" },
      { label: "Afiliados", href: "/afiliados" },
      { label: "Mapa de afiliados", href: "/mapa-afiliados" },
      { label: "Capacitaciones", href: "/capacitaciones" },
      { label: "Noticias", href: "/noticias" },
    ],
  },
  {
    titulo: "Cantón Quepos",
    enlaces: [
      { label: "Quepos", href: "/quepos" },
      { label: "Hospitalidad & Gastronomía", href: "/hospitalidad" },
      { label: "Visítenos", href: "/visitenos" },
      { label: "Galería", href: "/queposgaleria" },
    ],
  },
];

const participe = [
  { label: "Únete", href: "/unete" },
  { label: "Bolsa de empleo", href: "/bolsa-de-empleo" },
  { label: "Contacto", href: "/contacto" },
];

const [usuarioCorreo, dominioCorreo] = contacto.email.split("@");
const telefono = contacto.telefono.replace(/[^+\d]/g, "");

const claseTitulo = "text-lg font-medium text-[#f1dcbc]";
const claseLinea = "mt-4 block h-px w-full bg-white/20";
const claseFoco = "rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f1dcbc]";
const claseEnlace = `${claseFoco} -my-1.5 inline-block py-1.5 text-[0.95rem] text-white/75 transition-colors hover:text-white motion-reduce:transition-none`;
const claseContacto = `${claseFoco} -my-1.5 flex items-start gap-3 py-1.5 text-[1.05rem] text-white/85 transition-colors hover:text-white motion-reduce:transition-none`;
const claseRed = `${claseFoco} group flex items-center gap-3 text-[0.95rem] text-white/75 transition-colors hover:text-white motion-reduce:transition-none`;
const claseIconoRed =
  "flex size-9 shrink-0 items-center justify-center rounded-full border border-white/20 text-[#f1dcbc] transition-colors group-hover:border-white/50 group-hover:text-white motion-reduce:transition-none";
---

<footer class="relative isolate overflow-hidden bg-[#17191c] text-white">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60rem_28rem_at_0%_0%,rgb(241_220_188/0.07),transparent_70%)]"
  >
  </div>
  <FondoSello lado="izquierda" claro fijo={false} opacidad={0.06} />

  <div class="mx-auto max-w-7xl px-6 sm:px-10">
    <div
      class="grid grid-cols-2 gap-x-6 gap-y-14 py-16 sm:py-20 md:grid-cols-3 md:gap-x-10 lg:grid-cols-[1.5fr_1fr_1.15fr_1fr] lg:gap-x-12"
    >
      <div class="col-span-2 md:col-span-3 lg:col-span-1">
        <p class="max-w-md text-[0.95rem] leading-relaxed text-white/70">
          La Cámara de Comercio, Industria y Turismo de Quepos reúne a los comercios, las empresas turísticas y las
          industrias del cantón, en el Pacífico central de Costa Rica: a unas 3 horas de San José y a minutos del Parque
          Nacional Manuel Antonio.
        </p>

        <h2 class={`mt-12 ${claseTitulo}`}>Contacto</h2>
        <span aria-hidden="true" class={`${claseLinea} max-w-[21rem]`}></span>
        <address class="mt-6 space-y-4 not-italic">
          <a href={`mailto:${contacto.email}`} class={claseContacto}>
            <Mail className="mt-1 size-5 shrink-0 text-[#f1dcbc]" aria-hidden="true" />
            <span>Correo: {usuarioCorreo}@<wbr />{dominioCorreo}</span>
          </a>
          <a href={`tel:${telefono}`} class={claseContacto}>
            <Phone className="mt-1 size-5 shrink-0 text-[#f1dcbc]" aria-hidden="true" />
            <span>Teléfono: {contacto.telefono}</span>
          </a>
          <p class="flex items-start gap-3 text-[1.05rem] text-white/85">
            <MapPin className="mt-1 size-5 shrink-0 text-[#f1dcbc]" aria-hidden="true" />
            <span>Quepos, Puntarenas, Costa Rica</span>
          </p>
        </address>
      </div>

      {
        grupos.map(({ titulo, enlaces }) => (
          <nav aria-label={titulo}>
            <h2 class={claseTitulo}>{titulo}</h2>
            <span aria-hidden="true" class={`${claseLinea} max-w-[12rem]`} />
            <ul class="mt-6 space-y-4">
              {enlaces.map(({ label, href }) => (
                <li>
                  <a href={href} class={claseEnlace}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="col-span-2 flex flex-col md:col-span-1">
        <nav aria-label="Participe">
          <h2 class={claseTitulo}>Participe</h2>
          <span aria-hidden="true" class={`${claseLinea} max-w-[12rem]`}></span>
          <ul class="mt-6 space-y-4">
            {
              participe.map(({ label, href }) => (
                <li>
                  <a href={href} class={claseEnlace}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <h2 class={`mt-12 ${claseTitulo}`}>Redes sociales</h2>
        <span aria-hidden="true" class={`${claseLinea} max-w-[12rem]`}></span>
        <ul class="mt-6 space-y-3">
          <li>
            <a href={contacto.facebook} target="_blank" rel="noopener noreferrer" class={claseRed}>
              <span class={claseIconoRed}>
                <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
                  <path
                    d="M13.5 22v-8.2h2.8l.5-3.3h-3.3V8.4c0-.9.3-1.6 1.7-1.6h1.7V4a22 22 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.3H7.2v3.3H10V22h3.5Z"
                  ></path>
                </svg>
              </span>
              Facebook<span class="sr-only"> (se abre en otra pestaña)</span>
            </a>
          </li>
          <li>
            <a href={contacto.instagram} target="_blank" rel="noopener noreferrer" class={claseRed}>
              <span class={claseIconoRed}>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-4"
                  aria-hidden="true"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
                </svg>
              </span>
              Instagram<span class="sr-only"> (se abre en otra pestaña)</span>
            </a>
          </li>
        </ul>

        <a
          href="/"
          class="mt-12 self-start rounded-2xl bg-white px-3 py-1.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f1dcbc]"
        >
          <Picture
            src={logo}
            formats={["avif", "webp"]}
            quality={60}
            alt={nombreSitio}
            widths={[200, 400]}
            sizes="168px"
            class="h-auto w-[170px] max-w-full"
            loading="lazy"
          />
        </a>
      </div>
    </div>

    <div class="border-t border-white/10 py-6">
      <p class="text-sm text-white/60">© {new Date().getFullYear()} {nombreSitio}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
