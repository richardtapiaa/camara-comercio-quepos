---
import { Image } from "astro:assets";
import logo from "../../assets/imagenes/logo-camara.webp";
import footerImage from "../../assets/imagenes/pie_pagina.webp";

const links = [
  { label: "Inicio", href: "/" },
  { label: "Contacto", href: "/contacto" },
  { label: "Únete", href: "/unete" },
];

const socialLinks = {
  facebook: "https://www.facebook.com/CCITQuepos",
  instagram: "https://www.instagram.com/camaradequepos",
};
---

<footer class="relative isolate overflow-hidden bg-[#e8f8fa] text-[#087b8d]">
  <Image
    src={footerImage}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 z-0 h-full w-full object-cover object-center"
    loading="lazy"
  />
  <div class="absolute inset-0 z-0 bg-[#032a36]/35" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex min-h-[34rem] max-w-7xl flex-col items-center justify-center px-5 py-10 text-center sm:min-h-[30rem] sm:px-10 sm:py-20">
    <Image
      src={logo}
      alt="Cámara de Comercio, Industria y Turismo de Quepos"
      class="mb-6 h-16 w-auto opacity-90 sm:mb-8 sm:h-24"
      loading="lazy"
    />
    <p class="footer-kicker mb-2 text-[11px] font-bold uppercase tracking-[0.3em] text-[#07566b] sm:text-sm sm:tracking-[0.38em]">Cámara de Comercio de Quepos</p>
    <h2 class="footer-display text-[clamp(2.15rem,10vw,3.8rem)] font-black uppercase leading-[0.98] tracking-[-0.04em] text-[#07566b] sm:text-5xl md:text-6xl">Mantente en contacto</h2>
    <p class="footer-description mt-4 max-w-[20rem] text-base font-semibold leading-relaxed text-[#07566b] sm:max-w-lg sm:text-lg">
      Recibe noticias, oportunidades y experiencias de nuestro destino.
    </p>

    <div class="mt-7 flex items-center gap-4 sm:mt-8">
      <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="footer-social">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8.2h2.8l.5-3.3h-3.3V8.4c0-.9.3-1.6 1.7-1.6h1.7V4a22 22 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.3H7.2v3.3H10V22h3.5Z" /></svg>
      </a>
      <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer-social">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
      </a>
    </div>

    <nav class="mt-9 flex max-w-[19rem] flex-wrap justify-center gap-x-7 gap-y-3 text-xs font-bold uppercase tracking-[0.2em] sm:mt-10 sm:max-w-none sm:gap-x-10 sm:text-sm" aria-label="Enlaces secundarios">
      {links.map((link) => <a href={link.href} class="footer-link">{link.label}</a>)}
    </nav>
    <p class="footer-copyright mt-8 max-w-[18rem] text-[10px] leading-relaxed tracking-wide text-[#07566b] sm:max-w-none sm:text-xs">© {new Date().getFullYear()} Cámara de Comercio, Industria y Turismo de Quepos</p>
  </div>
</footer>

<style>
  .footer-social {
    display: flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(8 123 141 / 0.7);
    border-radius: 9999px;
    transition: background-color 180ms, color 180ms;
  }
  .footer-social:hover { background: #087b8d; color: white; }
  .footer-social svg { width: 1.1rem; height: 1.1rem; }
  .footer-kicker,
  .footer-link {
    font-weight: 800;
  }
  .footer-display {
    font-weight: 900;
  }
  .footer-description {
    font-weight: 700;
  }
  .footer-copyright {
    font-weight: 700;
  }
  .footer-link { transition: color 180ms; }
  .footer-link:hover { color: #07566b; }
  @media (max-width: 640px) {
    footer > img {
      object-fit: cover;
      object-position: left center;
    }
    footer .footer-link { font-weight: 600; }
    .footer-social { width: 2.25rem; height: 2.25rem; }
  }
</style>
