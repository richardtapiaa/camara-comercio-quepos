---
import { Image } from "astro:assets";
import fondo from "../../assets/imagenes/seccion-checkout.jpg";
import MisionScripts from "../Scripts/home/MisionScripts.astro";
---

<section id="visitors" class="relative isolate flex min-h-[32rem] sm:min-h-[80svh] items-end justify-center overflow-hidden text-center text-white">
  <div class="absolute inset-0 -z-20 overflow-hidden">
    <Image
      src={fondo}
      alt="Costa de Quepos"
      class="absolute inset-x-0 -top-full h-[200%] w-full max-w-none object-cover will-change-transform"
      data-parallax-img
    />
  </div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/60 via-black/15 to-transparent"></div>

  <div class="px-6 pb-20 sm:pb-32">
    <h2 class="font-serif text-5xl font-extrabold uppercase tracking-tight drop-shadow-lg sm:text-7xl">Para Visitantes</h2>
    <p class="mx-auto mt-4 max-w-3xl text-sm font-bold uppercase tracking-wide drop-shadow-md sm:text-lg">
      Descubre lo que puedes hacer mientras visitas nuestro cantón
    </p>
    <br />
    <a
      href="#visitors"
      class="mt-8 inline-block rounded-full bg-rose-500 px-8 py-3 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-rose-600"
    >
      Visitantes
    </a>
  </div>
</section>

<MisionScripts />
