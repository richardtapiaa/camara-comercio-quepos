---
import ObjetivosCards from "../ReactComponentes/INICIO/ObjetivosCards.tsx";

const objetivos = [
  { letra: "A", texto: "Ser reconocido por todos los actores del cantón como el ente coordinador para el desarrollo socioeconómico del cantón de Quepos." },
  { letra: "B", texto: "Buscar el mayor nivel de consenso mediante el diálogo con los sectores de toda la sociedad." },
  { letra: "C", texto: "Apoyar la toma de decisiones del gobierno local para un mayor desarrollo socioeconómico." },
  { letra: "D", texto: "Ser la organización no gubernamental con la mayor cantidad de afiliados en el cantón." },
  { letra: "E", texto: "Promover al cantón a nivel nacional e internacional." },
  { letra: "F", texto: "Mejorar las aptitudes y actitudes de todas las personas del cantón para hacer sentir a nuestros visitantes como en casa." },
  { letra: "G", texto: "Ser percibido por todas las personas como el ente que promueve su desarrollo humano." },
  { letra: "H", texto: "Fomentar en toda la sociedad la armonía con la naturaleza y el desarrollo sostenible." },
  { letra: "I", texto: "Apoyar las iniciativas que vengan a reducir las brechas sociales en el cantón." },
];
---

<!-- Panel que se desliza por encima de Visión (que queda fijo detrás) -->
<section id="objetivos" class="panel relative z-10 min-h-screen rounded-t-[40px] bg-[#E8F4FA] py-20 shadow-[0_-20px_50px_rgba(0,0,0,0.35)] sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <header class="mx-auto max-w-2xl text-center">
     
      <h2 class="mt-3 font-serif text-3xl font-bold uppercase tracking-tight text-neutral-700 sm:text-4xl">Beneficios para el afiliado</h2>
      
    </header>

  </div>

  <!-- Ocupa todo el ancho (fuera del max-w) para que se vean las tarjetas de los lados, como en el demo -->
  <div class="flex h-screen w-full items-center justify-center">
    <ObjetivosCards client:visible objetivos={objetivos} />
  </div>

</section>
