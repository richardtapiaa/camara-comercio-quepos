---
import { Image } from "astro:assets";
import fondo from "../../assets/imagenes/quepos-hero.webp";

---

<section id="hero" class="relative isolate flex min-h-svh items-start overflow-hidden text-white">
  <Image
    src={fondo}
    alt="Playa de Quepos, Costa Rica"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-bottom"
    loading="eager"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/65 via-black/35 via-45% to-transparent to-65%"></div>

  <div class="mx-auto w-full max-w-7xl px-6 pt-28 pb-20 sm:pt-32">
    <div class="max-w-2xl drop-shadow-[0_2px_6px_rgba(0,0,0,0.5)] lg:ml-auto lg:max-w-xl xl:max-w-2xl">
      <p class="text-lg font-light tracking-wide sm:text-2xl">Cámara de Comercio, Industria y Turismo</p>
      <h1 class="mt-3 font-serif text-4xl font-bold uppercase leading-tight tracking-wider sm:text-5xl xl:text-6xl">
        Impulsando el desarrollo de Quepos
      </h1>
      <p class="mt-4 text-base text-white/95 sm:text-lg">Juntos construimos un destino sostenible, competitivo y lleno de oportunidades.</p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a href="#unete" class="bg-sky-600 px-8 py-3 text-sm font-semibold uppercase tracking-wider text-white transition-colors hover:bg-sky-700">
          Únete
        </a>
        <a href="#mision" class="border border-white px-8 py-3 text-sm font-semibold uppercase tracking-wider text-white transition-colors hover:bg-white hover:text-slate-900">
          Conoce la Cámara
        </a>
      </div>
    </div>
  </div>
  <svg
    class="pointer-events-none absolute inset-x-0 -bottom-px h-10 w-full sm:h-14 lg:h-16"
    viewBox="0 0 1440 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path fill="#BFD2D9" fill-opacity="0.45" d="M0 40C180 90 360 0 600 30S1020 95 1200 55C1320 28 1400 40 1440 50V100H0Z"></path>
    <path fill="#BFD2D9" d="M0 62C200 100 420 28 680 58S1140 100 1440 60V100H0Z"></path>
  </svg>
</section>
