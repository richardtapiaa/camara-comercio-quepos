---
import fondo from "../../assets/quepos/quepos-foto.webp";
import videoHero from "../../assets/inicio/hero-quepos-inicio.mp4";
import "../../styles/home/hero.css";
---

<!-- Queda fijo mientras Misión se desliza por encima: escritorio con ScrollTrigger (scripts/home/paneles.ts), móvil con sticky nativo (sin saltos).
     Mide toda la pantalla en todos los tamaños (antes, desde md, tomaba la proporción 1920/1000 del video y quedaba
     más bajo que la ventana, así que Misión se asomaba abajo); el video la llena con object-cover -->
<section id="hero" data-end-pin="#mision" data-pin-desktop class="panel pinned sticky top-0 isolate md:relative h-svh w-full overflow-hidden bg-black">
  <video
    src={videoHero}
    poster={fondo.src}
    class="absolute inset-0 -z-20 h-full w-full object-cover object-left-bottom"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  ></video>
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-48 bg-gradient-to-b from-black/50 to-transparent"></div>
  <!-- Se oscurece al hacer scroll, mientras Misión se desliza por encima -->
  <div class="pointer-events-none absolute inset-0 bg-black opacity-0" data-hero-oscuro aria-hidden="true"></div>
</section>

<script src="../../scripts/home/hero.ts"></script>
