---
import PortadaConRecorte from "../compartidos/PortadaConRecorte.astro";
import fondo from "../../assets/inicio/hero-quepos-inicio-poster.webp";
import fondoVertical from "../../assets/inicio/hero-quepos-inicio-poster-celular.webp";
import videoHero from "../../assets/inicio/hero-quepos-inicio.mp4";
import videoHeroWebm from "../../assets/inicio/hero-quepos-inicio.webm";
import videoHeroMovil from "../../assets/inicio/hero-quepos-inicio-movil.mp4";
import videoHeroMovilWebm from "../../assets/inicio/hero-quepos-inicio-movil.webm";
import videoHeroVertical from "../../assets/inicio/hero-quepos-inicio-vertical.mp4";
import videoHeroVerticalWebm from "../../assets/inicio/hero-quepos-inicio-vertical.webm";
import "../../styles/home/hero.css";

const PANTALLA_VERTICAL = "(max-aspect-ratio: 4/5)";
const PANTALLA_PEQUENA = "(max-width: 767px)";
---

<section id="hero" data-end-pin="#mision" data-pin-desktop class="panel pinned sticky top-0 isolate md:relative h-svh w-full overflow-hidden bg-black">
  <PortadaConRecorte
    foto={fondo}
    recorte={fondoVertical}
    anchos={[800, 1280, 1920]}
    calidad={50}
    sizes="max(100vw, 192vh)"
    mediaRecorte={PANTALLA_VERTICAL}
    alt=""
    class="absolute inset-0 -z-30 h-full w-full object-cover object-left-bottom"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    aria-hidden="true"
  />
  <video
    data-video-diferido
    class="absolute inset-0 -z-20 h-full w-full object-cover object-left-bottom"
    muted
    loop
    playsinline
    disablepictureinpicture
    disableRemotePlayback
    preload="none"
    aria-hidden="true"
  >
    <source src={videoHeroVerticalWebm} type='video/webm; codecs="av01.0.05M.08"' media={PANTALLA_VERTICAL} />
    <source src={videoHeroVertical} type="video/mp4" media={PANTALLA_VERTICAL} />
    <source src={videoHeroMovilWebm} type='video/webm; codecs="av01.0.05M.08"' media={PANTALLA_PEQUENA} />
    <source src={videoHeroMovil} type="video/mp4" media={PANTALLA_PEQUENA} />
    <source src={videoHeroWebm} type='video/webm; codecs="av01.0.08M.08"' />
    <source src={videoHero} type="video/mp4" />
  </video>
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-48 bg-gradient-to-b from-black/50 to-transparent"></div>

  <div class="pointer-events-none absolute inset-0 bg-black opacity-0" data-hero-oscuro aria-hidden="true"></div>

  <h1 class="sr-only">Cámara de Comercio, Industria y Turismo de Quepos</h1>
</section>

<script src="../../scripts/home/hero.ts"></script>
