---
import { Picture } from "astro:assets";
import fondo from "../../assets/inicio/hero-quepos-inicio-poster.jpg";
import videoHero from "../../assets/inicio/hero-quepos-inicio.mp4";
import videoHeroMovil from "../../assets/inicio/hero-quepos-inicio-movil.mp4";
import videoHeroWebm from "../../assets/inicio/hero-quepos-inicio.webm";
import videoHeroMovilWebm from "../../assets/inicio/hero-quepos-inicio-movil.webm";
import "../../styles/home/hero.css";

---

<section id="hero" data-end-pin="#mision" data-pin-desktop class="panel pinned sticky top-0 isolate md:relative h-svh w-full overflow-hidden bg-black">
  <!-- El primer cuadro del video como imagen normal debajo del video (en vez de su póster): carga de inmediato con
       prioridad alta y cuenta como LCP, que un póster no. El video se ve encima cuando empieza a reproducirse -->
  <Picture
    src={fondo}
    formats={["avif", "webp"]}
    widths={[800, 1280, 1920]}
    sizes="max(100vw, 192vh)"
    quality={50}
    alt=""
    class="absolute inset-0 -z-30 h-full w-full object-cover object-left-bottom"
    loading="eager"
    fetchpriority="high"
    aria-hidden="true"
  />
  <!-- data-video-diferido: empieza a descargarse cuando la página terminó de cargar (scripts/compartido/videos.ts) -->
  <video
    data-video-diferido
    class="absolute inset-0 -z-20 h-full w-full object-cover object-left-bottom"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
  >
    <source src={videoHeroMovilWebm} type='video/webm; codecs="av01.0.05M.08"' media="(max-width: 767px)" />
    <source src={videoHeroMovil} type="video/mp4" media="(max-width: 767px)" />
    <source src={videoHeroWebm} type='video/webm; codecs="av01.0.08M.08"' />
    <source src={videoHero} type="video/mp4" />
  </video>
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-48 bg-gradient-to-b from-black/50 to-transparent"></div>

  <div class="pointer-events-none absolute inset-0 bg-black opacity-0" data-hero-oscuro aria-hidden="true"></div>

  <h1 class="sr-only">Cámara de Comercio, Industria y Turismo de Quepos</h1>
</section>

<script src="../../scripts/home/hero.ts"></script>
