---
import logo from "../../assets/imagenes/logo-camara.webp";
---

<!-- isolate: Leaflet usa z-index de 400 a 1000 en sus capas; así quedan contenidas en el mapa
     y no se dibujan encima del Navbar (z-50) ni de su menú móvil -->
<section id="mapa" aria-label="Mapa de Quepos" class="isolate">
  <div
    id="mapa-quepos"
    class="h-[500px] w-full bg-slate-900"
    data-lat="9.4246"
    data-lng="-84.1698"
    data-zoom="15"
    data-title="Quepos"
    data-logo={logo.src}
  >
  </div>
</section>

<style is:global>
  #mapa-quepos .leaflet-popup-content-wrapper {
    border-radius: 14px;
    padding: 0;
    text-align: center;
  }
  #mapa-quepos .leaflet-popup-content {
    margin: 12px 14px 14px;
  }
  #mapa-quepos .mapa-popup-title {
    margin: 0 0 10px;
    font-family: var(--font-serif, serif);
    font-size: 1.4rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #2f9bdc;
  }
  #mapa-quepos .mapa-popup-logo {
    display: block;
    width: 96px;
    height: auto;
    margin: 0 auto;
  }
</style>

<script>
  const el = document.getElementById("mapa-quepos");

  // Leaflet (JS, CSS e íconos del marcador) se descarga recién aquí, cuando el mapa está por verse: antes iba en el
  // bundle de todas las páginas (unos 150 KB de JS y su CSS bloqueaba el primer dibujo) aunque el mapa está al final
  const init = async (el: HTMLElement) => {
    const [{ default: L }, { default: markerIcon }, { default: markerIcon2x }, { default: markerShadow }] =
      await Promise.all([
        import("leaflet"),
        import("leaflet/dist/images/marker-icon.png"),
        import("leaflet/dist/images/marker-icon-2x.png"),
        import("leaflet/dist/images/marker-shadow.png"),
        import("leaflet/dist/leaflet.css"),
      ]);

    const lat = Number(el.dataset.lat);
    const lng = Number(el.dataset.lng);

    const map = L.map(el, {
      center: [lat, lng],
      zoom: Number(el.dataset.zoom),
      minZoom: 0,
      maxZoom: 18,
      zoomControl: false,
      scrollWheelZoom: false,
      doubleClickZoom: false,
      touchZoom: false,
      boxZoom: false,
      keyboard: false,
      dragging: false,
    });

    L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", {
      maxZoom: 18,
      attribution:
        "© <a href='https://www.esri.com/'>Esri</a> | DigitalGlobe, GeoEye, i-cubed, USDA, USGS, AEX, Getmapping, Aerogrid, IGN, IGP, swisstopo, and the GIS User Community",
    }).addTo(map);

    const icon = L.icon({
      iconUrl: markerIcon.src,
      iconRetinaUrl: markerIcon2x.src,
      shadowUrl: markerShadow.src,
      iconSize: [25, 41],
      iconAnchor: [12, 41],
      popupAnchor: [1, -34],
      shadowSize: [41, 41],
    });

    const content = document.createElement("div");
    const title = document.createElement("h3");
    title.className = "mapa-popup-title";
    title.textContent = el.dataset.title ?? "";
    const img = document.createElement("img");
    img.className = "mapa-popup-logo";
    img.src = el.dataset.logo ?? "";
    img.alt = el.dataset.title ?? "";
    content.append(title, img);

    L.marker([lat, lng], { icon, title: el.dataset.title }).addTo(map).bindPopup(content, { autoClose: false, closeOnClick: false }).openPopup();
  };

  // Carga diferida: solo se descarga e inicia cuando el mapa está cerca de verse
  if (el) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        observer.disconnect();
        init(el);
      },
      { rootMargin: "600px" },
    );
    observer.observe(el);
  }
</script>
