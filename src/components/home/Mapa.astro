---
import logo from "../../assets/compartido/logo-camara.webp";
import "../../styles/home/mapa.css";
---

<section id="mapa" aria-label="Mapa de Quepos" class="isolate">
  <div
    id="mapa-quepos"
    class="h-[500px] w-full bg-slate-900"
    data-lat="9.4246"
    data-lng="-84.1698"
    data-zoom="15"
    data-title="Quepos"
    data-logo={logo.src}
  >
  </div>
</section>

<script src="../../scripts/home/mapa.ts"></script>
