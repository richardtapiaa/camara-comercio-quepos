---
import { InfiniteRibbon } from "../ReactComponentes/Home/Lazo";
import "../../styles/compartido/etiqueta-papel.css";

const frasesCamara = [
  "Cámara de Comercio, Industria y Turismo de Quepos",
  "Comercio",
  "Industria",
  "Turismo",
  "Quepos, Costa Rica",
];

const frasesAfiliados = [
  "Afíliese y crezca con nosotros",
  "Desarrollo socioeconómico del cantón",
  "Capacitaciones para su empresa",
  "Una red de empresas locales",
  "Juntos por Quepos",
];

const claseCinta =
  "-mx-[10%] w-[120%] max-w-none py-3 font-['Anton','Impact','Arial_Narrow',sans-serif] text-2xl uppercase tracking-wide shadow-[0_10px_30px_-12px_rgba(16,42,67,0.5)] sm:py-4 sm:text-3xl";
---

<section aria-label="La Cámara de Comercio de Quepos" class="relative z-10 overflow-x-clip bg-white py-14 md:py-20 xl:py-28">
  <div class="relative grid place-items-center">
    <InfiniteRibbon
      rotation={5}
      reverse
      duration={40}
      repeat={3}
      className={`${claseCinta} col-start-1 row-start-1 bg-[#2b4a5c] text-white`}
    >
      {frasesAfiliados.map((frase) => (
        <>
          {frase}
          <span class="mx-6 text-[#f1dcbc]" aria-hidden="true">✦</span>
        </>
      ))}
    </InfiniteRibbon>

    <InfiniteRibbon
      rotation={-5}
      duration={35}
      repeat={3}
      className={`${claseCinta} relative col-start-1 row-start-1 bg-[#f1dcbc] text-[#2b4a5c]`}
    >
      {frasesCamara.map((frase) => (
        <>
          {frase}
          <span class="mx-6 text-[#2780c9]" aria-hidden="true">✦</span>
        </>
      ))}
    </InfiniteRibbon>
  </div>
</section>
