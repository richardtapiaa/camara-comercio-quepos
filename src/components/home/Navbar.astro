---
import { Image } from "astro:assets";
import logo from "../../assets/imagenes/logo-camara.webp";
import NavbarScripts from "../Scripts/home/NavbarScripts.astro";

const links = [
  { label: "La Cámara", href: "/" },
  { label: "Quepos", href: "/quepos" },
  { label: "Únete", href: "#unete" },
  { label: "Contacto", href: "#contacto" },
  { label: "Bolsa De Empleo", href: "#bolsa-de-empleo" },
];


const contacto = {
  email: "info@camaraquepos.com",
  telefono: "+506 2774-9130",
  facebook: "https://www.facebook.com/CCITQuepos",
  instagram: "https://www.instagram.com/camaradequepos",
};
---

<header
  id="site-header"
  data-solid="false"
  class="group/nav fixed inset-x-0 top-0 z-50 w-full rounded-b-[32px] transition-all duration-300 data-[solid=false]:bg-gradient-to-b data-[solid=false]:from-black/50 data-[solid=false]:to-transparent data-[solid=true]:bg-white data-[solid=true]:shadow-md data-[hidden=true]:-translate-y-full"
>
  <div class="grid grid-rows-[1fr] opacity-100 transition-[grid-template-rows,opacity] duration-500 ease-in-out group-data-[solid=true]/nav:grid-rows-[0fr] group-data-[solid=true]/nav:opacity-0">
    <div class="overflow-hidden border-b border-white/40 group-data-[solid=true]/nav:border-transparent">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-6 gap-y-1 px-6 py-2 text-xs font-medium text-white sm:justify-start sm:text-sm">
      <a href={`mailto:${contacto.email}`} class="inline-flex items-center gap-2 transition-colors hover:text-sky-200">
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
        {contacto.email}
      </a>
      <a href={`tel:${contacto.telefono.replace(/[^+\d]/g, "")}`} class="inline-flex items-center gap-2 transition-colors hover:text-sky-200">
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path>
        </svg>
        {contacto.telefono}
      </a>
      <div class="flex items-center gap-4 sm:ml-auto">
        <a href={contacto.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="transition-colors hover:text-sky-200">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 22v-8.2h2.8l.5-3.3h-3.3V8.4c0-.9.3-1.6 1.7-1.6h1.7V4a22 22 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.3H7.2v3.3H10V22h3.5Z"></path>
          </svg>
        </a>
        <a href={contacto.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="transition-colors hover:text-sky-200">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      </div>
    </div>
    </div>
  </div>

  <nav class="mx-auto flex h-24 max-w-7xl items-center gap-6 px-6" aria-label="Principal">
    <a href="/" class="shrink-0" aria-label="Cámara de Comercio, Industria y Turismo de Quepos">
      <Image src={logo} alt="Cámara de Comercio, Industria y Turismo - Quepos Costa Rica" class="h-23 w-auto" loading="eager" />
    </a>

    <button
      id="nav-toggle"
      type="button"
      class="ml-auto rounded-xl p-2 text-slate-700 group-data-[solid=false]/nav:text-white md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <div
      id="nav-menu"
      class="absolute inset-x-0 top-full hidden flex-col gap-4 rounded-b-[32px] bg-white px-6 py-4 shadow-md md:static md:ml-10 md:flex md:flex-1 md:flex-row md:items-center md:gap-10 md:rounded-none md:bg-transparent md:p-0 md:shadow-none"
    >
      <ul class="flex flex-col gap-4 md:flex-row md:items-center md:gap-10">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="text-[15px] font-medium text-slate-800 transition-colors hover:text-sky-700 md:group-data-[solid=false]/nav:text-white md:group-data-[solid=false]/nav:hover:text-sky-200">
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="relative" data-nav-dropdown>
          <button
            type="button"
            data-nav-dropdown-toggle
            class="flex items-center gap-1 text-[15px] font-medium text-slate-800 transition-colors hover:text-sky-700 md:group-data-[solid=false]/nav:text-white md:group-data-[solid=false]/nav:hover:text-sky-200"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="visitors-submenu"
          >
            Visitors
            <svg class="h-4 w-4 transition-transform duration-200" data-nav-dropdown-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <ul
            id="visitors-submenu"
            data-nav-dropdown-menu
            class="absolute left-0 top-full z-10 mt-3 hidden min-w-44 rounded-xl bg-white p-2 text-slate-800 shadow-lg ring-1 ring-black/5"
          >
            <li>
              <a href="/visitors/" class="block rounded-lg px-3 py-2 text-sm transition-colors hover:bg-[#f4efe9] hover:text-sky-700">Visitors</a>
            </li>
            <li>
              <a href="/hotels/" class="block rounded-lg px-3 py-2 text-sm transition-colors hover:bg-[#f4efe9] hover:text-sky-700">Hotels</a>
            </li>
            <li>
              <a href="/activities/" class="block rounded-lg px-3 py-2 text-sm transition-colors hover:bg-[#f4efe9] hover:text-sky-700">Activities</a>
            </li>
          </ul>
        </li>
      </ul>

      <!-- Buscar Formulario -->
      <form role="search" action="/buscar" class="flex items-center gap-3 text-slate-600 md:ml-4 md:group-data-[solid=false]/nav:text-white">
        <button type="submit" aria-label="Buscar" class="shrink-0 rounded-full bg-white/90 px-2.5 py-1.5 shadow-sm">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </button>
        <input
          type="search"
          name="q"
          placeholder="Buscar"
          aria-label="Buscar"
          class="w-32 bg-transparent text-[15px] text-slate-700 placeholder:text-slate-600 md:group-data-[solid=false]/nav:placeholder:text-white/80 focus:outline-none"
        />
      </form>
    </div>
  </nav>
</header>


<NavbarScripts />
