---
import { Picture } from "astro:assets";
// Copias del logo sin el margen transparente de alrededor, para que en la barra el dibujo se vea más grande
import logoNav from "../../assets/compartido/logo-camara-nav.webp";
import logoBlanco from "../../assets/compartido/logo-camara-blanco-nav.webp";
import { contacto } from "../../lib/sitio";

type Enlace = { label: string; href: string };
type Desplegable = { label: string; id: string; submenu: Enlace[] };

const links: Array<Enlace | Desplegable> = [
  {
    label: "La Cámara",
    id: "camara-submenu",
    submenu: [
      { label: "Inicio", href: "/" },
      { label: "Afiliados", href: "/afiliados" },
      { label: "Mapa de afiliados", href: "/mapa-afiliados" },
      { label: "Capacitaciones", href: "/capacitaciones" },
      { label: "Noticias", href: "/noticias" },
    ],
  },
  {
    label: "Cantón Quepos",
    id: "quepos-submenu",
    submenu: [
      { label: "Quepos", href: "/quepos" },
      { label: "Savegre", href: "/savegre" },
      { label: "Hospitalidad & Gastronomía", href: "/hospitalidad" },
      { label: "Visítenos", href: "/visitenos" },
      { label: "Galería", href: "/queposgaleria" },
    ],
  },
  { label: "Únete", href: "/unete" },
  { label: "Contacto", href: "/contacto" },
  { label: "Bolsa De Empleo", href: "/bolsa-de-empleo" },
];

// Página actual: se compara la ruta sin la barra final. "Inicio" (/) solo cuenta en la portada; los demás también
// en sus subpáginas (por ejemplo /noticias/algo marca "Noticias").
const rutaActual = Astro.url.pathname.replace(/\/+$/, "") || "/";
const esActual = (href: string) =>
  href === "/" ? rutaActual === "/" : rutaActual === href || rutaActual.startsWith(`${href}/`);
const desplegableActual = (link: Desplegable) => link.submenu.some((sub) => esActual(sub.href));

// Rayita bajo el enlace de la página actual (en escritorio); hereda el color del texto, así que es oscura sobre
// la barra blanca y blanca sobre el Hero. En el menú de celular (letras azul claro), el enlace actual va en blanco
// con una barrita en el azul de la Cámara.
const claseActual =
  "lg:relative lg:after:absolute lg:after:inset-x-0 lg:after:bottom-1 lg:after:h-0.5 lg:after:rounded-full lg:after:bg-current max-lg:relative max-lg:text-white! max-lg:before:absolute max-lg:before:inset-y-3 max-lg:before:left-0 max-lg:before:w-1 max-lg:before:rounded-r-full max-lg:before:bg-[#2780c9]";

const claseLink =
  "text-[15px] font-medium text-slate-800 transition-colors hover:text-sky-700 lg:py-3 max-lg:px-6 max-lg:py-3.5 max-lg:uppercase max-lg:tracking-[0.12em] max-lg:text-[#9fd0f5] max-lg:hover:text-white lg:group-data-[solid=false]/nav:text-white lg:group-data-[solid=false]/nav:hover:text-sky-200";
---

<header
  id="site-header"
  data-solid="false"
  class="group/nav fixed inset-x-0 top-0 z-50 w-full rounded-b-[32px] transition-[background-color,box-shadow,translate] duration-300 data-[solid=false]:bg-gradient-to-b data-[solid=false]:from-black/50 data-[solid=false]:to-transparent data-[solid=true]:shadow-[0_1px_0_rgb(15_23_42/0.06),0_10px_30px_-14px_rgb(15_23_42/0.18)] data-[hidden=true]:-translate-y-full"
>
  <!-- Fondo de vidrio al bajar por la página: blanco translúcido con desenfoque. Va en una capa aparte y no en el
       header porque el desenfoque en el header encerraría dentro de él al menú de celular (que es fixed). -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 rounded-b-[32px] border-b border-slate-900/5 bg-white/80 opacity-0 backdrop-blur-xl backdrop-saturate-150 transition-opacity duration-300 group-data-[solid=true]/nav:opacity-100 supports-[not(backdrop-filter:blur(1px))]:bg-white"
    aria-hidden="true"
  ></div>
  <div class="grid grid-rows-[1fr] opacity-100 transition-[grid-template-rows,opacity] duration-500 ease-in-out group-data-[solid=true]/nav:grid-rows-[0fr] group-data-[solid=true]/nav:opacity-0">
    <div class="overflow-hidden border-b border-white/40 group-data-[solid=true]/nav:border-transparent">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-6 gap-y-2 px-6 py-2 text-xs font-medium text-white sm:justify-start sm:text-sm">
      <a href={`mailto:${contacto.email}`} class="-my-1 inline-flex items-center gap-2 py-1 transition-colors hover:text-sky-200">
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
        {contacto.email}
      </a>
      <a href={`tel:${contacto.telefono.replace(/[^+\d]/g, "")}`} class="-my-1 inline-flex items-center gap-2 py-1 transition-colors hover:text-sky-200">
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path>
        </svg>
        {contacto.telefono}
      </a>
      <div class="flex items-center gap-4 sm:ml-auto">
        <a href={contacto.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="-m-1 p-1 transition-colors hover:text-sky-200">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 22v-8.2h2.8l.5-3.3h-3.3V8.4c0-.9.3-1.6 1.7-1.6h1.7V4a22 22 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.3H7.2v3.3H10V22h3.5Z"></path>
          </svg>
        </a>
        <a href={contacto.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="-m-1 p-1 transition-colors hover:text-sky-200">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      </div>
    </div>
    </div>
  </div>

  <nav class="mx-auto flex h-24 max-w-7xl items-center gap-6 px-6 transition-[height] duration-300 ease-out group-data-[solid=true]/nav:h-20" aria-label="Principal">
    <a href="/" class="relative shrink-0" aria-label="Cámara de Comercio, Industria y Turismo de Quepos">
      <Picture
        src={logoNav}
        formats={["avif", "webp"]}
        quality={60}
        alt="Cámara de Comercio, Industria y Turismo - Quepos Costa Rica"
        widths={[200, 300, 400]}
        sizes="200px"
        class="h-23 w-auto transition-[height,opacity] duration-300 ease-out group-data-[solid=false]/nav:opacity-0 group-data-[solid=true]/nav:h-18"
        loading="eager"
      />
      <Picture
        src={logoBlanco}
        formats={["avif", "webp"]}
        quality={60}
        alt=""
        widths={[200, 300, 400]}
        sizes="200px"
        class="pointer-events-none absolute inset-0 h-23 w-auto opacity-0 transition-[height,opacity] duration-300 ease-out group-data-[solid=false]/nav:opacity-100 group-data-[solid=true]/nav:h-18"
        loading="eager"
        fetchpriority="high"
        aria-hidden="true"
      />
    </a>

    <button
      id="nav-toggle"
      type="button"
      class="ml-auto rounded-xl p-2.5 text-slate-700 group-data-[solid=false]/nav:text-white lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <div id="nav-overlay" class="invisible fixed inset-0 z-[55] touch-none bg-black/60 opacity-0 lg:hidden" aria-hidden="true"></div>

    <div
      id="nav-menu"
      data-lenis-prevent
      class="invisible fixed inset-y-0 right-0 z-[60] flex h-dvh w-[86%] max-w-sm flex-col overflow-y-auto overscroll-contain bg-[#1c1c1e] text-white shadow-2xl lg:visible lg:static lg:ml-10 lg:h-auto lg:w-auto lg:max-w-none lg:flex-1 lg:flex-row lg:items-center lg:justify-end lg:gap-10 lg:overflow-visible lg:bg-transparent lg:p-0 lg:text-inherit lg:shadow-none"
    >
      <div class="flex items-center justify-between px-6 pb-3 pt-4 lg:hidden">
        <a href="/" class="-m-1 rounded-xl p-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60" aria-label="Cámara de Comercio, Industria y Turismo de Quepos">
          <Picture src={logoBlanco} formats={["avif", "webp"]} quality={60} alt="Cámara de Comercio, Industria y Turismo - Quepos Costa Rica" widths={[200, 400]} sizes="130px" class="h-15 w-auto" loading="lazy" />
        </a>
        <button id="nav-close" type="button" aria-label="Cerrar menú" class="rounded-full p-2.5 text-white/70 transition-colors hover:text-white">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>

      <ul class="flex flex-col gap-4 max-lg:gap-0 max-lg:border-t max-lg:border-white/10 lg:flex-row lg:items-center lg:gap-10">
        {
          links.map((link) =>
            "submenu" in link ? (
              <li class="relative max-lg:border-b max-lg:border-white/10" data-nav-dropdown>
                <button
                  type="button"
                  data-nav-dropdown-toggle
                  class={`flex items-center gap-1 max-lg:w-full max-lg:justify-between ${claseLink} ${desplegableActual(link) ? claseActual : ""}`}
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls={link.id}
                >
                  {link.label}
                  <svg class="h-4 w-4 transition-transform duration-200" data-nav-dropdown-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </button>
                <ul
                  id={link.id}
                  data-nav-dropdown-menu
                  class="absolute left-0 top-full z-10 mt-3 hidden min-w-44 rounded-xl bg-white p-2 text-slate-800 shadow-lg ring-1 ring-black/5 max-lg:static max-lg:mt-0 max-lg:min-w-0 max-lg:overflow-hidden max-lg:rounded-none max-lg:bg-black/20 max-lg:px-6 max-lg:py-0 max-lg:text-white max-lg:shadow-none max-lg:ring-0"
                >
                  {link.submenu.map((sub) => (
                    <li>
                      <a
                        href={sub.href}
                        aria-current={esActual(sub.href) ? "page" : undefined}
                        class="block whitespace-nowrap rounded-lg px-3 py-2 text-sm transition-colors hover:bg-[#f4efe9] hover:text-sky-700 aria-[current=page]:bg-[#f4efe9] aria-[current=page]:font-semibold aria-[current=page]:text-sky-700 max-lg:px-0 max-lg:py-3 max-lg:text-[#9fd0f5]/80 max-lg:hover:bg-transparent max-lg:hover:text-white max-lg:aria-[current=page]:bg-transparent max-lg:aria-[current=page]:text-white"
                      >
                        {sub.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="max-lg:border-b max-lg:border-white/10">
                <a href={link.href} aria-current={esActual(link.href) ? "page" : undefined} class={`max-lg:block ${claseLink} ${esActual(link.href) ? claseActual : ""}`}>
                  {link.label}
                </a>
              </li>
            )
          )
        }
      </ul>

      <!-- Pie del panel (solo celular): botón para afiliarse, contacto con íconos y redes sociales -->
      <div class="mt-auto flex flex-col gap-4 px-6 pb-6 pt-5 lg:hidden">
        <a
          href="/unete"
          class="flex h-12 items-center justify-center gap-2 rounded-full bg-white text-[15px] font-semibold text-[#1c1c1e] transition-colors hover:bg-sky-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300 focus-visible:ring-offset-2 focus-visible:ring-offset-[#1c1c1e]"
        >
          Afíliate a la Cámara
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>

        <div class="flex flex-col border-t border-white/10 pt-3 text-sm text-white/75">
          <a href={`mailto:${contacto.email}`} class="flex items-center gap-3 py-1.5 transition-colors hover:text-white">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-white/10" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>
            </span>
            {contacto.email}
          </a>
          <a href={`tel:${contacto.telefono.replace(/[^+\d]/g, "")}`} class="flex items-center gap-3 py-1.5 transition-colors hover:text-white">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-white/10" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path>
              </svg>
            </span>
            {contacto.telefono}
          </a>
        </div>

        <div class="flex items-center gap-3">
          <a href={contacto.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex size-11 items-center justify-center rounded-full bg-white/10 text-white/80 transition-colors hover:bg-white/20 hover:text-white">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13.5 22v-8.2h2.8l.5-3.3h-3.3V8.4c0-.9.3-1.6 1.7-1.6h1.7V4a22 22 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.3H7.2v3.3H10V22h3.5Z"></path>
            </svg>
          </a>
          <a href={contacto.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex size-11 items-center justify-center rounded-full bg-white/10 text-white/80 transition-colors hover:bg-white/20 hover:text-white">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script src="../../scripts/home/navbar.ts"></script>
