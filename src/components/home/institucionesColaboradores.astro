---
import { MarqueeColaboradores } from "../ReactComponentes/Home/MarqueeColaboradores";
import canatur from "../../assets/inicio/colaboradores/canatur-logo.webp";
import ict from "../../assets/inicio/colaboradores/ict-logo.webp";
import ina from "../../assets/inicio/colaboradores/ina-logo.webp";
import manuelAntonio from "../../assets/inicio/colaboradores/manuel-antonio-park.webp";

const logos = [
  {
    imagen: ict,
    alt: "Instituto Costarricense de Turismo (ICT)",
    gradiente: { desde: "#d4efcb", medio: "#fff1d6", hasta: "#cfe8f7" },
  },
  {
    imagen: ina,
    alt: "Instituto Nacional de Aprendizaje (INA)",
    gradiente: { desde: "#ffe2a8", medio: "#fff6e0", hasta: "#fde3bf" },
  },
  {
    imagen: canatur,
    alt: "Cámara Nacional de Turismo (Canatur)",
    gradiente: { desde: "#c9ebcd", medio: "#eef8ef", hasta: "#f1dcbc" },
  },
  {
    imagen: manuelAntonio,
    alt: "Parque Nacional Manuel Antonio",
    gradiente: { desde: "#dcebc8", medio: "#f4f1e6", hasta: "#e6d8c3" },
  },
].map(({ imagen, alt, gradiente }) => ({ src: imagen.src, width: imagen.width, height: imagen.height, alt, gradiente }));
---

<MarqueeColaboradores
  titulo="Instituciones con las que colaboramos"
  logos={logos}
/>
