---
import ilustracion from "../../assets/inicio/mision-asociados.svg";
---

<section
  id="mision"
  aria-labelledby="titulo-mision"
  class="panel relative z-10 overflow-x-clip rounded-t-[40px] bg-white px-6 pb-12 pt-20 shadow-[0_-25px_40px_-25px_rgba(0,0,0,0.45),0_1px_0_#fff] sm:px-10 sm:pb-16 sm:pt-24"
>
  <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2 lg:gap-20">
    <div>
      <h2
        id="titulo-mision"
        class="mt-2 text-2xl font-semibold text-slate-900 sm:text-3xl"
      >
        Misión
      </h2>
      <p class="mt-5 text-lg font-medium leading-relaxed text-slate-800 sm:text-xl">
        La Misión de la <strong class="font-semibold text-slate-900">Cámara de Comercio, Industria y Turismo de Quepos</strong> es fomentar el
        desarrollo socioeconómico del cantón.
      </p>
    </div>

    <img
      src={ilustracion.src}
      width={ilustracion.width}
      height={ilustracion.height}
      alt="Asociados de la Cámara de Comercio de Quepos trabajando juntos"
      class="mx-auto h-auto w-full max-w-xs sm:max-w-sm md:max-w-md"
      loading="lazy"
    />
  </div>
</section>
