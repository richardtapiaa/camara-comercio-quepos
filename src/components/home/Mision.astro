---
import { Image } from "astro:assets";
import imagen from "../../assets/imagenes/mision-seccion.jpg";
import panoramica from "../../assets/imagenes/fondo-inicio-queposx.webp";
import MisionScripts from "../Scripts/home/MisionScripts.astro";

const marco = "relative overflow-hidden";
const parallax = "absolute inset-x-0 -top-full h-[200%] w-full max-w-none object-cover will-change-transform";
---

<!-- Panel que se desliza por encima del Hero (fijo detrás). La sombra no se sale por abajo (spread negativo) -->
<section id="mision" class="panel relative z-10 flex min-h-svh flex-col justify-center overflow-x-clip rounded-t-[40px] bg-[#E8F4FA] py-16 shadow-[0_-25px_40px_-25px_rgba(0,0,0,0.45)] sm:py-24">
  <div class="mx-auto grid w-full max-w-6xl items-center gap-10 px-6 md:grid-cols-12 md:gap-y-16">
    <!-- Sale del contenedor hasta el borde derecho de la pantalla -->
    <div class={`${marco} -mr-[calc(max(0px,(100vw_-_72rem)/2)+1.5rem)] aspect-[16/9] rounded-l-2xl md:order-2 md:col-span-7 md:col-start-6 md:aspect-[3/1]`}>
      <Image src={panoramica} alt="Paisaje de Quepos" class={parallax} data-parallax-img />
    </div>

    <div class="md:order-1 md:col-span-5 md:col-start-1 md:pr-6">
      <span class="text-xs font-semibold uppercase tracking-[0.25em] text-neutral-500">Nuestro propósito</span>
      <h2 class="mt-3 font-serif text-5xl font-normal uppercase tracking-[0.2em] text-neutral-700 sm:text-6xl">Misión</h2>
    </div>

  
    <div class="md:order-4 md:col-span-6 md:col-start-6">
      <p class="text-base font-medium leading-relaxed text-neutral-800 sm:text-lg">
        La Misión de la <strong class="font-semibold text-neutral-900">Cámara de Comercio, Industria y Turismo de Quepos</strong> es fomentar el desarrollo socioeconómico del cantón.
      </p>
    </div>
  </div>

</section>

<MisionScripts />
