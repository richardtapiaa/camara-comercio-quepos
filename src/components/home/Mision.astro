---
import ilustracion from "../../assets/inicio/mision-asociados.svg";
import "../../styles/home/parallax-imagenes.css";

const marco = "relative overflow-hidden";
const parallax = "absolute inset-x-0 -top-full h-[200%] w-full max-w-none object-cover will-change-transform";
---

<!-- Panel que se desliza por encima del Hero (fijo detrás). La sombra no se sale por abajo (spread negativo).
     La línea de 1px de su mismo color tapa el borde inferior: el Hero (negro) termina justo ahí y con
     posiciones de medio pixel se asomaba como una raya entre Misión y Visión -->
<section id="mision" class="panel relative z-10 flex min-h-svh flex-col justify-center overflow-x-clip rounded-t-[40px] bg-[#E8F4FA] py-16 shadow-[0_-25px_40px_-25px_rgba(0,0,0,0.45),0_1px_0_#E8F4FA] sm:py-24">
  <div class="mx-auto grid w-full max-w-6xl items-center gap-10 px-6 md:grid-cols-12 md:gap-y-16">
    <!-- Ilustración completa (sin recorte ni parallax) -->
    <div class="flex justify-center md:order-2 md:col-span-7 md:col-start-6">
      <img
        src={ilustracion.src}
        width={ilustracion.width}
        height={ilustracion.height}
        alt="Asociados de la Cámara de Comercio de Quepos trabajando juntos"
        class="h-auto w-full max-w-sm md:max-w-md"
        loading="lazy"
      />
    </div>

    <div class="md:order-1 md:col-span-5 md:col-start-1 md:pr-6">
      <span class="text-xs font-semibold uppercase tracking-[0.25em] text-neutral-500">Nuestro propósito</span>
      <h2 class="mt-3 text-4xl font-bold uppercase leading-tight tracking-tight text-neutral-700 sm:text-5xl">Misión</h2>
    </div>

  
    <div class="md:order-4 md:col-span-6 md:col-start-6">
      <p class="text-base font-medium leading-relaxed text-neutral-800 sm:text-lg">
        La Misión de la <strong class="font-semibold text-neutral-900">Cámara de Comercio, Industria y Turismo de Quepos</strong> es fomentar el desarrollo socioeconómico del cantón.
      </p>
    </div>
  </div>

</section>

<script src="../../scripts/home/parallax-imagenes.ts"></script>
