---
import AccordionGallery from "../ReactComponentes/VisitorsComponent.jsx";
import actividad1 from "../../assets/imagenes visitors/actividades-1.jpg";
import actividad2 from "../../assets/imagenes visitors/actividades-2.jpg";
import actividad3 from "../../assets/imagenes visitors/actividades-3.jpg";
import actividad4 from "../../assets/imagenes visitors/actividades-4.jpg";
import actividad5 from "../../assets/imagenes visitors/actividades-5.jpg";
import actividad6 from "../../assets/imagenes visitors/actividades-6.jpeg";

const activities: Array<{ image: string; label: string; alt: string; link?: string }> = [
  { image: actividad1.src, label: "Wildlife exploration", alt: "Exploración de vida silvestre", link: "/activities/actividad-1/" },
  { image: actividad2.src, label: "Adventure sports", alt: "Actividades de aventura", link: "/activities/actividad-2/" },
  { image: actividad3.src, label: "Aquatic excursions", alt: "Excursiones acuáticas", link: "/activities/actividad-3/" },
  { image: actividad4.src, label: "Nature trails", alt: "Senderos naturales", link: "/activities/actividad-4/" },
  { image: actividad5.src, label: "Ocean adventures", alt: "Aventuras en el océano", link: "/activities/actividad-5/" },
  { image: actividad6.src, label: "Discover Quepos", alt: "Paisajes de Quepos", link: "/activities/actividad-6/" },
];
---

<section class="min-h-screen bg-[#f4efe9] px-6 pb-24 pt-36 text-[#403c39] sm:px-10 sm:pt-44 lg:px-16">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-3xl">
      <span class="text-xs font-semibold uppercase tracking-[0.28em] text-[#8c8078]">Explore the area</span>
      <h1 class="mt-4 font-sans text-5xl font-bold leading-[0.95] tracking-tight text-[#373330] sm:text-7xl">
        Your tour bucket list
      </h1>
      <div class="mt-6 h-1.5 w-24 rounded-full bg-gradient-to-r from-[#403c39] to-[#c8a989]"></div>
      <p class="mt-8 max-w-2xl text-base leading-8 text-[#766e68] sm:text-lg">
        The Quepos/Manuel Antonio area is bursting with opportunity to take an exciting tour, and the options are plentiful. The themes of tours can range from wildlife exploration, riveting adventure sports or aquatic excursion. The choices vary greatly and every visitor can find an activity that they will enjoy. With a little research or help from your local hosts, you can explore numerous options that will make your visit to Costa Rica an exquisite one.
      </p>
      <p class="mt-6 max-w-2xl text-base leading-8 text-[#766e68] sm:text-lg">
        Here's a list of the most popular activities in Manuel Antonio that should definitively be on your bucket list.
      </p>
    </div>

    <div class="mt-16">
      <AccordionGallery
        client:load
        items={activities}
        defaultIndex={2}
        height={460}
        gap={10}
        radius={16}
        expandRatio={0.52}
        trigger="hover"
        showLabels={true}
        grayscale={false}
        className="activities-gallery"
      />
    </div>
  </div>
</section>