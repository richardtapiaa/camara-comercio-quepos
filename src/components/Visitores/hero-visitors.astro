---
import heroImage from "../../assets/imagenes visitors/hero-visitors.jpg";
---

<section class="relative isolate h-[22rem] overflow-hidden bg-[#075b91] sm:h-[28rem] lg:h-[32rem]">
  <img
    src={heroImage.src}
    alt="Paisaje panorámico de Quepos"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    loading="eager"
  />
  <div class="absolute inset-0 -z-10 bg-[#075b91]/25" aria-hidden="true"></div>
  <div
    class="absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse at center, transparent 18%, rgba(3, 31, 52, 0.16) 52%, rgba(2, 20, 35, 0.72) 100%);"
    aria-hidden="true"
  ></div>
  <div class="absolute inset-x-0 top-1/2 z-10 -translate-y-1/2 px-6 text-center text-white sm:px-10 lg:px-16">
    <div class="mx-auto max-w-5xl">
      <span class="text-xs font-semibold uppercase tracking-[0.35em] text-sky-100">Discover our paradise</span>
      <h1 class="mt-4 font-sans text-5xl font-bold leading-none tracking-tight drop-shadow-[0_2px_8px_rgba(0,0,0,0.35)] sm:text-7xl lg:text-8xl">
        Welcome to Quepos
      </h1>
      <div class="mx-auto mt-6 h-1.5 w-24 rounded-full bg-white"></div>
    </div>
  </div>
</section>
