---
import { contacto } from "../../lib/sitio";

// Íconos de Heroicons (licencia MIT), trazo de 24×24.
const tarjetas = [
  {
    titulo: "Visítenos",
    texto: "Nuestras oficinas están en el cantón de Quepos, en la costa del Pacífico Central.",
    dato: "Quepos, Puntarenas, Costa Rica",
    enlace: undefined,
    color: "#09a5df",
    colorTexto: "#0369a1",
    icono:
      "M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z",
  },
  {
    titulo: "Llámenos",
    texto: "Con gusto le ayudamos con cualquier duda sobre la afiliación a la Cámara.",
    dato: contacto.telefono,
    enlace: `tel:${contacto.telefono.replace(/[^+\d]/g, "")}`,
    color: "#f59e0b",
    colorTexto: "#b45309",
    icono:
      "M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z",
  },
  {
    titulo: "Escríbanos",
    texto: "Envíenos sus consultas por correo y le responderemos lo antes posible.",
    dato: contacto.email,
    enlace: `mailto:${contacto.email}`,
    color: "#22c55e",
    colorTexto: "#15803d",
    icono:
      "M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75",
  },
];
---

<!--
  Tres tarjetas de contacto con el estilo de ModalidadesAprendizaje
  (Capacitaciones): tarjeta gris redondeada y un círculo de color que sobresale
  arriba, aquí con el ícono en SVG. Los datos salen de src/lib/sitio.ts.
-->
<section aria-labelledby="titulo-contacto-unete" class="bg-white px-6 pt-16 sm:px-10 sm:pt-20">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500">Contáctenos</p>
      <h2 id="titulo-contacto-unete" class="mt-3 text-balance text-2xl font-medium text-slate-900 sm:text-3xl">
        ¿Tiene dudas antes de afiliarse?
      </h2>
    </div>

    <ul role="list" class="mt-6 grid grid-cols-1 gap-x-10 gap-y-6 md:grid-cols-3 xl:gap-x-14">
      {
        tarjetas.map((tarjeta) => (
          <li class="pt-14">
            <article class="group flex h-full flex-col items-center rounded-[2.5rem] bg-[#f3f4f6] px-6 pb-9 text-center sm:px-8">
              <div
                class="-mt-14 grid size-28 place-items-center rounded-full text-white shadow-[0_12px_30px_-10px_rgba(16,42,67,0.35)] transition-transform duration-300 group-hover:-translate-y-1"
                style={`background-color: ${tarjeta.color}`}
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-11" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={tarjeta.icono} />
                </svg>
              </div>

              <h3 class="mt-6 text-sm font-semibold uppercase tracking-[0.2em] text-slate-900">{tarjeta.titulo}</h3>
              <p class="mt-3 max-w-[32ch] text-sm leading-relaxed text-slate-600 sm:text-base">{tarjeta.texto}</p>
              {tarjeta.enlace ? (
                <a
                  href={tarjeta.enlace}
                  class="mt-auto pt-5 font-semibold underline-offset-4 hover:underline focus-visible:underline"
                  style={`color: ${tarjeta.colorTexto}`}
                >
                  {tarjeta.dato}
                </a>
              ) : (
                <p class="mt-auto pt-5 font-semibold" style={`color: ${tarjeta.colorTexto}`}>
                  {tarjeta.dato}
                </p>
              )}
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
