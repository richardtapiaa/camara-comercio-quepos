---
import ilustracion from "../../assets/unete/unete.svg";

// Íconos de Heroicons (licencia MIT), trazo de 24×24.
const beneficios = [
  {
    texto: "Ser parte de un círculo de empresarios exitosos.",
    icono:
      "M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z",
  },
  {
    texto: "Intermediación en diálogos y posibilidades de tratos comerciales.",
    icono:
      "M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155",
  },
  {
    texto: "Oportunidades de negocio.",
    icono: "M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941",
  },
  {
    texto: "Beneficios para su empresa.",
    icono:
      "M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z",
  },
];
---

<!--
  Panel de beneficios al lado del formulario. Jerarquía: etiqueta pequeña,
  título grande, frase de entrada, lista de beneficios con ícono y, al final,
  la ilustración. Usa el mismo redondeado y relleno que la tarjeta del
  formulario para que las dos columnas se vean como un par.
-->
<aside aria-labelledby="titulo-beneficios" class="p-4 sm:p-8 lg:p-10 lg:pr-0">
  <div class="relative isolate flex h-full flex-col overflow-hidden rounded-3xl bg-[#2780c9] p-8 text-white shadow-xl sm:p-12 lg:p-14">
    <!-- Círculos de luz decorativos -->
    <div class="pointer-events-none absolute -right-24 -top-24 -z-10 size-72 rounded-full bg-white/10" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-20 -z-10 size-80 rounded-full bg-[#1d6aa8]/60" aria-hidden="true"></div>

    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-white/70">Beneficios</p>
    <h2 id="titulo-beneficios" class="mt-3 text-balance text-3xl font-bold leading-tight sm:text-4xl">
      Al ser parte de nosotros
    </h2>
    <p class="mt-4 max-w-md text-base leading-relaxed text-white/85 sm:text-lg">
      Afilia tu negocio a la Cámara de Comercio, Industria y Turismo de Quepos.
    </p>

    <ul role="list" class="mt-10 space-y-5">
      {
        beneficios.map((beneficio) => (
          <li class="flex items-center gap-4">
            <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-white/15 ring-1 ring-white/25">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={beneficio.icono} />
              </svg>
            </span>
            <span class="text-base font-medium leading-snug sm:text-lg">{beneficio.texto}</span>
          </li>
        ))
      }
    </ul>

    <img
      src={ilustracion.src}
      width={ilustracion.width}
      height={ilustracion.height}
      alt=""
      decoding="async"
      class="mx-auto mt-auto w-full max-w-[15rem] pt-10 sm:max-w-[17rem]"
    />
  </div>
</aside>
