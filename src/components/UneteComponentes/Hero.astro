---
import { Picture } from "astro:assets";
import foto from "../../assets/quepos/quepos-foto-prueba.jpg";
import BordePincelada from "../compartidos/BordePincelada.astro";
import "../../styles/compartido/etiqueta-papel.css";
import "../../styles/compartido/hero-texto.css";
---

<section
  id="hero"
  aria-labelledby="titulo-unete"
  class="relative isolate flex h-[78svh] min-h-[520px] items-end overflow-hidden bg-[#2b4a5c]"
>
  <Picture
    src={foto}
    formats={["avif", "webp"]}
    alt="Vista aérea de la ciudad de Quepos, entre el río, el bosque y la playa, con la marina al fondo"
    widths={[800, 1280, 1600]}
    sizes="100vw"
    quality={50}
    class="absolute inset-0 -z-20 size-full object-cover"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/70 via-black/30 to-black/45" aria-hidden="true"></div>

  <div class="mx-auto w-full max-w-[1320px] px-6 pb-[clamp(5rem,12vh,8rem)] text-white sm:px-10">
    <p class="hero-texto-kicker">Cámara de Comercio de Quepos</p>
    <h1 id="titulo-unete" class="hero-texto-titulo">Únete</h1>
  </div>

  <BordePincelada />
</section>
