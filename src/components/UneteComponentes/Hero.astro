---
import { Image } from "astro:assets";
import fotoMarina from "../../assets/unete/marina-pez-vela.webp";
---


<section id="hero" aria-labelledby="titulo-unete" class="relative isolate overflow-hidden bg-slate-950 px-6 pb-56 pt-52 sm:px-10 sm:pb-64 sm:pt-52 lg:min-h-[88svh] lg:pb-72 lg:pt-52">
  <Image
    src={fotoMarina}
    alt=""
    widths={[640, 1024, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover object-[center_30%]"
  />

  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950/85 via-slate-950/55 to-slate-950/20"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-t from-slate-950/70 via-transparent to-slate-950/40"></div>

  <div class="mx-auto w-full max-w-[1320px]">
    <h1 id="titulo-unete" class="mt-4 max-w-3xl text-balance text-[clamp(2.5rem,6.5vw,5rem)] font-bold leading-[1.02] tracking-tight text-white">
      Haga crecer su negocio en Quepos
    </h1>
    <p class="mt-6 max-w-xl text-base leading-relaxed text-white/85 sm:text-lg">
      Afilie su negocio a la Cámara de Comercio, Industria y Turismo de Quepos y forme parte de la red empresarial del
      cantón.
    </p>
  </div>
</section>
