---
import { Image } from "astro:assets";
import ilustracion from "../../assets/unete/unete.svg";
import logo from "../../assets/compartido/logo-camara-nav-400.webp";
import { contacto } from "../../lib/sitio";
import FormularioUnete from "../ReactComponentes/UNETE/FormularioUnete.tsx";
import FondoSello from "../compartidos/FondoSello";

const telefonoEnlace = contacto.telefono.replace(/[^+\d]/g, "");

const claseIcono = "size-5 shrink-0 text-[#2780c9]";
---


<section id="formulario-afiliacion" aria-labelledby="titulo-formulario-unete" class="relative isolate overflow-x-clip bg-white px-6 py-20 sm:px-10 sm:py-24 lg:py-28">
  <FondoSello lado="izquierda" />
  <div class="mx-auto grid max-w-7xl items-start gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:grid-rows-[auto_1fr] lg:gap-x-20">
    <div class="lg:col-start-1 lg:row-start-1">
      <h2 id="titulo-formulario-unete" class="text-balance text-4xl font-semibold leading-[1.1] tracking-tight text-slate-950 sm:text-5xl">
        Afilie su negocio en tres pasos
      </h2>
      <p class="mt-5 max-w-[46ch] text-lg leading-relaxed text-slate-600">
        Complete el formulario y la Cámara se pondrá en contacto con usted para afiliar su negocio.
      </p>
    </div>

    <div class="rounded-[2rem] bg-white p-6 shadow-[0_24px_60px_-24px_rgba(15,40,70,0.3)] ring-1 ring-slate-200/80 sm:p-10 lg:col-start-2 lg:row-span-2 lg:row-start-1">
      <Image
        src={logo}
        alt="Cámara de Comercio, Industria y Turismo de Quepos"
        widths={[200, 300, 400]}
        sizes="(min-width: 640px) 195px, 165px"
        loading="lazy"
        decoding="async"
        class="mx-auto h-[4.5rem] w-auto sm:h-[5.25rem]"
      />
      <div class="mt-8 border-b border-slate-200 pb-6 text-center">
        <p class="text-xl font-semibold text-slate-950">Formulario de afiliación</p>
        <p class="mt-1.5 text-sm text-slate-500">
          Los campos marcados con <span class="font-semibold text-[#2780c9]">*</span> son obligatorios.
        </p>
      </div>
      <div class="mt-6">
        <FormularioUnete client:visible />
      </div>
    </div>

    <div class="lg:col-start-1 lg:row-start-2">
      <img
        src={ilustracion.src}
        width={ilustracion.width}
        height={ilustracion.height}
        alt=""
        loading="lazy"
        decoding="async"
        class="hidden w-full max-w-md lg:block"
      />

      <div class="rounded-2xl bg-slate-50 lg:mt-10 p-6 ring-1 ring-slate-200/70">
        <p class="font-semibold text-slate-900">¿Prefiere hablar con nosotros?</p>
        <p class="mt-1 text-[0.9375rem] text-slate-600">Escríbanos o llámenos y con gusto le ayudamos.</p>
        <ul class="mt-4 flex flex-col gap-3 text-[0.9375rem] font-medium text-slate-800">
          <li>
            <a href={`mailto:${contacto.email}`} class="inline-flex items-center gap-3 underline decoration-transparent underline-offset-4 transition-colors hover:text-[#1d6aa8] hover:decoration-[#2780c9]/50">
              <svg class={claseIcono} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
              {contacto.email}
            </a>
          </li>
          <li>
            <a href={`tel:${telefonoEnlace}`} class="inline-flex items-center gap-3 underline decoration-transparent underline-offset-4 transition-colors hover:text-[#1d6aa8] hover:decoration-[#2780c9]/50">
              <svg class={claseIcono} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
              </svg>
              {contacto.telefono}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
