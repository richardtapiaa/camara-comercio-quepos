---
import benefitsImage from "../assets/imagenes/bombillo-inicio.webp";
---

<main class="min-h-screen bg-[#f4efe9] px-6 py-32 sm:px-10 lg:px-16">
  <div class="mx-auto grid max-w-7xl overflow-hidden rounded-3xl bg-white shadow-xl lg:grid-cols-[0.8fr_1.2fr]">
    <aside class="flex flex-col justify-between bg-[#2780c9] p-8 text-white sm:p-12 lg:p-14">
      <div>
        <img
          src={benefitsImage.src}
          alt="Beneficios de unirse a la Cámara de Comercio"
          class="mx-auto h-64 w-full object-contain sm:h-80"
        />
        <h1 class="mt-8 font-sans text-4xl font-bold uppercase leading-none tracking-tight sm:text-5xl">
          Beneficios
        </h1>
        <p class="mt-2 text-xl font-semibold">Al ser parte de nosotros</p>
      </div>
      <ul class="mt-10 space-y-4 border-t border-white/30 pt-7 text-sm leading-6 text-white/90 sm:text-base">
        <li class="flex gap-3"><span aria-hidden="true">•</span><span>Ser parte de un círculo de empresarios exitosos.</span></li>
        <li class="flex gap-3"><span aria-hidden="true">•</span><span>Intermediación en diálogos y posibilidades de tratos comerciales.</span></li>
        <li class="flex gap-3"><span aria-hidden="true">•</span><span>Oportunidades de negocio.</span></li>
        <li class="flex gap-3"><span aria-hidden="true">•</span><span>Beneficios para su empresa.</span></li>
      </ul>
    </aside>

    <section class="p-8 sm:p-12 lg:p-14">
      <div class="mx-auto max-w-3xl">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.3em] text-[#8c8078]">Cámara de Comercio de Quepos</p>
        <h2 class="mt-3 text-center font-sans text-4xl font-bold uppercase leading-tight text-[#2780c9] sm:text-5xl">
          Únete, no esperes más
        </h2>

        <form class="mt-10 grid gap-5 sm:grid-cols-2" method="post">
          <label class="grid gap-2 text-sm font-semibold text-[#403c39]">
            Nombre <span class="text-[#2780c9]">(*)</span>
            <input name="nombre" type="text" required autocomplete="name" class="form-input" />
          </label>
          <label class="grid gap-2 text-sm font-semibold text-[#403c39]">
            Email <span class="text-[#2780c9]">(*)</span>
            <input name="email" type="email" required autocomplete="email" class="form-input" />
          </label>
          <label class="grid gap-2 text-sm font-semibold text-[#403c39]">
            Teléfono de contacto <span class="text-[#2780c9]">(*)</span>
            <input name="telefono" type="tel" inputmode="numeric" pattern="[0-9]*" required autocomplete="tel" data-numeric class="form-input" />
          </label>
          <label class="grid gap-2 text-sm font-semibold text-[#403c39]">
            Otro número de contacto
            <input name="otro-telefono" type="tel" inputmode="numeric" pattern="[0-9]*" autocomplete="tel" data-numeric class="form-input" />
          </label>
          <label class="grid gap-2 text-sm font-semibold text-[#403c39]">
            Nombre de su empresa <span class="text-[#2780c9]">(*)</span>
            <input name="empresa" type="text" required autocomplete="organization" class="form-input" />
          </label>
          <label class="grid gap-2 text-sm font-semibold text-[#403c39]">
            Área comercial
            <input name="area-comercial" type="text" class="form-input" />
          </label>
          <label class="grid gap-2 text-sm font-semibold text-[#403c39]">
            Tipo de empresa <span class="text-[#2780c9]">(*)</span>
            <select name="tipo-empresa" required class="form-input">
              <option value="">Seleccione una opción</option>
              <option value="pymes">Pymes</option>
              <option value="mediana">Mediana empresa</option>
              <option value="grande">Gran empresa</option>
              <option value="otro">Otro</option>
            </select>
          </label>
          <label class="grid gap-2 text-sm font-semibold text-[#403c39]">
            Ubicación del negocio <span class="text-[#2780c9]">(*)</span>
            <input name="ubicacion" type="text" required autocomplete="address-level2" class="form-input" />
          </label>
          <label class="grid gap-2 text-sm font-semibold text-[#403c39] sm:col-span-2">
            Cuéntenos sobre su negocio
            <textarea name="mensaje" rows="5" class="form-input resize-y"></textarea>
          </label>
          <div class="flex flex-wrap gap-3 sm:col-span-2">
            <button type="submit" class="rounded-full bg-[#f43f62] px-8 py-3 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#d93455]">
              Enviar solicitud
            </button>
            <button type="reset" class="rounded-full border border-[#403c39]/20 px-8 py-3 text-sm font-bold text-[#403c39] transition hover:bg-[#f4efe9]">
              Limpiar formulario
            </button>
          </div>
        </form>
      </div>
    </section>
  </div>
</main>

<style>
  .form-input {
    width: 100%;
    border: 1px solid rgb(118 110 104 / 25%);
    border-radius: 0.75rem;
    background: #faf9f7;
    padding: 0.75rem 0.9rem;
    color: #403c39;
    font-size: 0.95rem;
    font-weight: 400;
    outline: none;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .form-input:focus {
    border-color: #2780c9;
    box-shadow: 0 0 0 3px rgb(39 128 201 / 15%);
  }
</style>

<script>
  document.querySelectorAll<HTMLInputElement>("[data-numeric]").forEach((input) => {
    input.addEventListener("input", () => {
      input.value = input.value.replace(/\D/g, "");
    });
  });
</script>