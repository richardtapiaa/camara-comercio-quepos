---
import { getImage } from "astro:assets";
import video from "../../assets/naranjito/naranjito-rio.mp4";
import videoWebm from "../../assets/naranjito/naranjito-rio.webm";
import poster from "../../assets/naranjito/naranjito-rio-poster.webp";

const posterOptimizado = await getImage({ src: poster, width: 1024, format: "webp", quality: 70 });
---


<section class="relative h-[70svh] min-h-[360px] max-h-[780px] w-full overflow-hidden bg-[#0f4d3a]">
  <video
    data-video-diferido
    poster={posterOptimizado.src}
    class="absolute inset-0 size-full object-cover"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
  >
    <source src={videoWebm} type='video/webm; codecs="av01.0.08M.08"' />
    <source src={video} type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/25 to-black/35" aria-hidden="true"></div>

  <div class="absolute bottom-0 right-0 max-w-xl px-6 pb-8 text-right text-white sm:px-10 sm:pb-12 lg:pb-14">
    <h2 class="mt-2 text-balance text-3xl font-semibold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
      Rafting en el río Naranjito
    </h2>
    <p class="mt-3 text-base text-white/85 sm:text-lg">Rápidos clase III y IV · Naranjito, Quepos</p>
  </div>
</section>
