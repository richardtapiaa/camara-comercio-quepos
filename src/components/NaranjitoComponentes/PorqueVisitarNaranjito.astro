---
import { Picture } from "astro:assets";
import iconoRio from "../../assets/naranjito/iconos-svg/kayak-svgrepo-com.svg";
import iconoCabalgata from "../../assets/naranjito/iconos-svg/cabalgata.svg";
import iconoCacao from "../../assets/naranjito/iconos-svg/cacao-cacaos-cacau-svgrepo-com.svg";
import iconoComunidad from "../../assets/naranjito/iconos-svg/village-svgrepo-com.svg";
import siluetaBalsa from "../../assets/naranjito/balsa-rapidos.svg";
import siluetaJinete from "../../assets/naranjito/jinete-catarata.svg";
import siluetaCacao from "../../assets/naranjito/cacao-finca.svg";
import siluetaPueblo from "../../assets/naranjito/pueblo-montana.svg";
import fotoRafting from "../../assets/actividades/actividades-2.jpg";
import fotoCabalgata from "../../assets/naranjito/imagenes-distrito/naranjito-hero.webp";
import fotoCacao from "../../assets/actividades/actividad8.jpg";
import fotoComunidad from "../../assets/naranjito/imagenes-distrito/colinas-naranjito.webp";

// Cada razón lleva una foto y un ícono de SVG Repo (licencia CC0). Los datos salen de
// sitios de turismo y de operadores de la zona (noviembre de 2026).
const razones = [
  {
    icono: iconoRio,
    sello: siluetaBalsa,
    foto: fotoRafting,
    alt: "Grupo con cascos y chalecos remando en una balsa por los rápidos de un río",
    titulo: "Aventura en el río Naranjo",
    texto:
      "El río baja de las montañas por un cañón rodeado de selva. Los recorridos de rafting salen de Londres y tienen rápidos de clase III y IV.",
  },
  {
    icono: iconoCabalgata,
    sello: siluetaJinete,
    foto: fotoCabalgata,
    alt: "Jinete a caballo por un camino de tierra entre el bosque",
    titulo: "Cabalgatas hasta las cataratas",
    texto:
      "Desde Londres salen paseos a caballo que atraviesan fincas y bosque hasta llegar a cataratas donde se puede nadar.",
  },
  {
    icono: iconoCacao,
    sello: siluetaCacao,
    foto: fotoCacao,
    alt: "Molino de mano antiguo moliendo granos tostados sobre un tazón",
    titulo: "Sabores de finca",
    texto:
      "En Villa Nueva se cultivan vainilla, cacao y canela. Hay recorridos guiados por las plantaciones que terminan con una degustación de lo que se cosecha ahí mismo.",
  },
  {
    icono: iconoComunidad,
    sello: siluetaPueblo,
    foto: fotoComunidad,
    alt: "Colinas con potreros y bosque en la montaña de Naranjito",
    titulo: "Turismo rural comunitario",
    texto:
      "En Santa Juana, las familias de la montaña reciben a los visitantes con caminatas, recorridos por los cañaverales y almuerzos típicos, mientras reforestan su bosque con especies nativas.",
  },
];
---

<
<section id="por-que-visitar" aria-labelledby="titulo-por-que-visitar" class="bg-white px-6 pt-20 pb-8 sm:px-10 sm:pt-24 sm:pb-10">
  <!-- Encabezado en dos columnas: el título a la izquierda y la entrada a la derecha; en celular, uno debajo del otro -->
  <div class="relative z-10 mx-auto grid max-w-[1840px] gap-6 lg:grid-cols-2 lg:items-end lg:gap-14">
    <h2 id="titulo-por-que-visitar" class="text-balance text-3xl font-semibold leading-tight tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
      Lo que hace único a Naranjito
    </h2>
    <p class="max-w-2xl text-lg leading-relaxed text-slate-600 lg:justify-self-end">
      Ríos de montaña, fincas que abren sus puertas y comunidades que reciben con los brazos abiertos: así es Naranjito,
      uno de los tres distritos de Quepos, a pocos kilómetros de la costa. Ideal para quienes buscan aventura, sabores de
      finca y turismo rural auténtico.
    </p>
  </div>

  <div class="relative mx-auto mt-14 max-w-[1840px]">
    <ul role="list" class="relative space-y-10 sm:space-y-12 lg:space-y-14">
      {
        razones.map((razon, i) => (
          <li class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14 xl:gap-20">
            <div class={i % 2 === 1 ? "lg:order-2" : undefined}>
              <Picture
                src={razon.foto}
                formats={["avif", "webp"]}
                alt={razon.alt}
                widths={[480, 640, 860, 1100]}
                sizes="(min-width: 1840px) 900px, (min-width: 1024px) calc(50vw - 4rem), calc(100vw - 3rem)"
                quality={75}
                loading="lazy"
                decoding="async"
                class="aspect-[3/2] w-full rounded-[2rem] object-cover"
              />
            </div>
            <div class={`relative isolate max-w-xl ${i % 2 === 1 ? "lg:order-1 lg:justify-self-end" : ""}`}>
              <!-- Sello de la actividad, tenue, detrás del texto -->
              <img
                src={razon.sello.src}
                width={razon.sello.width}
                height={razon.sello.height}
                alt=""
                loading="lazy"
                decoding="async"
                class="pointer-events-none absolute -bottom-12 right-0 -z-10 h-auto w-full max-w-none sm:-bottom-20 sm:w-[min(34rem,100%)] lg:-bottom-28 lg:-right-10 lg:w-[min(42rem,115%)]"
              />
              <div class="flex items-center gap-4">
                <img src={razon.icono.src} alt="" width="56" height="56" loading="lazy" decoding="async" class="size-12 shrink-0 sm:size-14" />
                <h3 class="text-balance text-2xl font-semibold leading-tight text-slate-900 sm:text-3xl lg:text-4xl">{razon.titulo}</h3>
              </div>
              <p class="mt-5 text-lg leading-relaxed text-slate-600">{razon.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
