---
import { Picture } from "astro:assets";
import fotoColinas from "../../assets/naranjito/imagenes-distrito/colinas-naranjito.webp";
import fotoRafting from "../../assets/actividades/actividades-2.jpg";
import fotoRioMar from "../../assets/naranjito/imagenes-distrito/foto-naranjito.webp";
import fotoCabalgata from "../../assets/naranjito/imagenes-distrito/naranjito-hero.webp";
import fotoValle from "../../assets/naranjito/imagenes-distrito/valle-naranjito.webp";

// Fotos que ya usa la página, reutilizadas. "fila" decide el tamaño: las tres
// primeras van en una fila de tres y las dos últimas en una de dos, más anchas.
const fotos = [
  { src: fotoColinas, fila: 3, texto: "Colinas y potreros", alt: "Colinas verdes con potreros y bosque en la montaña" },
  { src: fotoRafting, fila: 3, texto: "Rafting", alt: "Grupo con cascos remando en una balsa por los rápidos de un río" },
  { src: fotoRioMar, fila: 3, texto: "Del río al mar", alt: "Río que atraviesa el bosque y los potreros, con el océano Pacífico al fondo" },
  { src: fotoCabalgata, fila: 2, texto: "Cabalgatas", alt: "Jinete a caballo por un camino de tierra entre el bosque" },
  { src: fotoValle, fila: 2, texto: "Valle y montañas", alt: "Vista aérea de un valle con un río, cultivos y montañas al fondo" },
];
---

<!--
  Mosaico de fotos pegadas entre sí, como un solo bloque con las esquinas de
  afuera redondeadas y los mismos márgenes que la sección de arriba; el fondo
  blanco sigue de corrido hasta la frase curva de TextPath, que va debajo.
  Desde lg, una fila de tres y otra de dos; en celular y tablet, dos columnas y
  la última foto a lo ancho. Cada foto lleva abajo un pin que despliega su nombre. Sin
  JavaScript; las fotos se sirven en AVIF o WebP con calidad alta (88), en el
  tamaño de cada celda y hasta 2048px para pantallas de alta densidad, y cargan
  al acercarse. Un toque de contraste y saturación les da más vida; las fotos no
  tienen efecto al pasar el mouse.
-->
<section aria-labelledby="titulo-galeria-naranjito" class="bg-white px-6 pt-10 sm:px-10 sm:pt-14">
  <h2 id="titulo-galeria-naranjito" class="sr-only">Galería de Naranjito</h2>

  <ul role="list" class="mx-auto grid max-w-[1840px] grid-cols-2 overflow-hidden rounded-[1.5rem] [transform:translateZ(0)] lg:grid-cols-6 lg:rounded-[2rem]">
    {
      fotos.map((foto, i) => (
        <li
          class:list={[
            "relative overflow-hidden bg-[#2b4a5c]",
            foto.fila === 3 ? "aspect-[4/5] lg:col-span-2 lg:aspect-[21/20]" : "aspect-[4/5] lg:col-span-3 lg:aspect-[16/10]",
            i === fotos.length - 1 && "col-span-2 aspect-[16/10]",
          ]}
        >
          <figure class="size-full">
            <Picture
              src={foto.src}
              formats={["avif", "webp"]}
              alt={foto.alt}
              widths={[480, 720, 960, 1280, 1600, 2048]}
              sizes={
                i === fotos.length - 1
                  ? "(min-width: 1024px) 50vw, calc(100vw - 3rem)"
                  : foto.fila === 3
                    ? "(min-width: 1024px) 33vw, calc(50vw - 1.5rem)"
                    : "(min-width: 1024px) 50vw, calc(50vw - 1.5rem)"
              }
              quality={88}
              loading="lazy"
              decoding="async"
              class="size-full object-cover contrast-[1.05] saturate-[1.1]"
            />
            <!--
              El rótulo muestra solo el pin; al pasar el mouse o al llegar con el
              teclado (Tab), el nombre se despliega hacia la derecha. El texto
              siempre está en la página, así que los lectores de pantalla lo leen.
            -->
            <figcaption
              tabindex="0"
              class="group/pin absolute bottom-3 left-3 inline-flex items-center rounded-full bg-black/55 p-2 text-sm font-medium text-white backdrop-blur-sm outline-none focus-visible:ring-2 focus-visible:ring-white sm:bottom-4 sm:left-4"
            >
              <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 5-5.5 10.2-7.4 11.8a1 1 0 0 1-1.2 0C9.5 20.2 4 15 4 10a8 8 0 0 1 16 0" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              <span class="max-w-0 overflow-hidden whitespace-nowrap opacity-0 transition-[max-width,opacity,margin] duration-500 ease-out group-hover/pin:mr-1 group-hover/pin:ml-1.5 group-hover/pin:max-w-48 group-hover/pin:opacity-100 group-focus-visible/pin:mr-1 group-focus-visible/pin:ml-1.5 group-focus-visible/pin:max-w-48 group-focus-visible/pin:opacity-100 motion-reduce:transition-none">
                {foto.texto}
              </span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>
