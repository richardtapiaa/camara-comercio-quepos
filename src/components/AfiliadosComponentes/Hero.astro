---
import { getImage, Image } from "astro:assets";
import logo from "../../assets/compartido/logo-camara.webp";
import video from "../../assets/afiliados/hero-afiliados.mp4";
import videoWebm from "../../assets/afiliados/hero-afiliados.webm";
import poster from "../../assets/afiliados/hero-afiliados-poster.jpg";

const posterOptimizado = await getImage({ src: poster, width: 1920, format: "webp", quality: 70 });
---

<section data-parallax-afiliados class="relative isolate flex h-svh min-h-[560px] w-full items-center justify-center overflow-hidden bg-black">
  <video
    data-hero-afiliados-video
    data-parallax-fondo
    poster={posterOptimizado.src}
    class="absolute inset-0 -z-20 size-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  >
    <source src={videoWebm} type='video/webm; codecs="av01.0.08M.08"' />
    <source src={video} type="video/mp4" />
  </video>

  <div class="pointer-events-none absolute inset-0 -z-10 bg-black/35" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-black/30 via-transparent to-black/25"
    aria-hidden="true"
  ></div>
  <div data-parallax-oscuro class="pointer-events-none absolute inset-0 -z-10 bg-black opacity-0" aria-hidden="true"></div>

  <div data-parallax-contenido class="px-6 text-center text-white">
    <h1 class="text-5xl font-bold uppercase tracking-tight drop-shadow-[0_4px_24px_rgba(0,0,0,0.45)] sm:text-6xl md:text-8xl">
      Afiliados
    </h1>
    <Image
      src={logo}
      alt="Cámara de Comercio, Industria y Turismo de Quepos"
      class="mx-auto mt-8 h-36 w-auto drop-shadow-[0_4px_24px_rgba(0,0,0,0.45)] sm:h-40 md:mt-10 md:h-48"
      loading="eager"
    />
    <slot />
  </div>
</section>

<script src="../../scripts/afiliados/parallax.ts"></script>

<script src="../../scripts/afiliados/hero.ts"></script>
