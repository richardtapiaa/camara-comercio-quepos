---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import {
  Search,
  X,
} from "lucide-react";
import { categoriasAfiliados } from "../../content.config";
import logo from "../../assets/compartido/logo-camara.webp";
import logoSello from "../../assets/compartido/logo-camara-sello.webp";
import "../../styles/afiliados/afiliados.css";
// Íconos de SVG Repo, todos de un solo color: negro.
import iconoTelefono from "../../assets/afiliados/iconos-svg/icono-telefono.svg";
import iconoWhatsapp from "../../assets/afiliados/iconos-svg/icono-whatsapp.svg";
import iconoCorreo from "../../assets/afiliados/iconos-svg/icono-correo.svg";
import iconoWeb from "../../assets/afiliados/iconos-svg/icono-web.svg";
import iconoMapa from "../../assets/afiliados/iconos-svg/icono-mapa.svg";
import iconoFacebook from "../../assets/afiliados/iconos-svg/icono-facebook.svg";
import iconoInstagram from "../../assets/afiliados/iconos-svg/icono-instagram.svg";

const afiliados = (await getCollection("afiliados")).sort((a, b) =>
  a.data.nombre.localeCompare(b.data.nombre, "es"),
);

// Afiliados que salen en el mapa: solo esos llevan el enlace "Ver en el mapa".
const enMapa = new Set((await getCollection("mapaAfiliados")).map(({ id }) => id));

const categorias = categoriasAfiliados.filter((c) => afiliados.some((a) => a.data.categoria === c));

const opcionesCategoria = [
  { valor: "", nombre: "Todas", cantidad: afiliados.length },
  ...categorias.map((categoria) => ({
    valor: categoria,
    nombre: categoria,
    cantidad: afiliados.filter((a) => a.data.categoria === categoria).length,
  })),
];

const normalizar = (texto: string) =>
  texto.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

const soloDigitos = (telefono: string) => telefono.replace(/[^\d+]/g, "");

const claseDato = "group/dato flex items-center gap-3 transition-colors hover:text-slate-950";

// Cada dato lleva su ícono solo, sin fondo.
const claseInsignia =
  "flex size-7 shrink-0 items-center justify-center";
const insignia = { telefono: claseInsignia, correo: claseInsignia, web: claseInsignia };
const claseIcono = "size-6";

const dominio = (url: string) => new URL(url).hostname.replace(/^www\./, "");

// Botón redondo de las redes sociales, al pie de la card.
const claseRed =
  "block size-8 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2780c9] focus-visible:ring-offset-2";
---

<section id="afiliados" data-afiliados class="relative isolate scroll-mt-12 overflow-x-clip bg-white px-4 py-16 sm:px-6 sm:py-24">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="sticky top-0 flex h-svh items-center justify-end overflow-hidden">
      <img
        src={logoSello.src}
        width={logoSello.width}
        height={logoSello.height}
        alt=""
        decoding="async"
        draggable="false"
        class="-mr-24 h-auto w-[380px] max-w-none rotate-6 select-none opacity-[0.10] sm:w-[540px] lg:-mr-28 lg:w-[780px]"
      />
    </div>
  </div>

  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-balance text-2xl font-medium text-slate-900 sm:text-3xl">
        Nuestros afiliados
      </h2>
      <p class="mx-auto mt-4 max-w-[52ch] text-lg leading-relaxed text-slate-600">
        Empresas y organizaciones de Quepos que forman parte de la Cámara de Comercio, Industria y Turismo.
      </p>
    </div>

    <!--
      Buscador: campo con borde (al enfocarlo, un halo gris suave) y botón × para borrar; debajo, las categorías como botones
      visibles con la cantidad de afiliados de cada una (afiliados.ts filtra con data-cat-chip / aria-pressed).
    -->
    <div class="mx-auto mt-10 flex w-full max-w-2xl flex-col items-center gap-4">
      <label class="relative block w-full">
        <span class="sr-only">Buscar afiliado por nombre</span>
        <Search className="pointer-events-none absolute left-5 top-1/2 size-5 -translate-y-1/2 text-slate-400" aria-hidden="true" />
        <input
          data-afiliados-buscar
          type="search"
          placeholder="Buscar por nombre…"
          autocomplete="off"
          class="h-14 w-full rounded-2xl border border-slate-200 bg-white pl-13 pr-13 text-base text-slate-900 shadow-[0_10px_30px_-18px_rgba(16,42,67,0.35)] outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-slate-300 focus:ring-4 focus:ring-slate-100 [&::-webkit-search-cancel-button]:appearance-none"
        />
        <button
          type="button"
          data-afiliados-limpiar
          hidden
          aria-label="Borrar la búsqueda"
          class="absolute right-3 top-1/2 flex size-8 -translate-y-1/2 items-center justify-center rounded-full text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
        >
          <X className="size-4" aria-hidden="true" />
        </button>
      </label>

      <div role="group" aria-label="Filtrar por categoría" class="flex flex-wrap justify-center gap-2">
        {
          opcionesCategoria.map(({ valor, nombre, cantidad }, i) => (
            <button
              type="button"
              data-cat-chip
              data-valor={valor}
              aria-pressed={i === 0 ? "true" : "false"}
              class="group/chip inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white py-2 pl-4 pr-2 text-sm font-medium text-slate-700 transition-colors hover:border-slate-300 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 aria-pressed:border-slate-900 aria-pressed:bg-slate-900 aria-pressed:text-white"
            >
              {nombre}
              <span class="min-w-6 rounded-full bg-slate-100 px-1.5 py-0.5 text-xs font-semibold text-slate-600 group-aria-pressed/chip:bg-white/15 group-aria-pressed/chip:text-white">
                {cantidad}
              </span>
            </button>
          ))
        }
      </div>

      <p data-afiliados-cuenta class="text-sm text-slate-500" aria-live="polite">
        {afiliados.length} afiliados
      </p>
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:gap-x-10 lg:gap-y-14 lg:grid-cols-3 xl:grid-cols-4">
      {
        afiliados.map(({ id, data }) => (
          <li id={id} data-afiliado data-categoria={data.categoria} data-nombre={normalizar(data.nombre)} class="scroll-mt-28 pt-20">
            <article class="afiliado-card relative isolate flex h-full flex-col rounded-[2.5rem] bg-white px-6 pb-7 text-center ring-1 ring-slate-900/5">
              <!-- Sello de la Cámara de fondo, muy tenue, abajo a la derecha: indica que el negocio es afiliado -->
              <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden rounded-[2.5rem]" aria-hidden="true">
                <img
                  src={logoSello.src}
                  width={logoSello.width}
                  height={logoSello.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="absolute -bottom-6 -right-6 w-48 rotate-[8deg] select-none opacity-15"
                />
              </div>
              <div class="mx-auto -mt-20 flex size-40 items-center justify-center overflow-hidden rounded-full bg-white p-6 shadow-[0_12px_30px_-10px_rgba(16,42,67,0.35)] ring-4 ring-white">
                <Image
                  src={data.logo}
                  alt={`Logo de ${data.nombre}`}
                  width={320}
                  class="max-h-full w-auto max-w-full object-contain"
                  loading="lazy"
                />
              </div>

              <h3 class="mt-6 text-lg font-semibold leading-snug text-slate-900">{data.nombre}</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-600 sm:text-base">{data.descripcion ?? data.categoria}</p>

              {(data.telefonos || data.whatsapp || data.correo || data.correos || data.web) && (
                <ul class="mx-auto mt-5 flex w-full max-w-xs flex-col gap-2.5 border-t border-slate-200 pt-5 text-left text-sm text-slate-700">
                  {data.telefonos && data.telefonos.length > 0 && (
                    <li class="flex items-start gap-3">
                      <span class={insignia.telefono} aria-hidden="true"><img src={iconoTelefono.src} alt="" width="24" height="24" class={claseIcono} /></span>
                      <span class="sr-only">Teléfonos:</span>
                      <span class="flex min-h-7 flex-col justify-center gap-1">
                        {data.telefonos.map((telefono) => (
                          <a href={`tel:${soloDigitos(telefono)}`} class="transition-colors hover:text-slate-950">
                            {telefono}
                          </a>
                        ))}
                      </span>
                    </li>
                  )}
                  {data.whatsapp && (
                    <li>
                      <a href={`https://wa.me/${soloDigitos(data.whatsapp).replace("+", "")}`} target="_blank" rel="noopener noreferrer" class={claseDato}>
                        <span class={claseInsignia} aria-hidden="true"><img src={iconoWhatsapp.src} alt="" width="24" height="24" class={claseIcono} /></span>
                        <span><span class="sr-only">WhatsApp: </span>{data.whatsapp}</span>
                      </a>
                    </li>
                  )}
                  {[...(data.correo ? [data.correo] : []), ...(data.correos ?? [])].map((correo) => (
                    <li>
                      <a href={`mailto:${correo}`} class={claseDato}>
                        <span class={insignia.correo} aria-hidden="true"><img src={iconoCorreo.src} alt="" width="24" height="24" class={claseIcono} /></span>
                        <span class="min-w-0 [overflow-wrap:anywhere]">
                          {correo.split("@")[0]}@<wbr />{correo.split("@")[1]}
                        </span>
                      </a>
                    </li>
                  ))}
                  {data.web && (
                    <li>
                      <a href={data.web} target="_blank" rel="noopener noreferrer" class={claseDato}>
                        <span class={insignia.web} aria-hidden="true"><img src={iconoWeb.src} alt="" width="24" height="24" class={claseIcono} /></span>
                        <span>{dominio(data.web)}</span>
                      </a>
                    </li>
                  )}
                </ul>
              )}

              {(data.facebook || data.instagram || enMapa.has(id)) && (
                <div class="mx-auto mt-auto flex w-full max-w-xs items-center justify-between gap-3 pt-6">
                  <div class="flex items-center gap-2">
                    {data.facebook && (
                      <a href={data.facebook} target="_blank" rel="noopener noreferrer" class={claseRed} aria-label={`Facebook de ${data.nombre}`}>
                        <img src={iconoFacebook.src} alt="" width="32" height="32" class="size-8" />
                      </a>
                    )}
                    {data.instagram && (
                      <a href={data.instagram} target="_blank" rel="noopener noreferrer" class={claseRed} aria-label={`Instagram de ${data.nombre}`}>
                        <img src={iconoInstagram.src} alt="" width="32" height="32" class="size-8" />
                      </a>
                    )}
                  </div>
                  {enMapa.has(id) && (
                    <a
                      href={`/mapa-afiliados#${id}`}
                      class="inline-flex items-center gap-1.5 text-sm font-medium text-black underline-offset-4 hover:underline focus-visible:underline focus-visible:outline-none"
                    >
                      <img src={iconoMapa.src} alt="" width="20" height="20" class="size-5" aria-hidden="true" />
                      Ver en el mapa
                    </a>
                  )}
                </div>
              )}
            </article>
          </li>
        ))
      }
    </ul>

    <div data-afiliados-vacio hidden class="mt-10 text-center">
      <p class="text-slate-500">No encontramos afiliados con esa búsqueda.</p>
      <Image
        src={logo}
        alt="Cámara de Comercio, Industria y Turismo de Quepos"
        class="mx-auto mt-8 h-20 w-auto md:h-24"
        loading="lazy"
      />
    </div>
  </div>
</section>

<script src="../../scripts/afiliados/afiliados.ts"></script>
