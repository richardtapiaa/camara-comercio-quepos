---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import {
  BedDouble,
  Bus,
  Check,
  ChevronDown,
  Globe,
  House,
  LayoutGrid,
  Mail,
  MessageCircle,
  Mountain,
  Phone,
  Search,
  Shapes,
  ShoppingBag,
  UtensilsCrossed,
  Wrench,
} from "lucide-react";
import FondoAfiliacion from "./FondoAfiliacion.astro";
import { categoriasAfiliados } from "../../content.config";
import logo from "../../assets/compartido/logo-camara.webp";
import "../../styles/afiliados/afiliados.css";

// La lista sale de src/data/afiliados.yaml (colección "afiliados" en src/content.config.ts), por orden alfabético
const afiliados = (await getCollection("afiliados")).sort((a, b) =>
  a.data.nombre.localeCompare(b.data.nombre, "es"),
);

// Solo se muestran como filtro las categorías que tienen al menos un afiliado
const categorias = categoriasAfiliados.filter((c) => afiliados.some((a) => a.data.categoria === c));

// Ícono de cada categoría en el desplegable del filtro ("Todas" va primero)
const iconosCategoria: Record<string, typeof LayoutGrid> = {
  Hospedaje: BedDouble,
  "Tours y aventura": Mountain,
  Transporte: Bus,
  Comercio: ShoppingBag,
  Gastronomía: UtensilsCrossed,
  "Bienes raíces": House,
  Servicios: Wrench,
  Otros: Shapes,
};
const opcionesCategoria = [
  { valor: "", nombre: "Todas", Icono: LayoutGrid },
  ...categorias.map((categoria) => ({ valor: categoria, nombre: categoria, Icono: iconosCategoria[categoria] ?? Shapes })),
];

// Para buscar sin importar mayúsculas ni tildes ("cafe" encuentra "Café")
const normalizar = (texto: string) =>
  texto.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

const soloDigitos = (telefono: string) => telefono.replace(/[^\d+]/g, "");

// Cada dato de contacto: ícono a la izquierda y el texto al lado (se puede tocar para llamar, escribir o abrir)
const claseDato = "flex items-start gap-3 transition-colors hover:text-[#2780c9]";
const claseIcono = "mt-0.5 size-4 shrink-0 text-[#2780c9]";

// Muestra las direcciones web sin "https://", "www." ni la barra final: "https://www.costaverde.com/" → "costaverde.com"
const sinProtocolo = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
---

<!-- Afiliados: buscador con desplegable de categoría y una cuadrícula de tarjetas (logo en círculo, nombre, descripción y
     cada dato de contacto con su ícono).
     Todo se arma solo con la lista de src/data/afiliados.yaml: para agregar un afiliado no hay que tocar este archivo -->
<!-- scroll-mt: al llegar con el botón "volver" (VolverArriba.astro) el título queda visible bajo la barra de navegación -->
<section id="afiliados" data-afiliados class="relative isolate scroll-mt-12 overflow-hidden bg-[#E8F4FA] px-4 py-16 sm:px-6 sm:py-24">
  <!-- Fondo: mosaico de íconos de afiliación (FondoAfiliacion.astro), azul suave sobre el celeste -->
  <FondoAfiliacion id="afiliados-fondo" color="#2780c9" opacidad={0.16} />

  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-4xl font-bold uppercase leading-tight tracking-tight text-neutral-700 sm:text-5xl">
        Nuestros afiliados
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        Empresas y organizaciones de Quepos que forman parte de la Cámara de Comercio, Industria y Turismo.
      </p>
    </div>

    <!-- Buscador y filtro: una sola barra blanca flotante (como las tarjetas) con el buscador a la izquierda y, a la
         derecha, un desplegable de categoría con un ícono por categoría. Debajo el contador -->
    <div class="mt-10 flex flex-col items-center gap-3">
      <div class="relative z-20 flex w-full max-w-2xl items-stretch rounded-full bg-white shadow-[0_18px_40px_-18px_rgba(16,42,67,0.3),0_4px_10px_-4px_rgba(16,42,67,0.1)] ring-1 ring-slate-900/5 transition focus-within:ring-2 focus-within:ring-[#2780c9]/40">
        <label class="relative min-w-0 flex-1">
          <span class="sr-only">Buscar afiliado por nombre</span>
          <Search className="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-slate-400 sm:left-5" aria-hidden="true" />
          <input
            data-afiliados-buscar
            type="search"
            placeholder="Buscar afiliado…"
            class="w-full rounded-l-full bg-transparent py-3.5 pl-11 pr-3 text-sm text-slate-800 outline-none placeholder:text-slate-400 sm:py-4 sm:pl-13 sm:text-base"
          />
        </label>

        <span class="my-2.5 w-px shrink-0 bg-slate-200" aria-hidden="true"></span>

        <!-- Desplegable propio (un <select> no puede mostrar íconos en su lista): botón con el ícono y el nombre de la
             categoría elegida, y una lista con el ícono de cada una. Se maneja con mouse, toque o teclado (flechas,
             Enter, Escape) y se cierra al tocar fuera; ver scripts/afiliados/afiliados.ts -->
        <div data-afiliados-categoria class="relative flex shrink-0">
          <button
            type="button"
            data-cat-boton
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label="Filtrar por categoría: Todas"
            class="flex w-40 items-center gap-2 rounded-r-full py-3.5 pl-3.5 pr-3.5 text-left text-sm font-semibold text-slate-700 outline-none sm:w-52 sm:gap-2.5 sm:pl-4 sm:pr-5 sm:text-base"
          >
            <span data-cat-icono class="flex shrink-0 text-[#2780c9]"><LayoutGrid className="size-4 sm:size-[1.1rem]" aria-hidden="true" /></span>
            <span data-cat-texto class="min-w-0 flex-1 truncate">Todas</span>
            <ChevronDown data-cat-flecha className="size-4 shrink-0 text-slate-500 transition-transform duration-200" aria-hidden="true" />
          </button>

          <ul
            data-cat-lista
            role="listbox"
            aria-label="Categorías"
            data-abierto="false"
            class="cat-lista absolute right-0 top-[calc(100%+0.6rem)] z-30 w-60 rounded-2xl bg-white p-1.5 shadow-[0_24px_50px_-16px_rgba(16,42,67,0.35),0_6px_14px_-6px_rgba(16,42,67,0.15)] ring-1 ring-slate-900/5"
          >
            {
              opcionesCategoria.map(({ valor, nombre, Icono }, i) => (
                <li
                  style={`--i: ${i}`}
                  role="option"
                  data-valor={valor}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex="-1"
                  class="group flex cursor-pointer items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-700 outline-none transition-colors hover:bg-[#E8F4FA] focus:bg-[#E8F4FA] aria-selected:text-[#2780c9]"
                >
                  <span data-cat-icono-opcion class="flex size-5 shrink-0 items-center justify-center text-[#2780c9]">
                    <Icono className="size-4" aria-hidden="true" />
                  </span>
                  <span class="flex-1">{nombre}</span>
                  <Check className="size-4 opacity-0 group-aria-selected:opacity-100" aria-hidden="true" />
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <p data-afiliados-cuenta class="text-sm text-slate-500" aria-live="polite">
        {afiliados.length} afiliados
      </p>
    </div>

    <!-- Tarjetas: blancas, flotando sobre el fondo celeste (sombra suave y amplia que se acentúa al pasar el mouse), con esquinas muy redondeadas y el logo en un círculo blanco que sobresale arriba;
         debajo el nombre, la descripción y cada dato de contacto en su línea, con ícono. El espacio de arriba de cada
         tarjeta (pt) deja lugar al círculo -->
    <ul class="mt-12 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:gap-x-10 lg:gap-y-14 lg:grid-cols-3 xl:grid-cols-4">
      {
        afiliados.map(({ data }) => (
          <li data-afiliado data-categoria={data.categoria} data-nombre={normalizar(data.nombre)} class="pt-20">
            <article class="flex h-full flex-col rounded-[2.5rem] bg-white px-6 pb-8 text-center shadow-[0_24px_50px_-18px_rgba(16,42,67,0.28),0_6px_14px_-6px_rgba(16,42,67,0.12)] ring-1 ring-slate-900/5 transition duration-300 hover:-translate-y-1.5 hover:shadow-[0_32px_60px_-18px_rgba(16,42,67,0.34),0_8px_18px_-6px_rgba(16,42,67,0.14)]">
              <div class="mx-auto -mt-20 flex size-40 items-center justify-center overflow-hidden rounded-full bg-white p-6 shadow-[0_12px_30px_-10px_rgba(16,42,67,0.35)] ring-4 ring-white">
                <Image
                  src={data.logo}
                  alt={`Logo de ${data.nombre}`}
                  width={320}
                  class="max-h-full w-auto max-w-full object-contain"
                  loading="lazy"
                />
              </div>

              <h3 class="mt-6 text-xl font-bold leading-snug text-[#2780c9]">{data.nombre}</h3>
              <p class="mt-1 text-sm text-slate-500">{data.descripcion ?? data.categoria}</p>

              {(data.telefonos || data.whatsapp || data.correo || data.web || data.facebook || data.instagram) && (
                <ul class="mx-auto mt-5 flex w-full max-w-xs flex-col gap-2.5 text-left text-sm text-slate-700">
                  {data.telefonos?.map((telefono) => (
                    <li>
                      <a href={`tel:${soloDigitos(telefono)}`} class={claseDato}>
                        <Phone className={claseIcono} aria-hidden="true" />
                        {telefono}
                      </a>
                    </li>
                  ))}
                  {data.whatsapp && (
                    <li>
                      <a href={`https://wa.me/${soloDigitos(data.whatsapp).replace("+", "")}`} target="_blank" rel="noopener noreferrer" class={claseDato}>
                        <MessageCircle className={claseIcono} aria-hidden="true" />
                        <span><span class="sr-only">WhatsApp: </span>{data.whatsapp}</span>
                      </a>
                    </li>
                  )}
                  {data.correo && (
                    <li>
                      <a href={`mailto:${data.correo}`} class={claseDato}>
                        <Mail className={claseIcono} aria-hidden="true" />
                        <span class="break-all">{data.correo}</span>
                      </a>
                    </li>
                  )}
                  {data.web && (
                    <li>
                      <a href={data.web} target="_blank" rel="noopener noreferrer" class={claseDato}>
                        <Globe className={claseIcono} aria-hidden="true" />
                        <span class="break-all">{sinProtocolo(data.web)}</span>
                      </a>
                    </li>
                  )}
                  {data.facebook && (
                    <li>
                      <a href={data.facebook} target="_blank" rel="noopener noreferrer" class={claseDato}>
                        <svg class={claseIcono} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M13.5 22v-8.2h2.8l.5-3.3h-3.3V8.4c0-.9.3-1.6 1.7-1.6h1.7V4a22 22 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.3H7.2v3.3H10V22h3.5Z" />
                        </svg>
                        <span class="break-all">{sinProtocolo(data.facebook)}</span>
                      </a>
                    </li>
                  )}
                  {data.instagram && (
                    <li>
                      <a href={data.instagram} target="_blank" rel="noopener noreferrer" class={claseDato}>
                        <svg class={claseIcono} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="3" y="3" width="18" height="18" rx="5" />
                          <circle cx="12" cy="12" r="4" />
                          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                        </svg>
                        <span class="break-all">{sinProtocolo(data.instagram)}</span>
                      </a>
                    </li>
                  )}
                </ul>
              )}
            </article>
          </li>
        ))
      }
    </ul>

    <!-- Sin resultados: el mensaje y, debajo, el logo de la Cámara -->
    <div data-afiliados-vacio hidden class="mt-10 text-center">
      <p class="text-slate-500">No encontramos afiliados con esa búsqueda.</p>
      <Image
        src={logo}
        alt="Cámara de Comercio, Industria y Turismo de Quepos"
        class="mx-auto mt-8 h-20 w-auto md:h-24"
        loading="lazy"
      />
    </div>
  </div>
</section>

<script src="../../scripts/afiliados/afiliados.ts"></script>
