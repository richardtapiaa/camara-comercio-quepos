<!-- Botón para volver a "Nuestros afiliados" (la sección #afiliados de Afiliados.astro): aparece abajo a la derecha
     cuando ya se bajó más allá de ese título y al tocarlo sube suave hasta él. Si la página no tiene esa sección,
     vuelve al inicio. Oculto no se puede enfocar (inert) -->
<button
  data-volver-arriba
  type="button"
  aria-label="Volver a Nuestros afiliados"
  inert
  class="volver-arriba fixed bottom-6 right-6 z-40 flex size-12 translate-y-4 items-center justify-center rounded-full bg-[#2780c9] text-white opacity-0 shadow-[0_10px_25px_-8px_rgba(16,42,67,0.55)] transition-[opacity,translate,background-color] duration-300 hover:bg-[#1f6aa8] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#2780c9] md:bottom-8 md:right-8 md:size-14"
>
  <svg class="size-5 md:size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</button>

<style>
  .volver-arriba[data-visible="true"] {
    opacity: 1;
    translate: 0 0;
  }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>("[data-volver-arriba]");

  if (boton) {
    const sinMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)");
    const destino = document.getElementById("afiliados");
    let pendiente = false;

    // Visible cuando el título de "Nuestros afiliados" ya quedó media pantalla por encima (sin la sección: cuando
    // se bajó más de un alto de pantalla)
    const actualizar = () => {
      pendiente = false;
      const visible = destino
        ? destino.getBoundingClientRect().top < -window.innerHeight * 0.5
        : window.scrollY > window.innerHeight;
      boton.dataset.visible = String(visible);
      boton.inert = !visible;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(actualizar);
      },
      { passive: true }
    );
    window.addEventListener("resize", actualizar);
    actualizar();

    // scrollIntoView respeta el scroll-margin-top de la sección, que deja el título debajo de la barra de navegación
    boton.addEventListener("click", () => {
      const behavior = sinMovimiento.matches ? "auto" : "smooth";
      if (destino) destino.scrollIntoView({ behavior, block: "start" });
      else window.scrollTo({ top: 0, behavior });
    });
  }
</script>
