---
import { Image } from "astro:assets";
import arrozCamarones from "../../assets/gastronomia/platos/arroz-con-camaroes.webp";
import casado from "../../assets/gastronomia/platos/casado.webp";
import filetePescado from "../../assets/gastronomia/platos/filt-pescado.webp";
import galloPinto from "../../assets/gastronomia/platos/gallo-pinto.webp";
import picadillo from "../../assets/gastronomia/platos/picadillos-tortilla.webp";
import "../../styles/compartido/etiqueta-papel.css";
import "../../styles/gastronomia/galeria-comida.css";

const platos = [
  { src: casado, forma: "ovalado", nombre: "Casado", alt: "Casado costarricense con pollo, arroz, frijoles, plátano maduro y ensalada" },
  { src: arrozCamarones, forma: "ovalado", nombre: "Arroz con camarones", alt: "Arroz con camarones" },
  { src: galloPinto, forma: "redondo", nombre: "Gallo pinto", alt: "Gallo pinto con culantro" },
  { src: filetePescado, forma: "redondo", nombre: "Filet de pescado", alt: "Filete de pescado con arroz, aguacate y ensalada" },
  { src: picadillo, forma: "ovalado", nombre: "Picadillos", alt: "Picadillo sobre tortillas" },
];
---

<section class="relative isolate overflow-clip bg-white px-4 pb-12 pt-4 md:px-6 md:pb-20 md:pt-6" aria-label="Galería de gastronomía de Quepos">
  <svg class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[96%] w-full" aria-hidden="true">
    <defs>
      <pattern id="manta-cuadros" width="28" height="28" patternUnits="userSpaceOnUse" patternTransform="rotate(-4)">
        <rect width="28" height="28" fill="#ffffff" />
        <rect width="14" height="28" fill="#2780c9" fill-opacity="0.32" />
        <rect width="28" height="14" fill="#2780c9" fill-opacity="0.32" />
      </pattern>
      <filter id="manta-pliegues" x="-5%" y="-5%" width="110%" height="110%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.004 0.009" numOctaves="2" seed="5" result="ruido" />
        <feDisplacementMap in="SourceGraphic" in2="ruido" scale="46" xChannelSelector="R" yChannelSelector="G" result="tela" />
        <feDiffuseLighting in="ruido" surfaceScale="22" diffuseConstant="1" lighting-color="#ffffff" result="luz">
          <feDistantLight azimuth="225" elevation="50" />
        </feDiffuseLighting>
        <feComponentTransfer in="luz" result="luz">
          <feFuncR type="linear" slope="1.05" intercept="0.12" />
          <feFuncG type="linear" slope="1" intercept="0.15" />
          <feFuncB type="linear" slope="0.9" intercept="0.22" />
        </feComponentTransfer>
        <feBlend in="tela" in2="luz" mode="multiply" />
      </filter>
      <clipPath id="manta-borde" clipPathUnits="objectBoundingBox">
        <path d="M0 0.2C0.06 0.08 0.12 0.16 0.18 0.1C0.25 0.03 0.3 0.24 0.38 0.16C0.45 0.09 0.5 0.02 0.58 0.12C0.65 0.21 0.7 0.06 0.78 0.08C0.86 0.1 0.9 0.22 0.95 0.12C0.98 0.06 1 0.1 1 0.1V1H0Z" />
      </clipPath>
    </defs>
    <g clip-path="url(#manta-borde)">
      <rect x="-40" y="-40" width="calc(100% + 80px)" height="calc(100% + 80px)" fill="url(#manta-cuadros)" filter="url(#manta-pliegues)" />
      <rect width="100%" height="100%" fill="url(#manta-sombra-borde)" />
    </g>
    <defs>
      <linearGradient id="manta-sombra-borde" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#102a43" stop-opacity="0.18" />
        <stop offset="0.25" stop-color="#102a43" stop-opacity="0" />
      </linearGradient>
    </defs>
  </svg>

  <ul class="mx-auto grid max-w-7xl grid-cols-1 gap-8 md:grid-cols-6">
    {
      platos.map(({ src, forma, nombre, alt }, i) => (
        <li
          class:list={[
            "relative aspect-[3/2] [perspective:900px]",
            i < 3 ? "md:col-span-2" : "md:col-span-3",
          ]}
          data-plato
        >
          <div
            class:list={[
              "plato-escena absolute inset-y-0 [container-type:inline-size]",
              forma === "redondo" ? "left-1/2 aspect-square -translate-x-1/2" : "inset-x-0",
            ]}
          >
            <div class="plato-sombra absolute inset-x-[3%] bottom-[-5%] top-[12%] rounded-[50%]" aria-hidden="true"></div>
            <div class="plato-canto absolute inset-0 translate-y-[3.5%] rounded-[50%]" aria-hidden="true"></div>
            <div class="plato-superficie absolute inset-0 rounded-[50%]" aria-hidden="true"></div>
            <div class="plato-comida absolute inset-x-[14%] bottom-[18%] top-[10%]">
              <Image
                src={src}
                alt={alt}
                widths={[320, 480, 640, 900]}
                sizes={i < 3 ? "(min-width: 768px) 26vw, 70vw" : "(min-width: 768px) 38vw, 70vw"}
                quality={85}
                class="size-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="plato-brillo pointer-events-none absolute inset-0 rounded-[50%]" aria-hidden="true"></div>
            <div
              class="etiqueta absolute bottom-[2%] left-1/2 w-[56%] -translate-x-1/2 translate-y-1/3"
              style={`--giro-etiqueta: ${i % 2 === 0 ? -4 : 3}deg`}
            >
              <div class="etiqueta-papel px-[14%] py-[5%] text-center">
                <p class="etiqueta-nombre">{nombre}</p>
              </div>
              <span class="etiqueta-cinta -left-[7%] rotate-[5deg]" aria-hidden="true"></span>
              <span class="etiqueta-cinta -right-[7%] -rotate-[6deg]" aria-hidden="true"></span>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<script src="../../scripts/gastronomia/galeria-comida.ts"></script>
 