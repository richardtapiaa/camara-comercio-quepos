---
import { Image } from "astro:assets";
import quepos1 from "../../assets/gastronomia/platos/quepos-1.jpg";
import quepos2 from "../../assets/gastronomia/platos/quepos-2.jpg";
import quepos3 from "../../assets/gastronomia/platos/quepos-3.jpg";

const fotos = [
  { src: quepos1, foco: "22% 60%", alt: "Plato servido en una mesa de madera de un restaurante al aire libre, con luces colgantes de noche" },
  { src: quepos2, foco: "54% 70%", alt: "Mariscos a la parrilla con frutas y flores, junto a una copa de vino blanco" },
  { src: quepos3, foco: "52% 65%", alt: "Plato con carne, puré y ensalada junto a copas de vino en un restaurante de noche" },
];
---

<section class="bg-white px-4 pb-16 pt-6 sm:px-6 md:pb-24" aria-label="Galería de gastronomía de Quepos">
  <ul class="relative z-10 mx-auto -mt-16 grid max-w-[1180px] gap-6 sm:-mt-20 sm:grid-cols-3 md:gap-10 lg:-mt-24">
    {
      fotos.map(({ src, foco, alt }) => (
        <li class="aspect-[2/3] overflow-hidden rounded-[28px] md:rounded-[32px]">
          <Image
            src={src}
            alt={alt}
            widths={[640, 900, 1280, 1700, 2400]}
            sizes="(min-width: 1180px) 850px, (min-width: 640px) 70vw, 225vw"
            quality={82}
            class="size-full object-cover"
            style={`object-position: ${foco}`}
            loading="lazy"
          />
        </li>
      ))
    }
  </ul>
</section>
