---
import { Image } from "astro:assets";
import comida1 from "../../assets/imagenes-hospitalidad/comida-1.jpg";
import comida2 from "../../assets/imagenes-hospitalidad/comida-2.jpg";
import comida3 from "../../assets/imagenes-hospitalidad/comida-3.jpg";
import comida4 from "../../assets/imagenes-hospitalidad/comida-4.jpg";
import comida5 from "../../assets/imagenes-hospitalidad/comida-5.jpg";

// Todas son horizontales (3:2) y se muestran así, sin recortar, para que los platos se vean enteros
const fotos = [
  { src: comida1, alt: "Plato servido en un restaurante de Quepos, con copas de vino en una mesa a la luz de las velas" },
  { src: comida2, alt: "Plato de mariscos con puré y flores comestibles sobre una mesa de madera" },
  { src: comida3, alt: "Plato de mariscos y una copa de vino blanco en un restaurante al aire libre de noche" },
  { src: comida4, alt: "Casado costarricense con arroz, frijoles, pico de gallo y tortillas" },
  { src: comida5, alt: "Pulpo a la parrilla con ensalada fresca" },
];
---

<!-- Cada foto va servida: abajo un plato ovalado (porcelana blanca con borde), encima un pañuelo de cuadros celeste
     (el mismo del mantel de InfoGastronomia) un poco ladeado y encima la foto, en su proporción original (3:2) para
     que no se corte ningún plato. Plato y pañuelo van en % del recuadro, así se ven igual en cualquier tamaño.
     Mosaico en las dos medidas, con las 5 fotos a la vista:
     - Celular (2 columnas): la 1.ª grande a todo el ancho y debajo dos filas de dos.
     - Escritorio (6 columnas): 3 fotos arriba (2 columnas cada una) y 2 más grandes abajo (3 columnas cada una) -->
<section class="relative isolate overflow-hidden bg-white px-4 py-12 md:px-6 md:py-20" aria-label="Galería de gastronomía de Quepos">
  <!-- Manta de cuadros celeste (el mismo color del mantel y los pañuelos) que sube desde abajo, arrugada, y sobre la
       que quedan apoyados los platos. Es un SVG sin viewBox (medidas en px, así los cuadros no se estiran):
       - el patrón de cuadros se ondula con ruido (feDisplacementMap), como tela con pliegues,
       - el mismo ruido, iluminado de lado, da las luces y sombras de los pliegues,
       - el borde de arriba es una curva irregular (clipPath en % del ancho), como la tela recogida -->
  <svg class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[96%] w-full" aria-hidden="true">
    <defs>
      <pattern id="manta-cuadros" width="28" height="28" patternUnits="userSpaceOnUse" patternTransform="rotate(-4)">
        <rect width="28" height="28" fill="#ffffff" />
        <rect width="14" height="28" fill="#2780c9" fill-opacity="0.32" />
        <rect width="28" height="14" fill="#2780c9" fill-opacity="0.32" />
      </pattern>
      <filter id="manta-pliegues" x="-5%" y="-5%" width="110%" height="110%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.004 0.009" numOctaves="2" seed="5" result="ruido" />
        <feDisplacementMap in="SourceGraphic" in2="ruido" scale="46" xChannelSelector="R" yChannelSelector="G" result="tela" />
        <feDiffuseLighting in="ruido" surfaceScale="22" diffuseConstant="1" lighting-color="#ffffff" result="luz">
          <feDistantLight azimuth="225" elevation="50" />
        </feDiffuseLighting>
        <!-- Lo plano queda casi sin tocar y las caras de los pliegues se oscurecen en un azul grisáceo -->
        <feComponentTransfer in="luz" result="luz">
          <feFuncR type="linear" slope="1.05" intercept="0.12" />
          <feFuncG type="linear" slope="1" intercept="0.15" />
          <feFuncB type="linear" slope="0.9" intercept="0.22" />
        </feComponentTransfer>
        <feBlend in="tela" in2="luz" mode="multiply" />
      </filter>
      <clipPath id="manta-borde" clipPathUnits="objectBoundingBox">
        <path d="M0 0.2C0.06 0.08 0.12 0.16 0.18 0.1C0.25 0.03 0.3 0.24 0.38 0.16C0.45 0.09 0.5 0.02 0.58 0.12C0.65 0.21 0.7 0.06 0.78 0.08C0.86 0.1 0.9 0.22 0.95 0.12C0.98 0.06 1 0.1 1 0.1V1H0Z" />
      </clipPath>
    </defs>
    <g clip-path="url(#manta-borde)">
      <rect x="-40" y="-40" width="calc(100% + 80px)" height="calc(100% + 80px)" fill="url(#manta-cuadros)" filter="url(#manta-pliegues)" />
      <!-- Sombra suave bajo el borde recogido de la tela -->
      <rect width="100%" height="100%" fill="url(#manta-sombra-borde)" />
    </g>
    <defs>
      <linearGradient id="manta-sombra-borde" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#102a43" stop-opacity="0.18" />
        <stop offset="0.25" stop-color="#102a43" stop-opacity="0" />
      </linearGradient>
    </defs>
  </svg>

  <ul class="mx-auto grid max-w-7xl grid-cols-2 gap-4 md:grid-cols-6 md:gap-8">
    {
      fotos.map(({ src, alt }, i) => (
        <li
          class:list={[
            "relative aspect-[3/2]",
            i === 0 && "col-span-2",
            i < 3 ? "md:col-span-2" : "md:col-span-3",
          ]}
          style={`--giro: ${i % 2 === 0 ? -7 : 6}deg`}
        >
          <!-- Plato, pañuelo y foto -->
          <div class="absolute inset-0">
            <!-- Plato -->
            <div class="plato absolute inset-0 rounded-[50%]" aria-hidden="true"></div>
            <!-- Pañuelo, ladeado (alterna el lado en cada foto) -->
            <div class="panuelo absolute inset-[9%] rounded-[4px]" aria-hidden="true"></div>
            <!-- Foto encima del pañuelo -->
            <div class="absolute inset-[12%] overflow-hidden rounded-xl shadow-[0_6px_14px_-6px_rgb(16_42_67/0.45)] md:rounded-2xl">
              <Image
                src={src}
                alt={alt}
                width={1200}
                widths={[480, 640, 960, 1200]}
                sizes={i < 3 ? `(min-width: 768px) 26vw, ${i === 0 ? "70vw" : "35vw"}` : "(min-width: 768px) 38vw, 35vw"}
                quality={80}
                class="size-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Plato ovalado de porcelana visto desde arriba: blanco, con el borde (ala) un poco más gris, una línea donde el
     ala baja al fondo del plato y sombra en la mesa */
  .plato {
    background: radial-gradient(
      ellipse at 50% 45%,
      #ffffff 0%,
      #fbfbfa 58%,
      #e9e9e6 62.5%,
      #f7f7f5 64%,
      #ffffff 72%,
      #ecebe7 100%
    );
    box-shadow:
      0 14px 28px -12px rgb(16 42 67 / 0.35),
      0 2px 4px rgb(16 42 67 / 0.12),
      inset 0 -3px 6px rgb(0 0 0 / 0.06);
  }

  /* Pañuelo de tela de cuadros celeste con un dobladillo blanco y sombra suave sobre el plato */
  .panuelo {
    rotate: var(--giro);
    background-color: #f4f9fd;
    background-image:
      repeating-linear-gradient(90deg, rgb(39 128 201 / 0.16) 0 6px, transparent 6px 12px),
      repeating-linear-gradient(0deg, rgb(39 128 201 / 0.16) 0 6px, transparent 6px 12px);
    box-shadow:
      inset 0 0 0 3px rgb(255 255 255 / 0.85),
      0 4px 10px -4px rgb(16 42 67 / 0.35);
  }
</style>
