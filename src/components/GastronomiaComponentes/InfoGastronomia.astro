---
import { Image } from "astro:assets";
import { CookingPot, Croissant, Fish, Salad, Soup, Utensils, UtensilsCrossed } from "lucide-react";
import imagen from "../../assets/imagenes-hospitalidad/mercado-municipal.jpg";
import gorroChef from "../../assets/imagenes-hospitalidad/chef.webp";

const platillos = [
  { titulo: "Gallo pinto", detalle: "El desayuno tradicional costarricense.", Icono: CookingPot },
  { titulo: "Casado", detalle: "El almuerzo típico de restaurantes y sodas locales.", Icono: Utensils },
  { titulo: "Ceviche", detalle: "Mariscos frescos con el sabor del Pacífico.", Icono: Salad },
  { titulo: "Pescado fresco", detalle: "Directo del mar a la mesa.", Icono: Fish },
];

// Dibujos de restaurante (línea fina, muy suaves) sobre el mantel, en la franja libre de abajo, debajo de la carta
const dibujos = [
  { Icono: UtensilsCrossed, clases: "bottom-5 left-6 size-12 -rotate-12 md:bottom-6 md:left-[calc(max(0px,(100vw_-_72rem)/2)+3rem)] md:size-14" },
  { Icono: Croissant, clases: "bottom-6 left-1/2 size-10 -translate-x-1/2 -rotate-[20deg] md:size-12" },
  { Icono: Soup, clases: "bottom-5 right-6 size-12 rotate-6 md:bottom-6 md:right-[calc(100%/9+2.5rem)] md:size-14" },
];
---

<!-- Diseño de InfoHospitalidad.astro en espejo: imagen a la derecha (como una mesa) montada sobre el panel celeste
     de la izquierda -->
<section id="info-gastronomia" class="overflow-x-clip bg-white py-16 sm:py-24">
  <div class="mx-auto grid max-w-6xl px-6 md:grid-cols-12">
    <!-- Foto como una mesa de restaurante (la foto es la superficie de la mesa) y, colgado arriba con dos cordeles,
         un letrero de pizarra que dice "Menú del día" escrito a tiza. Sale del contenedor hacia la derecha pero deja un
         margen con el borde de la pantalla (igual que el panel a la izquierda), para que el marco se vea entero -->
    <div class="relative z-10 -mr-[max(0px,(100vw_-_72rem)/2)] mb-8 mt-14 md:col-span-4 md:col-start-9 md:row-start-1 md:mt-24 md:self-start">
      <!-- Letrero de pizarra colgando de dos cordeles, un poco ladeado -->
      <div class="pizarra-letrero absolute -top-14 left-1/2 z-20 -translate-x-1/2 -rotate-3 md:-top-16" aria-hidden="true">
        <span class="absolute -top-5 left-[18%] h-6 w-px rotate-[20deg] bg-[#6b4a2b]"></span>
        <span class="absolute -top-5 right-[18%] h-6 w-px -rotate-[20deg] bg-[#6b4a2b]"></span>
        <span class="pizarra-tiza block whitespace-nowrap rounded-md px-5 py-1.5 text-2xl md:text-3xl">Menú del día</span>
      </div>

      <!-- Mesa de madera: la foto es la superficie de la mesa vista desde adelante y un poco desde arriba (inclinada
           en 3D hacia atrás), con un borde fino de madera alrededor; debajo, el canto grueso del tablero y dos patas,
           con las sombras: la que el tablero proyecta debajo, la del piso y una bajo cada pata. Al inclinarse, la
           superficie se ve más baja que el espacio que ocupa (un 27 % del ancho en celular y un 33 % desde md, por la
           proporción de la foto): el margen negativo de arriba sube la mesa para que quede justo debajo del letrero -->
      <div class="mesa relative -mt-[23%] pb-20 [container-type:inline-size] md:-mt-[29%] md:pb-24">
        <div class="mesa-tablero marco-madera rounded-md p-1.5 md:p-2">
          <div class="relative aspect-[4/3] overflow-hidden rounded-sm md:aspect-[8/7]">
            <Image
              src={imagen}
              alt="Gastronomía de Quepos"
              widths={[640, 960, 1280]}
              sizes="(min-width: 768px) 45vw, 100vw"
              quality={75}
              class="absolute inset-0 size-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
        <!-- Canto del tablero, un poco más ancho que la superficie inclinada -->
        <div class="mesa-canto marco-madera relative z-10 -mx-1 h-4 rounded-b-md md:h-5"></div>
        <!-- Sombra que el tablero proyecta debajo, sobre las patas -->
        <div class="pointer-events-none absolute inset-x-[3%] bottom-14 z-[5] h-6 bg-gradient-to-b from-[rgb(40_25_10/0.45)] to-transparent md:bottom-[4.5rem]" aria-hidden="true"></div>
        <!-- Patas -->
        <div class="mesa-pata marco-madera absolute bottom-3 left-[9%] h-[4.25rem] w-3.5 md:h-20 md:w-4" aria-hidden="true"></div>
        <div class="mesa-pata marco-madera absolute bottom-3 right-[9%] h-[4.25rem] w-3.5 md:h-20 md:w-4" aria-hidden="true"></div>
        <!-- Sombras en el piso: general y de contacto bajo cada pata -->
        <div class="absolute inset-x-[2%] bottom-0 h-6 rounded-[50%] bg-[radial-gradient(closest-side,rgb(60_40_20/0.3),transparent)]" aria-hidden="true"></div>
        <div class="absolute bottom-1.5 left-[calc(9%-0.9rem)] h-3 w-14 rounded-[50%] bg-[radial-gradient(closest-side,rgb(40_25_10/0.55),transparent)]" aria-hidden="true"></div>
        <div class="absolute bottom-1.5 right-[calc(9%-0.9rem)] h-3 w-14 rounded-[50%] bg-[radial-gradient(closest-side,rgb(40_25_10/0.55),transparent)]" aria-hidden="true"></div>
      </div>
    </div>

    <!-- Tarjeta celeste (el mantel) con bordes redondeados y sombra suave; adentro va la carta. En celular ocupa todo el ancho de la pantalla (sin
         esquinas redondeadas); desde md sale del contenedor hasta pegarse al borde izquierdo de la pantalla (sin
         esquinas redondeadas de ese lado) y a la derecha deja el espacio donde se monta la imagen. A la derecha deja el
         espacio de la columna donde se monta la imagen -->
    <div
      class="relative isolate -mx-6 overflow-hidden bg-[#E8F4FA] md:mr-0 md:rounded-[2rem] pb-24 pt-12 pl-[calc(max(0px,(100vw_-_72rem)/2)+1.5rem)] pr-6 md:-ml-[calc(max(0px,(100vw_-_72rem)/2)+1.5rem)] md:rounded-l-none md:pl-[calc(max(0px,(100vw_-_72rem)/2)+3rem)] shadow-[0_12px_40px_rgb(100_155_190/0.25)] md:col-span-9 md:col-start-1 md:row-start-1 md:pb-28 md:pt-16 md:pr-[calc(100%/9+2rem)]"
    >
      <!-- Fondo: pañuelo de tela de cuadros celeste con pliegues, igual que la manta de GaleriaComida.astro (mismo
           patrón, ondulado con ruido y con luces y sombras en los pliegues). SVG sin viewBox, así los cuadros no se
           estiran. Detrás, -z-10, junto con los dibujos de restaurante de la franja de abajo -->
      <svg class="pointer-events-none absolute inset-0 -z-10 size-full" aria-hidden="true">
        <defs>
          <pattern id="panuelo-cuadros" width="28" height="28" patternUnits="userSpaceOnUse" patternTransform="rotate(-4)">
            <rect width="28" height="28" fill="#ffffff" />
            <rect width="14" height="28" fill="#2780c9" fill-opacity="0.32" />
            <rect width="28" height="14" fill="#2780c9" fill-opacity="0.32" />
          </pattern>
          <filter id="panuelo-pliegues" x="-5%" y="-5%" width="110%" height="110%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="0.004 0.009" numOctaves="2" seed="11" result="ruido" />
            <feDisplacementMap in="SourceGraphic" in2="ruido" scale="46" xChannelSelector="R" yChannelSelector="G" result="tela" />
            <feDiffuseLighting in="ruido" surfaceScale="22" diffuseConstant="1" lighting-color="#ffffff" result="luz">
              <feDistantLight azimuth="225" elevation="50" />
            </feDiffuseLighting>
            <feComponentTransfer in="luz" result="luz">
              <feFuncR type="linear" slope="1.05" intercept="0.12" />
              <feFuncG type="linear" slope="1" intercept="0.15" />
              <feFuncB type="linear" slope="0.9" intercept="0.22" />
            </feComponentTransfer>
            <feBlend in="tela" in2="luz" mode="multiply" />
          </filter>
        </defs>
        <rect x="-40" y="-40" width="calc(100% + 80px)" height="calc(100% + 80px)" fill="url(#panuelo-cuadros)" filter="url(#panuelo-pliegues)" />
      </svg>
      {
        dibujos.map(({ Icono, clases }) => (
          <Icono
            className={`pointer-events-none absolute -z-10 text-[#1f6aa8]/60 ${clases}`}
            strokeWidth={1.25}
            aria-hidden="true"
          />
        ))
      }

      <!-- La información va como una carta de restaurante apoyada sobre el mantel: papel color marfil con doble marco
           azul, encabezado centrado con adornos y los platillos como los platos de un menú (nombre, línea de puntos
           y su ícono en lugar del precio, y la descripción en cursiva debajo) -->
      <div class="carta relative rounded-md px-4 pb-24 pt-9 text-center sm:px-8 md:px-10 md:pb-28 md:pt-12">
        <!-- Dibujos de comida en línea, como en las cartas impresas: un pescado con limón arriba a la izquierda y una piña
             abajo a la derecha (debajo de los platillos; la carta tiene más espacio abajo para ella) -->
        <svg
          class="carta-dibujo pointer-events-none absolute left-3 top-3 w-16 rotate-6 sm:left-5 sm:top-5 md:w-24"
          viewBox="0 0 120 84"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <!-- Pescado -->
          <path d="M14 38C28 16 68 12 90 38C68 64 28 60 14 38Z" fill="rgb(39 128 201 / 0.1)" />
          <path d="M90 38L112 20L105 38L112 56Z" fill="rgb(39 128 201 / 0.1)" />
          <path d="M50 20C56 8 70 8 76 22" />
          <path d="M52 56C56 64 64 66 70 60" />
          <circle cx="28" cy="34" r="3" fill="currentColor" />
          <path d="M40 24C47 32 47 44 40 52" />
          <path d="M55 30q5 8 0 16M65 28q6 10 0 20M75 31q5 7 0 14" stroke-width="2" />
          <!-- Rodaja de limón -->
          <circle cx="26" cy="68" r="12" fill="rgb(251 191 36 / 0.25)" />
          <circle cx="26" cy="68" r="8" stroke-width="1.5" />
          <path d="M26 60V76M18 68H34M20.5 62.5l11 11M31.5 62.5l-11 11" stroke-width="1.5" />
        </svg>
        <svg
          class="carta-dibujo pointer-events-none absolute bottom-4 right-4 w-12 rotate-6 sm:right-6 md:bottom-5 md:w-16"
          viewBox="0 0 80 124"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <defs>
            <clipPath id="carta-pina">
              <ellipse cx="40" cy="82" rx="24" ry="34" />
            </clipPath>
          </defs>
          <!-- Hojas de la corona -->
          <path d="M40 50C34 34 32 20 38 4C42 20 44 34 40 50Z" fill="rgb(39 128 201 / 0.1)" />
          <path d="M38 50C28 40 20 30 16 16C28 24 36 36 38 50Z" fill="rgb(39 128 201 / 0.1)" />
          <path d="M42 50C52 40 60 30 64 16C52 24 44 36 42 50Z" fill="rgb(39 128 201 / 0.1)" />
          <path d="M36 52C26 48 16 46 8 38C20 38 30 42 36 52Z" />
          <path d="M44 52C54 48 64 46 72 38C60 38 50 42 44 52Z" />
          <!-- Fruta con su cuadriculado en diagonal -->
          <ellipse cx="40" cy="82" rx="24" ry="34" fill="rgb(251 191 36 / 0.25)" />
          <g clip-path="url(#carta-pina)" stroke-width="1.75">
            <path d="M0 52L80 132M0 68L80 148M0 36L80 116M0 20L80 100M0 4L80 84" />
            <path d="M80 52L0 132M80 68L0 148M80 36L0 116M80 20L0 100M80 4L0 84" />
          </g>
        </svg>

        <p class="carta-adorno mx-auto flex max-w-xs items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-[#2780c9]">
          
        </p>

        <!-- Gorro de chef puesto sobre la "G": va dentro de la letra (en em, así escala con el título) y un poco
             inclinado. Es decorativo: el título se sigue leyendo "Gastronomía".
             whitespace-nowrap: sin esto el navegador podía partir la palabra entre la G y "astronomía". El tamaño es
             fluido para que la palabra entera quepa dentro de la carta en cualquier celular -->
        <h2 class="mt-7 whitespace-nowrap text-[clamp(1.25rem,6.6vw,3rem)] font-bold uppercase leading-tight tracking-tight text-neutral-700">
          <span class="relative inline-block"
            >G<Image
              src={gorroChef}
              alt=""
              width={240}
              class="gorro-chef pointer-events-none absolute left-1/2 h-auto w-[1.35em] max-w-none select-none"
              loading="lazy"
              draggable="false"
              aria-hidden="true"
            /></span
          >astronomía
        </h2>

        <!-- Adorno: línea, rombo y línea -->
        <div class="mx-auto mt-4 flex max-w-[14rem] items-center gap-3 text-[#2780c9]/60" aria-hidden="true">
          <span class="h-px flex-1 bg-current"></span>
          <span class="size-2 rotate-45 border border-current"></span>
          <span class="h-px flex-1 bg-current"></span>
        </div>

        <p class="mx-auto mt-6 max-w-xl text-base font-medium leading-relaxed text-neutral-800 sm:text-lg">
          Nuestro destino ofrece una gran variedad de opciones gastronómicas para todos los gustos.
        </p>

        <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-neutral-600">
          Los visitantes pueden disfrutar de la cocina tradicional costarricense en restaurantes y sodas locales, así
          como de establecimientos especializados en diferentes propuestas culinarias. Platillos como el gallo pinto, el
          casado, el ceviche y el pescado fresco permiten descubrir los sabores que forman parte de la cultura y las
          tradiciones de la región.
        </p>

        <!-- Sección del menú, en letra a mano como la pizarra -->
        <p class="carta-seccion mx-auto mt-9 flex max-w-sm items-center justify-center gap-3 text-2xl text-[#2780c9] md:text-3xl">
          <span class="h-px flex-1 bg-[#2780c9]/30"></span>Platos típicos<span class="h-px flex-1 bg-[#2780c9]/30"></span>
        </p>

        <ul class="mx-auto mt-6 grid max-w-3xl gap-x-10 gap-y-5 text-left md:grid-cols-2">
          {
            platillos.map(({ titulo, detalle, Icono }) => (
              <li>
                <div class="flex items-end gap-2">
                  <span class="text-sm font-bold uppercase tracking-wide text-neutral-800">{titulo}</span>
                  <span class="mb-1 flex-1 border-b-2 border-dotted border-neutral-400/70" aria-hidden="true"></span>
                  <Icono className="size-5 shrink-0 text-[#2780c9]" strokeWidth={1.75} aria-hidden="true" />
                </div>
                <p class="mt-1 text-sm italic leading-relaxed text-neutral-600">{detalle}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>


<style>
  /* Carta de restaurante: papel marfil con una textura muy suave, doble marco azul (borde fino afuera y otro
     adentro, separados por un filete de papel) y sombra, como una carta apoyada sobre el mantel */
  .carta {
    background-color: #fffdf7;
    background-image: radial-gradient(rgb(120 90 40 / 0.05) 1px, transparent 1px);
    background-size: 6px 6px;
    border: 2px solid rgb(39 128 201 / 0.55);
    box-shadow:
      inset 0 0 0 5px #fffdf7,
      inset 0 0 0 6px rgb(39 128 201 / 0.35),
      0 14px 30px -14px rgb(16 42 67 / 0.4);
  }
  /* Dibujos de comida de la carta, en el azul del sitio */
  .carta-dibujo {
    color: #2780c9;
  }
  .carta-seccion {
    font-family: "Caveat", "Comic Sans MS", cursive;
    font-weight: 700;
  }

  /* Caveat (letra a mano) para el letrero de tiza; alojada en el sitio (public/fonts, licencia OFL) */
  @font-face {
    font-family: "Caveat";
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url("/fonts/caveat-bold-latin.woff2") format("woff2");
  }

  /* Madera: tonos café con vetas finas a lo largo y un brillo suave arriba */
  .marco-madera {
    background-color: #8a5a32;
    background-image:
      linear-gradient(to bottom, rgb(255 255 255 / 0.12), transparent 40%, rgb(0 0 0 / 0.15)),
      repeating-linear-gradient(
        92deg,
        rgb(60 35 15 / 0) 0 6px,
        rgb(60 35 15 / 0.18) 6px 7px,
        rgb(60 35 15 / 0) 7px 15px,
        rgb(255 230 190 / 0.08) 15px 17px
      ),
      linear-gradient(90deg, #7a4b26, #9a6a3c 30%, #845530 60%, #a0703f);
  }

  /* Superficie de la mesa: inclinada hacia atrás desde su borde de abajo (que se une con el canto), así se ve
     como un tablero visto un poco desde arriba. La perspectiva va en cqw (ancho de la mesa) para que la inclinación
     se vea igual en cualquier tamaño de pantalla */
  .mesa-tablero {
    transform: perspective(200cqw) rotateX(38deg);
    transform-origin: bottom center;
    box-shadow: 0 2px 0 rgb(0 0 0 / 0.15);
  }
  /* Canto y patas: la misma madera, más oscura por estar a la sombra del tablero */
  .mesa-canto {
    box-shadow:
      inset 0 2px 0 rgb(255 255 255 / 0.15),
      0 6px 10px -4px rgb(40 25 10 / 0.5);
  }
  .mesa-pata {
    filter: brightness(0.75);
    border-radius: 0 0 3px 3px;
  }

  /* Letrero de pizarra: verde oscuro casi negro con manchas de tiza borrada, borde de madera y letra de tiza */
  .pizarra-tiza {
    font-family: "Caveat", "Comic Sans MS", cursive;
    font-weight: 700;
    color: rgb(255 255 255 / 0.92);
    text-shadow: 0 0 1px rgb(255 255 255 / 0.6);
    background-color: #24312b;
    background-image:
      radial-gradient(ellipse at 30% 40%, rgb(255 255 255 / 0.07), transparent 60%),
      radial-gradient(ellipse at 75% 70%, rgb(255 255 255 / 0.05), transparent 55%);
    border: 4px solid #8a5a32;
    box-shadow: 0 8px 18px -8px rgb(0 0 0 / 0.5);
  }

  /* Gorro sobre la G: su base queda apenas metida en la parte de arriba de la letra, ladeado como puesto con gracia */
  .gorro-chef {
    bottom: 0.82em;
    translate: -62% 0;
    rotate: -22deg;
    filter: drop-shadow(0 0.05em 0.08em rgb(16 42 67 / 0.35));
  }

</style>
