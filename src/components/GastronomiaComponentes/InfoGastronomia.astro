---
import { Image } from "astro:assets";
import { CookingPot, Fish, Salad, Utensils } from "lucide-react";
import imagen from "../../assets/imagenes-hospitalidad/mercado-municipal.jpg";
import MisionScripts from "../Scripts/home/MisionScripts.astro";

const platillos = [
  { titulo: "Gallo pinto", detalle: "El desayuno tradicional costarricense.", Icono: CookingPot },
  { titulo: "Casado", detalle: "El almuerzo típico de restaurantes y sodas locales.", Icono: Utensils },
  { titulo: "Ceviche", detalle: "Mariscos frescos con el sabor del Pacífico.", Icono: Salad },
  { titulo: "Pescado fresco", detalle: "Directo del mar a la mesa.", Icono: Fish },
];
---

<!-- Diseño de InfoHospitalidad.astro en espejo: imagen con parallax a la derecha montada sobre el panel celeste de
     la izquierda -->
<section id="info-gastronomia" class="overflow-x-clip bg-white py-16 sm:py-24">
  <div class="mx-auto grid max-w-6xl px-6 md:grid-cols-12">
    <!-- Sale del contenedor hasta el borde derecho de la pantalla y se monta sobre el panel -->
    <div class="relative z-10 -mr-[calc(max(0px,(100vw_-_72rem)/2)+1.5rem)] mb-8 aspect-[4/3] overflow-hidden rounded-2xl md:col-span-4 md:col-start-9 md:row-start-1 md:mt-24 md:self-start md:aspect-[8/7]">
      <Image
        src={imagen}
        alt="Gastronomía de Quepos"
        widths={[640, 960, 1280]}
        sizes="(min-width: 768px) 45vw, 100vw"
        quality={75}
        class="absolute inset-x-0 -top-full h-[200%] w-full max-w-none object-cover will-change-transform"
        data-parallax-img
      />
    </div>

    <!-- Tarjeta celeste con bordes redondeados y sombra suave. Sale del contenedor hacia la izquierda pero deja un
         margen con el borde de la pantalla, para que se vean las esquinas redondeadas. A la derecha deja el
         espacio de la columna donde se monta la imagen -->
    <div
      class="-ml-[max(0px,(100vw_-_72rem)/2)] rounded-[2rem] bg-[#E8F4FA] py-12 pl-[calc(max(0px,(100vw_-_72rem)/2)+1.5rem)] pr-6 shadow-[0_12px_40px_rgb(100_155_190/0.25)] md:col-span-9 md:col-start-1 md:row-start-1 md:py-16 md:pr-[calc(100%/9+2rem)]"
    >
      <h2 class="text-4xl font-bold uppercase leading-tight tracking-tight text-neutral-700 sm:text-5xl">
        Gastronomía
      </h2>

      <p class="mt-6 max-w-xl text-lg font-medium leading-relaxed text-neutral-800 sm:text-xl">
        Nuestro destino ofrece una gran variedad de opciones gastronómicas para todos los gustos.
      </p>

      <p class="mt-8 max-w-2xl text-sm leading-relaxed text-neutral-700">
        Los visitantes pueden disfrutar de la cocina tradicional costarricense en restaurantes y sodas locales, así
        como de establecimientos especializados en diferentes propuestas culinarias. Platillos como el gallo pinto, el
        casado, el ceviche y el pescado fresco permiten descubrir los sabores que forman parte de la cultura y las
        tradiciones de la región.
      </p>

      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          platillos.map(({ titulo, detalle, Icono }) => (
            <li class="flex items-start gap-4 rounded-2xl bg-white/70 px-4 py-3">
              <span class="mt-0.5 flex size-10 shrink-0 items-center justify-center rounded-full bg-[#E8F4FA] text-neutral-700">
                <Icono className="size-5" strokeWidth={2} aria-hidden="true" />
              </span>
              <div>
                <p class="text-sm font-bold uppercase tracking-wide text-neutral-800">{titulo}</p>
                <p class="mt-1 text-sm leading-relaxed text-neutral-700">{detalle}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<MisionScripts />
