---
import { VelocityScroll } from '../ReactComponentes/QUEPOS/ScrollVelocity.tsx';

interface Props {
  texto?: string;
  reaccionaScroll?: boolean;
  espaciado?: string;
  // Capa blanca semitransparente encima de las letras, para que queden más suaves (p. ej. detrás de otra sección)
  overlay?: boolean;
  // Letras de contorno blanco en una sola línea, sin fondo, para ir encima de una foto (p. ej. FotoQuepos)
  contorno?: boolean;
}

const {
  texto = "GALERIA",
  reaccionaScroll = true,
  espaciado = "pb-8 pt-28 sm:pb-12 sm:pt-32",
  overlay = false,
  contorno = false,
} = Astro.props;

const clasesTexto = contorno
  ? "text-6xl font-medium tracking-tight text-transparent [-webkit-text-stroke:1.5px_white] sm:text-8xl lg:text-[9rem] lg:[-webkit-text-stroke:2px_white]"
  : "font-serif text-5xl font-bold uppercase tracking-[0.12em] text-black sm:text-7xl lg:text-8xl";
---

<section class:list={["relative overflow-hidden", !contorno && "bg-white", espaciado]}>
  <VelocityScroll
    client:visible
    text={texto}
    default_velocity={contorno ? 3 : 5}
    scrollReactive={reaccionaScroll}
    filas={contorno ? 1 : 2}
    className={clasesTexto}
  />
  {overlay && <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent to-white/25" aria-hidden="true"></div>}
</section>
