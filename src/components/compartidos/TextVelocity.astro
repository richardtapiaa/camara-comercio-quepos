---
import { VelocityScroll, type Decoracion } from '../ReactComponentes/QUEPOS/ScrollVelocity.tsx';

interface Props {
  texto?: string;
  reaccionaScroll?: boolean;
  espaciado?: string;
  overlay?: boolean;
  contorno?: boolean;
  decoraciones?: Decoracion[];
  difuminado?: boolean;
  filas?: 1 | 2;
  claseTexto?: string;
}

const {
  texto = "GALERIA",
  reaccionaScroll = true,
  espaciado = "pb-8 pt-28 sm:pb-12 sm:pt-32",
  overlay = false,
  contorno = false,
  decoraciones,
  difuminado = false,
  filas = contorno ? 1 : 2,
  claseTexto,
} = Astro.props;

const clasesTexto = contorno
  ? "text-6xl font-medium tracking-tight text-transparent [-webkit-text-stroke:1.5px_white] sm:text-8xl lg:text-[9rem] lg:[-webkit-text-stroke:2px_white]"
  : "font-serif text-5xl font-bold uppercase tracking-[0.12em] text-black sm:text-7xl lg:text-8xl";
---

<section class:list={["relative", decoraciones?.length ? "overflow-x-clip" : "overflow-hidden", !contorno && "bg-white", espaciado]}>
  <div class:list={[difuminado && "[mask-image:linear-gradient(to_bottom,black_50%,transparent_96%)]"]}>
    <VelocityScroll
      client:visible
      text={texto}
      default_velocity={contorno ? 3 : 5}
      scrollReactive={reaccionaScroll}
      filas={filas}
      className={claseTexto ? `${clasesTexto} ${claseTexto}` : clasesTexto}
      decoraciones={decoraciones}
    />
  </div>
  {overlay && <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent to-white/25" aria-hidden="true"></div>}
</section>
