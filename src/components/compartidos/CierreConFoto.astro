---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  foto: ImageMetadata;
  alt: string;
  claseFoto?: string;
}
const { foto, alt, claseFoto = "object-center" } = Astro.props;
---

<div class="relative isolate bg-white">
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[clamp(28rem,56vw,50rem)] overflow-hidden mask-t-from-45%"
  >
    <Picture
      src={foto}
      formats={["avif", "webp"]}
      alt={alt}
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      quality={80}
      pictureAttributes={{ class: "absolute inset-0" }}
      class:list={["absolute inset-0 size-full object-cover", claseFoto]}
      loading="lazy"
    />
    <div class="absolute inset-0 bg-linear-to-t from-[#140c0a]/35 to-transparent to-40%" aria-hidden="true"></div>
  </div>

  <slot />

  <div class="h-[clamp(16rem,30vw,28rem)]" aria-hidden="true"></div>
</div>
