---
interface Props {
  opacidad?: number;
}

const { opacidad = 0.09 } = Astro.props;
---

<img
  src="/fondo-topografico.svg"
  alt=""
  aria-hidden="true"
  width="1600"
  height="900"
  loading="lazy"
  decoding="async"
  class="pointer-events-none absolute inset-0 -z-10 h-full w-full max-w-none"
  style={`opacity: ${opacidad}`}
/>
