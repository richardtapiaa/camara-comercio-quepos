---
// Texto con animales u hojas encima de algunas letras (se arman con lapa(), mono()… de decoraciones.ts).
// Cada palabra va sin cortes, así la línea solo se parte entre palabras.
// Es solo visual: quien lo usa pone el texto para lectores de pantalla y esconde este con aria-hidden (las letras
// decoradas se leerían separadas del resto de la palabra).
// Se anima desde afuera con variables CSS que se heredan:
//   --aparicion (0 a 1): las decoraciones crecen desde su punto de apoyo (por defecto 1, tamaño completo)
//   --animacion (running | paused): pausa el vaivén de las que se mecen mientras el texto no se ve
import type { Decoracion } from "./decoraciones";

interface Props {
  texto: string;
  decoraciones?: Decoracion[];
}

const { texto, decoraciones = [] } = Astro.props;

// Palabras → letras, cada una con sus decoraciones
let indice = 0;
const palabras = texto.split(" ").map((palabra) => {
  const letras = Array.from(palabra, (letra) => {
    const i = indice++;
    return { letra, decoraciones: decoraciones.filter((d) => d.letra === i) };
  });
  indice++; // el espacio entre palabras
  return letras;
});
---

{/* Las etiquetas de una palabra van pegadas: un salto de línea entre ellas se volvería un espacio dentro de la palabra */}
{
  palabras.map((letras, i) => (
    <Fragment>{i > 0 && " "}<span class="whitespace-nowrap">{
      letras.map(({ letra, decoraciones }) =>
        decoraciones.length ? (
          <span class="relative inline-block">{letra}{
            decoraciones.map((d) => (
              <img
                src={d.imagen.src}
                width={d.imagen.width}
                height={d.imagen.height}
                alt=""
                loading="lazy"
                decoding="async"
                draggable="false"
                class:list={[
                  "decoracion pointer-events-none absolute w-auto max-w-none select-none",
                  d.mecer && "columpio",
                  d.clase,
                ]}
              />
            ))
          }</span>
        ) : (
          letra
        ),
      )
    }</span></Fragment>
  ))
}

<style>
  /* Crecen desde su punto de apoyo con --aparicion: empiezan cuando el texto ya va por la mitad */
  .decoracion {
    scale: clamp(0, calc((var(--aparicion, 1) - 0.4) / 0.6), 1);
  }

  .columpio {
    animation: columpio-decoracion 3.2s ease-in-out infinite alternate;
    animation-play-state: var(--animacion, running);
  }

  @keyframes columpio-decoracion {
    from {
      rotate: -2.5deg;
    }
    to {
      rotate: 2.5deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .columpio {
      animation: none;
    }
  }
</style>
