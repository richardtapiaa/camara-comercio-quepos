---
interface Props {
  class?: string;
  giro?: number;
}
const { class: clase = "", giro = 0 } = Astro.props;
const hoja = "M0 118 C -30 72 -48 12 -38 -48 C -30 -88 -12 -110 0 -116 C 12 -110 30 -88 38 -48 C 48 12 30 72 0 118 Z";
---

<svg class={`pointer-events-none absolute -z-10 ${clase}`} viewBox="-70 -130 140 260" fill="none" aria-hidden="true">
  <g stroke="currentColor" stroke-width="1" transform={`rotate(${giro})`}>
    {[1, 0.8, 0.6, 0.4, 0.2].map((e) => <path d={hoja} transform={`scale(${e})`} vector-effect="non-scaling-stroke" />)}
    <path d="M0 126 L0 -100" vector-effect="non-scaling-stroke" />
  </g>
</svg>
