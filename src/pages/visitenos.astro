---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/ActividadesQuepos/Hero.astro";
import InformacionActividades from "../components/ActividadesQuepos/InformacionActividades.astro";
import KayakScroll from "../components/ActividadesQuepos/KayakScroll.astro";
import FAQ from "../components/Quepos-Componentes/FAQ.astro";
import CierreConFoto from "../components/compartidos/CierreConFoto.astro";
import tortugaDeMar from "../assets/actividades/Tortuga_demar.jpg";
---

<Layout
  titulo="Visítenos"
  descripcion="Vive Quepos a tu manera: naturaleza, aventura y mar en un solo destino. Descubre las actividades que no te puedes perder y respuestas para planear tu visita."
>
  <Hero />
  <InformacionActividades />
  <KayakScroll />
  <CierreConFoto
    foto={tortugaDeMar}
    alt="Tortuga marina recién nacida avanzando sobre la arena húmeda de la playa hacia el mar"
    claseFoto="object-bottom max-sm:object-[30%_bottom]"
  >
    <FAQ transparente />
  </CierreConFoto>
</Layout>
