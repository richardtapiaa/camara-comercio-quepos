---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Quepos-Componentes/Hero.astro";
import SobreQuepos from "../components/Quepos-Componentes/SobreQuepos.astro";
import LapasJS from "../components/Quepos-Componentes/LapasJS.astro";
import SobreBiodiversidadQuepos from "../components/Quepos-Componentes/SobreBiodiversidadQuepos.astro";
import LapaArrastre from "../components/Quepos-Componentes/LapaArrastre.astro";
import NahomiScroll from "../components/Quepos-Componentes/NahomiScroll.astro";
import FAQ from "../components/Quepos-Componentes/FAQ.astro";
import islaQuepos from "../assets/quepos/isla-quepos.jpg";
import FotoQuepos from "../components/Quepos-Componentes/FotoQuepos.astro";
import CierreConFoto from "../components/compartidos/CierreConFoto.astro";
import bahiaManuelAntonio from "../assets/quepos/bahia-manuel-antonio.jpg";
import siluetaPezVela from "../assets/quepos/pez-vela.svg";
---

<Layout
  titulo="Quepos"
  descripcion="Quepos, en el Pacífico central de Costa Rica, es la puerta de entrada al Parque Nacional Manuel Antonio: conoce su biodiversidad, su malecón y cómo visitarlo."
  imagen={{ src: islaQuepos, alt: "Isla frente a la playa de Manuel Antonio, en Quepos, con surfistas en el mar" }}
>
  <link slot="head" rel="preload" href="/fonts/alfa-slab-one-latin.woff2" as="font" type="font/woff2" crossorigin />

  <Hero />
  <SobreQuepos />
  <FotoQuepos />

  <div>
    <SobreBiodiversidadQuepos />
    <LapaArrastre />
    <NahomiScroll />
  </div>

  <CierreConFoto
    foto={bahiaManuelAntonio}
    alt="Vista desde el bosque hacia la bahía de Manuel Antonio y sus islas al atardecer"
    claseFoto="object-[center_62%] max-sm:object-[40%_center]"
  >
    <img
      src={siluetaPezVela.src}
      width={siluetaPezVela.width}
      height={siluetaPezVela.height}
      alt=""
      loading="lazy"
      decoding="async"
      class="pointer-events-none absolute right-2 top-8 -z-5 w-[130px] md:hidden lg:left-[max(1.5rem,calc(50%-38.5rem))] lg:right-auto lg:top-[23rem] lg:block lg:w-[400px]"
    />
    <FAQ transparente />
  </CierreConFoto>

  <script src="../scripts/home/paneles.ts"></script>
</Layout>
