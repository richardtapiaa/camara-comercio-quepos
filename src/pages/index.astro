---

import Layout from '../layouts/Layout.astro';

// barra de navegacion (Inicio)
import Navbar from '../components/home/Navbar.astro';

import Hero from '../components/home/Hero.astro';

// import ConozcaQuepos from '../components/home/ConozcaQuepos.astro';

import Mision from '../components/home/Mision.astro';

import Vision from '../components/home/Vision.astro';


import Checkout from '../components/home/Checkout.astro';

import ObjetivosEspecificos from '../components/home/ObjetivosEspecificos.astro';

// import Marquee from '../components/home/Marquee.astro';

import Mapa from '../components/home/Mapa.astro';

import PanelesScripts from '../components/Scripts/home/PanelesScripts.astro';







---

<Layout>
    

<Navbar />

	<!-- Contenedor que limita el sticky del Hero en móvil -->
	<div>
		<Hero />
		<Mision />
	</div>
	<!-- Contenedor que limita el sticky de Visión mientras Objetivos se desliza por encima -->
	<div>
		<Vision />
		<ObjetivosEspecificos />
	</div>
	<Checkout />
	
	
	<Mapa />

	<PanelesScripts />

</Layout>
