---
import Layout from "../layouts/Layout.astro";

const enlaces = [
  { label: "Inicio", href: "/" },
  { label: "Quepos", href: "/quepos" },
  { label: "Afiliados", href: "/afiliados" },
  { label: "Contacto", href: "/contacto" },
];
---

<Layout titulo="Página no encontrada" descripcion="La página que buscas no existe o cambió de dirección." indexar={false}>
  <section class="flex min-h-svh flex-col items-center justify-center bg-[#E8F4FA] px-6 pb-16 pt-32 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-neutral-600">Error 404</p>
    <h1 class="mt-3 text-4xl font-bold uppercase leading-tight tracking-tight text-neutral-800 sm:text-5xl">
      Página no encontrada
    </h1>
    <p class="mt-4 max-w-md text-base leading-relaxed text-neutral-700 sm:text-lg">
      La página que buscas no existe o cambió de dirección. Puedes seguir por alguna de estas secciones:
    </p>
    <nav class="mt-8 flex flex-wrap justify-center gap-3" aria-label="Secciones principales">
      {
        enlaces.map((enlace) => (
          <a
            href={enlace.href}
            class="rounded-full bg-white px-6 py-3 text-sm font-semibold uppercase tracking-wide text-sky-800 shadow-md transition-colors hover:bg-sky-50"
          >
            {enlace.label}
          </a>
        ))
      }
    </nav>
  </section>
</Layout>
