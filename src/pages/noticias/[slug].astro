---
import Layout from "../../layouts/Layout.astro";
import FondoSello from "../../components/compartidos/FondoSello";
import FraseCelebre from "../../components/AfiliadosComponentes/FraseCelebre.astro";
import { TarjetaNoticia } from "../../components/ReactComponentes/NoticiasComponentes/Noticias";
import { obtenerPostsFacebook, type PostFacebook } from "../../lib/facebook";
import { formatoFecha, parrafos, recortar, separarTitulo, slugNoticia, trozosConEnlaces } from "../../lib/noticias";

// Una página por noticia, generada al construir el sitio con las mismas
// publicaciones de Facebook que muestra /noticias. Cada una recibe además las
// tres noticias más recientes (sin repetirse a sí misma) para "Otras noticias".
export async function getStaticPaths() {
  const posts = await obtenerPostsFacebook(10);
  return posts.map((post) => ({
    params: { slug: slugNoticia(post) },
    props: { post, otras: posts.filter((otra) => otra.id !== post.id).slice(0, 3) },
  }));
}

interface Props {
  post: PostFacebook;
  otras: PostFacebook[];
}

const { post, otras } = Astro.props;
const { titulo, cuerpo } = separarTitulo(post.texto);
const cuerpoLimpio = cuerpo.replace(/\s+/g, " ").trim();
const descripcion = cuerpoLimpio ? recortar(cuerpoLimpio, 155) : titulo;
const fechaTexto = formatoFecha.format(new Date(post.fecha));
const bloques = parrafos(cuerpo).map(trozosConEnlaces);

const claseEnlaceTexto =
  "break-all font-semibold text-[#1d5a7a] underline underline-offset-2 hover:text-[#2b4a5c] focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1d5a7a]";
---

<Layout titulo={titulo} descripcion={descripcion}>
  <!--
    Desktop: la imagen a la izquierda (fija mientras se lee) y a la derecha la
    fecha, el título y el texto. Celular: título, imagen y texto, en ese orden.
    Las columnas se arman con la cuadrícula (filas y columnas de lg:), así el
    orden del HTML sigue siendo título, imagen y texto para lectores de pantalla.
    El sello de la Cámara queda de fondo detrás de la noticia y de "Otras
    noticias"; por eso el fondo blanco va en este contenedor y no en cada parte.
  -->
  <div class="relative isolate overflow-x-clip bg-white">
  <FondoSello />
  <article aria-labelledby="titulo-noticia" class="px-6 pb-16 pt-32 sm:px-10 sm:pt-40">
    <div class="mx-auto max-w-6xl">
      <a
        href="/noticias"
        class="inline-flex items-center gap-2 rounded-full py-1 text-sm font-semibold text-[#1d5a7a] transition-colors hover:text-[#2b4a5c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1d5a7a] motion-reduce:transition-none"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M19 12H5M11 6l-6 6 6 6"></path>
        </svg>
        Volver a noticias
      </a>

      <div
        class:list={[
          "mt-8 grid gap-10 lg:gap-x-14 lg:gap-y-6",
          post.imagen && "lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:grid-rows-[auto_1fr]",
        ]}
      >
        <header class:list={[post.imagen && "lg:col-start-2 lg:row-start-1"]}>
          <p class="text-sm font-semibold text-slate-600">
            <time datetime={post.fecha}>{fechaTexto}</time>
          </p>
          <h1 id="titulo-noticia" class="mt-3 text-balance text-3xl font-bold leading-tight text-slate-900 lg:text-4xl">
            {titulo}
          </h1>
        </header>

        {
          post.imagen && (
            <div class="relative isolate aspect-[4/5] overflow-hidden rounded-[2rem] bg-slate-200 lg:sticky lg:top-28 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:self-start">
              <img
                src={post.imagen}
                alt=""
                aria-hidden="true"
                decoding="async"
                referrerpolicy="no-referrer"
                class="absolute inset-0 -z-10 size-full scale-125 object-cover opacity-90 blur-2xl saturate-150"
              />
              <img
                src={post.imagen}
                alt={`Imagen de la publicación: ${titulo}`}
                width="1200"
                height="1500"
                fetchpriority="high"
                decoding="async"
                referrerpolicy="no-referrer"
                class="size-full object-contain drop-shadow-[0_6px_18px_rgb(0_0_0/0.25)]"
              />
            </div>
          )
        }

        <div class:list={[post.imagen && "lg:col-start-2 lg:row-start-2"]}>
          {
            bloques.length > 0 && (
              <div class="space-y-5 text-lg leading-relaxed text-slate-700">
                {bloques.map((trozos) => (
                  <p class="whitespace-pre-line">
                    {trozos.map(({ valor, esEnlace }) =>
                      esEnlace ? (
                        <a href={valor} target="_blank" rel="noopener noreferrer" class={claseEnlaceTexto}>
                          {valor}
                          <span class="sr-only"> (se abre en una pestaña nueva)</span>
                        </a>
                      ) : (
                        valor
                      ),
                    )}
                  </p>
                ))}
              </div>
            )
          }

          <div class:list={["flex flex-wrap items-center gap-x-6 gap-y-4 border-t border-slate-200 pt-8", bloques.length > 0 && "mt-10"]}>
            <a
              href={post.enlace}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-[#2b4a5c] px-6 py-3.5 font-semibold text-white transition-colors hover:bg-[#1d3542] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#2b4a5c] motion-reduce:transition-none"
            >
              <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M13.5 22v-8.2h2.8l.5-3.3h-3.3V8.4c0-.9.3-1.6 1.7-1.6h1.7V4a22 22 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.3H7.2v3.3H10V22h3.5Z"></path>
              </svg>
              Ver en Facebook
              <span class="sr-only"> (se abre en una pestaña nueva)</span>
            </a>
            <a
              href="/noticias"
              class="rounded font-semibold text-[#1d5a7a] underline underline-offset-4 hover:text-[#2b4a5c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1d5a7a]"
            >
              Ver todas las noticias
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  {
    otras.length > 0 && (
      <section aria-labelledby="titulo-otras-noticias" class="px-6 pb-24 sm:px-10">
        <div class="mx-auto max-w-6xl border-t border-slate-200 pt-16">
          <h2 id="titulo-otras-noticias" class="text-2xl font-medium text-slate-900 sm:text-3xl">
            Otras noticias
          </h2>
          <ul role="list" class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3 lg:gap-12">
            {otras.map((otra) => (
              <li class="flex">
                <TarjetaNoticia post={otra} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
  </div>

  <FraseCelebre />
</Layout>
